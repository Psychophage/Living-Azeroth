    {
      "entry": 17311,
      "name": "Cowlen",
      "records": [
        {
          "authored": false,
          "id": "npc:17311:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3d3d1f1bd5a7c4a2d2e60ef3",
            "source:41c79e864566f54cf054304c",
            "source:959ab8252b81d8077ea6bfe6",
            "source:2311153635d878d4aff551c7",
            "source:5f42f95ef26aadb92f1f134b",
            "source:5d2d7df833ad46c17e36ea40",
            "source:d74cfb772afe7141e14f554e",
            "source:0b788c7058fcd4d8445ba192"
          ],
          "text": "Cowlen is a night elf fisherman stranded on Silvermyst Isle after his home was razed, his ship sunk and he believes his family was killed in an attack by the island's creatures. Grief-stricken and despairing, he asks for his family's remains so he can bury them; he names his wife Thalrisa and daughter Magwin. If Magwin is reunited with him, he is moved to tears and calls the helper a lifelong sibling in friendship. His words show deep sorrow and self-blame, not a desire for vengeance.",
          "when": {
            "entry": 17311
          }
        }
      ],
      "title": null
    }
