      "name": "North Fleet Reservist",
      "records": [
        {
          "authored": false,
          "id": "npc:24120:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9a4e751377db33d23cc178ba",
            "source:fe5beabe83ef5295b4382803",
            "source:933248cdfd029b521b77dece",
            "source:dcdd5b9c3a704e811e244a2d",
            "source:2e2adde324a28877b58d09dd",
            "source:86bbae9418f4d0e532a0b990"
          ],
          "text": "A North Fleet reservist caught up in the fighting calls for help when blinded and warns others about a bat overhead. One recorded line recalls dreaming of fighting friends, hinting at how the conflict and plague can unsettle the fleet's own soldiers.",
          "when": {
            "entry": 24120
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27249,
      "name": "Alystros the Verdant Keeper",
      "records": [
        {
          "authored": false,
          "id": "npc:27249:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3a2a1fae8df238fcecaa76fe",
            "source:0c0a3444e0ab76be1dc08859",
            "source:c380905664bd4aa73efb57a0",
            "source:59ab7c4e2f06b73123e9b4be",
            "source:85aa5a26a3f7151992430b9a"
          ],
          "text": "Alystros, titled the Verdant Keeper, is a formidable creature whose attacks use talons and wing beats and can bring a lapsing dream. His title marks him as a distinct figure.",
          "when": {
            "entry": 27249
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "The Frozen Sea",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3979",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3979",
        "world:creature:24120",
        "world:creature:25764",
        "world:creature:25496",
        "world:creature:27249"
      ],
      "text": "You are in The Frozen Sea, open water in Northrend that is held by neither the Alliance nor the Horde. Reservists of the Alliance's North Fleet are among the people who work these waters, and Kaskala defenders, who fight with thrown weapons, are found along the nearby coasts. Kvaldir Mist Lords and Alystros the Verdant Keeper are the dangers out on the water.",
      "when": {
        "zone_id": 3979
      }
    }
  ],
