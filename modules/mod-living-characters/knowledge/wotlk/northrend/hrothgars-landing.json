  "npcs": [
    {
      "entry": 34838,
      "name": "Kvaldir Reaver",
      "records": [
        {
          "authored": false,
          "id": "npc:34838:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d6528b9b8dc35d5d14dbf534",
            "source:17e1cde7df9e45f643579d68",
            "source:7cc75bd16c088021969ec5cd",
            "source:3803a9b26fc0912c6416d389"
          ],
          "text": "A Kvaldir raider at Hrothgar's Landing, this Reaver fights with the raiding force that has overrun the island and threatens the Argent Tournament Grounds. It strikes with crashing waves.",
          "when": {
            "entry": 34838
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 34839,
      "name": "Kvaldir Mist Binder",
      "records": [
        {
          "authored": false,
          "id": "npc:34839:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b3f4d7242f037a885b5270d2",
            "source:08380e05e0373f3f2c0a0fd6",
            "source:0313248c75c92d8a2bdaef3d"
          ],
          "text": "A Kvaldir raider at Hrothgar's Landing, this Mist Binder fights with the force that has overrun the island and threatens the Argent Tournament Grounds. It chokes foes with strangling mist.",
          "when": {
            "entry": 34839
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 34852,
      "name": "Slain Tualiq Villager",
      "records": [
        {
          "authored": false,
          "id": "npc:34852:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8b4dd0b67423a9504081ed53",
            "source:ebab8c2bd898695b2128a81e",
            "source:75127a8b30f2c539aab1a972",
            "source:f80a686ca640004fe0e97e2c"
          ],
          "text": "A Tualiq villager slain during the Kvaldir takeover of Hrothgar's Landing. The dead villagers' spirits are trapped in the island's mists; performing the last rites lets them find peace.",
          "when": {
            "entry": 34852
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 34907,
      "name": "Kvaldir Harpooner",
      "records": [
        {
          "authored": false,
          "id": "npc:34907:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:97e6080c2f4809059b9d7dee",
            "source:d9174314647fa73876fa6818",
            "source:e6118f0b6133dbb5693ab2e5",
            "source:ac7aae94d7f1b8b3d90ecc79",
            "source:dc697d7c235d2f8438f62424",
            "source:a673f04586a9d3dd28f2e169",
            "source:9383a0efcaca3fc64792efa4"
          ],
          "text": "A Kvaldir raider who attacks aboard the Firehawk during the assault on the Sunreavers. This Harpooner threatens foes with the island's engulfing mist and the sea, and can start a fight while out of combat.",
          "when": {
            "entry": 34907
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 34925,
      "name": "North Sea Kraken",
      "records": [
        {
          "authored": false,
          "id": "npc:34925:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:99794129e7aa0e48edd1cdf5",
            "source:77e872401636d2c3ac7b2b6e",
            "source:ce95e22c1b41a195e1aee0aa"
          ],
          "text": "A North Sea Kraken encountered off Hrothgar's Landing. This powerful sea creature attacks with Frost Breath.",
          "when": {
            "entry": 34925
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 34947,
      "name": "Kvaldir Berserker",
      "records": [
        {
          "authored": false,
          "id": "npc:34947:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5231dee1d339ed62aebb30fe",
            "source:e78bcb557777d443c932c2f0",
            "source:e6118f0b6133dbb5693ab2e5",
            "source:5d152229a02f20d0fa45bb4d",
            "source:2ba16e4af006f5ddc2d9dd61",
            "source:68f9a518ca66b6712fbd3015",
            "source:35c9d55e7abc601052a31911"
          ],
          "text": "A Kvaldir raider who attacks aboard the Firehawk during the assault on the Sunreavers. This Berserker threatens foes with the island's engulfing mist and the sea, and hurls a weapon in combat.",
          "when": {
            "entry": 34947
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 35070,
      "name": "Firehawk Mariner",
      "records": [
        {
          "authored": false,
          "id": "npc:35070:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:875fd1ac696ba98da380a5a6",
            "source:1b61b4921cf19f55b85f9ce2",
            "source:58ea63978775a1a972b8385f",
            "source:d848c20ca0fe2f09ca5555b5",
            "source:a3f0954f5e36855f981a3dcf"
          ],
          "text": "A Firehawk Mariner is one of the armed mariners stationed at Hrothgar's Landing. This one uses ranged attacks, including Shoot, Concussive Shot, and Multi-Shot.",
          "when": {
            "entry": 35070
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 35090,
      "name": "Captain Aerthas Firehawk",
      "records": [
        {
          "authored": false,
          "id": "npc:35090:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b42f2e733623ef7f303c263a",
            "source:781c2d5abaa4cbbbbfe621bc",
            "source:2e28543f135792e094d38362",
            "source:24dd8bc3f92acf01835153a2",
            "source:eddda51344ddd682f7544c0f"
          ],
          "text": "Captain Aerthas Firehawk is a Sunreaver captain sent to Hrothgar's Landing, where a Kvaldir raiding party has caught him outnumbered. He fights back with ranged attacks, including Shoot and Multi-Shot.",
          "when": {
            "entry": 35090
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 35092,
      "name": "Kvaldir Deepcaller",
      "records": [
        {
          "authored": false,
          "id": "npc:35092:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c42df9340f59560fd56c3427",
            "source:8e27c09548977e6adca055ae",
            "source:13310db372833a2e0abc062c"
          ],
          "text": "The Kvaldir Deepcaller is a Kvaldir humanoid found at Hrothgar's Landing, where the Kvaldir have detained northbound ships sent by the Sunreavers and Silver Covenant and are trying to summon a Kraken.",
          "when": {
            "entry": 35092
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 35098,
      "name": "Wavecrest Mariner",
      "records": [
        {
          "authored": false,
          "id": "npc:35098:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b66f041424bf20dcdd81b48f",
            "source:c445243b67965aa666e51f14",
            "source:fde80eab4ee7c3e6641a36d7",
            "source:9122781084ebd17f51f03fbd"
          ],
          "text": "A Wavecrest Mariner is a ranged fighter found at Hrothgar's Landing, firing shots and using Concussive Shot against foes.",
          "when": {
            "entry": 35098
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 35102,
      "name": "Captain Elleane Wavecrest",
      "records": [
        {
          "authored": false,
          "id": "npc:35102:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9eb48d0beaf81eae1b9bf3ba",
            "source:1f38d9b76ae9a3b46f0d8be9",
            "source:23c2f6f5a08b6b8fa2be9eaa",
            "source:8c10a031a2886753b82ce726",
            "source:d63d93ff90e7a4a0e98fa2e8"
          ],
          "text": "Captain Elleane Wavecrest is a named captain at Hrothgar's Landing. She attacks at range with shots and can answer nearby foes with Heroic Strike.",
          "when": {
            "entry": 35102
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "Hrothgar's Landing",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4742",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4742",
        "world:creature:34838",
        "world:creature:34839",
        "world:creature:34852"
      ],
      "text": "You are in Hrothgar's Landing, an island in Northrend held by neither the Alliance nor the Horde. Horde and Alliance mariners keep armed posts along its shore. Kvaldir raiders have taken the island, and a North Sea kraken lives in its waters. The spirits of slain Tualiq villagers linger in the island's mists.",
      "when": {
        "zone_id": 4742
      }
    },
    {
      "authored": false,
      "id": "area:4760",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:4760",
        "world:creature:35090",
        "world:creature:35102",
        "world:creature:34947",
        "world:creature:34925"
      ],
      "text": "You are in The Sea Reaver's Run, a stretch of Hrothgar's Landing where Horde and Alliance forces both stand. Captain Aerthas Firehawk, a Sunreaver captain, has been caught here outnumbered by a Kvaldir raiding party, and Captain Elleane Wavecrest leads the Alliance mariners. Kvaldir berserkers, harpooners and deepcallers still prowl these waters, and a North Sea kraken lurks here too.",
      "when": {
        "area_id": 4760
      }
    }
  ],
