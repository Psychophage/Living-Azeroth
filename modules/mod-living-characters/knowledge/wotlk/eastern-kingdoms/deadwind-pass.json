    {
      "entry": 12379,
      "name": "Unliving Caretaker",
      "records": [
        {
          "authored": false,
          "id": "npc:12379:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:25dcf641a229e32c597c12cb",
            "source:1f285e9a003422c07bc79740",
            "source:bde57870de1a2f5a063abbb9",
            "source:66b2ad08f06c35e7dff53b4b"
          ],
          "text": "An undead figure known as an Unliving Caretaker appears among the creatures around Karazhan. It uses Debilitating Strike in combat and can enrage at low health, becoming more dangerous as a fight goes on.",
          "when": {
            "entry": 12379
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 12380,
      "name": "Unliving Resident",
      "records": [
        {
          "authored": false,
          "id": "npc:12380:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0e240997f2215ba8da5211b4",
            "source:ecf0ca7d3052f93ec4c9e90f",
            "source:d19b252306d5ea9a1a5f7f12",
            "source:07de313146e91b6f1eaa7db6"
          ],
          "text": "An undead resident found around Karazhan, this creature fights with Sunder Armor and Kick. The abilities mark it as a direct melee threat among the area's restless inhabitants.",
          "when": {
            "entry": 12380
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 17613,
      "name": "Archmage Alturus",
      "records": [
        {
          "authored": false,
          "id": "npc:17613:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:40d392735a5f9df65ff3d389",
            "source:426a5a8740df556ecbdcbeb8",
            "source:46e598049facc28e368c1dbd",
            "source:164bf734c7031b037e4d6819",
            "source:1a0edba67941a88e50cb25f2",
            "source:eb24df2820f17952b03729f4"
          ],
          "text": "Archmage Alturus is a Violet Eye agent of the Kirin Tor, assigned to watch Karazhan and Medivh. He is an inquisitive, determined researcher, pursuing the tower's secrets and evidence of Medivh's lingering essence. The danger within Karazhan concerns him; he seeks help investigating it and warns that a demonic presence must be stopped.",
          "when": {
            "entry": 17613
          }
        }
      ],
      "title": ""
    },
    {
