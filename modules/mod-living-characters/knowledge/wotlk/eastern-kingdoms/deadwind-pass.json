  "place": "Deadwind Pass",
  "place_records": [
    {
      "authored": false,
      "id": "zone:41",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:41",
        "world:creature:7376",
        "dbc:area:2561",
        "world:creature:7369",
        "world:creature:7379",
        "dbc:area:2562",
        "world:quest:9825"
      ],
      "text": "You are in Deadwind Pass, a land of the Eastern Kingdoms held by neither the Alliance nor the Horde. No settlements keep it. Sky Shadows hunt across it, Deadwind ogre mages and brutes prowl The Vice, and ghostly beings crawl the ground outside Karazhan.",
      "when": {
        "zone_id": 41
      }
    },
    {
      "authored": false,
      "id": "area:2558",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:2558",
        "world:creature:7376"
      ],
      "text": "You are in Deadwind Ravine, a part of Deadwind Pass. Sky Shadows roam it in numbers.",
      "when": {
        "area_id": 2558
      }
    },
    {
      "authored": false,
      "id": "area:2561",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:2561",
        "world:creature:7369",
        "world:creature:7379",
        "world:creature:7371",
        "world:creature:7372",
        "world:creature:12377",
        "world:creature:12378"
      ],
      "text": "You are in The Vice, a part of Deadwind Pass. Deadwind brutes, ogre mages, maulers and warlocks prowl here, and wailing spectres and damned souls drift among them.",
      "when": {
        "area_id": 2561
      }
    },
    {
      "authored": false,
      "id": "area:2562",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:2562",
        "world:creature:17613",
        "world:creature:18255",
        "world:creature:12380",
        "world:creature:12377",
        "world:creature:12378",
        "world:creature:7370"
      ],
      "text": "You are in Karazhan, a tower in Deadwind Pass. Archmage Alturus, an agent of the Kirin Tor's Violet Eye, keeps watch on it from outside, and Apprentice Darius sells goods nearby. Unliving residents, wailing spectres, damned souls and restless shades haunt the tower.",
      "when": {
        "area_id": 2562
      }
    },
    {
      "authored": false,
      "id": "area:2563",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:2563",
        "world:creature:6491",
        "world:creature:7370",
        "world:creature:12377"
      ],
      "text": "You are in Morgan's Plot, a part of Deadwind Pass where a spirit healer offers a return to life for a price. Restless shades and wailing spectres roam it.",
      "when": {
        "area_id": 2563
      }
    }
  ],
