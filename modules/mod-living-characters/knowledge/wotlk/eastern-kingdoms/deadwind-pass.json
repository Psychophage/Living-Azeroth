    {
      "entry": 18253,
      "name": "Archmage Leryda",
      "records": [
        {
          "authored": false,
          "id": "npc:18253:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:26f3696966ab4db8a54503e0",
            "source:1477400ee4724dfe843c4783",
            "source:36a25e8251f4b8373c65cea1",
            "source:cba76c8c12f5e182475cc793",
            "source:b3cf2a617df6a7de4a1587e4",
            "source:494c6691f31306c3eff84221",
            "source:287cf746a9fc6ad903c89cc8",
            "source:91ead03c380cdb4fb8af6bee"
          ],
          "text": "Archmage Leryda is presented as one of Dalaran’s archmages and assists allies with Violet Signets for several paths. She says Karazhan became dark after Medivh’s death, while qualifying that the death is only what they believe occurred.",
          "when": {
            "entry": 18253
          }
        }
      ],
      "title": ""
    },
