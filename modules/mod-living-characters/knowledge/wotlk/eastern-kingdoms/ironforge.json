      "entry": 8392,
      "name": "Pilot Xiggs Fuselighter",
      "records": [
        {
          "authored": false,
          "id": "npc:8392:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8048b1897d7f4f75dcad19cd",
            "source:b66a9660fe9b4189a87ffbe5",
            "source:319eca1f7726d4760a3d4926"
          ],
          "text": "Pilot Xiggs Fuselighter patrols the skies off Azshara’s coast. He says there has been little action along the shore, perhaps because naga swim underwater, and greets a summoned visitor who has come through with a shipment. The shipment is a set of rune rubbings sought by Tymor, which Xiggs is assigned to pick up.",
          "when": {
            "entry": 8392
          }
        }
      ],
      "title": null
    },
