{
  "era": "wotlk",
  "format": "living-azeroth-npc-summaries",
  "map": 0,
  "npcs": [
    {
      "entry": 8888,
      "name": "Franclorn Forgewright",
      "records": [
        {
          "authored": false,
          "id": "npc:8888:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7f3d94f0d04727b32fcaeb65",
            "source:f67ede422a54892e0795a35c",
            "source:56858d8dfcb830ceabc9b420",
            "source:e8c54db1c408454a773b3107"
          ],
          "text": "Franclorn Forgewright is a ghostly architect who claims responsibility for the stonewrought design of Dark Iron works. He seeks help with his accursed city: Ironfel belongs in the hands of the statue raised in his honor, where it will remain with him, and restoring it opens the compartment holding the master key. He also offers to explain the Spire and Dark Iron.",
          "when": {
            "entry": 8888
          }
        }
      ],
      "title": null
    },
    {
      "entry": 8917,
      "name": "Quarry Slave",
      "records": [
        {
          "authored": false,
          "id": "npc:8917:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3c7617dc53db78185f969c95",
            "source:98ba451df811274ebc765c25",
            "source:60e10c837d9d5887ff6a0673"
          ],
          "text": "Quarry Slaves are humanoid workers found across more than one part of the region. When attacked, they respond with a direct strike.",
          "when": {
            "entry": 8917
          }
        }
      ],
      "title": null
    },
    {
      "entry": 8924,
      "name": "The Behemoth",
      "records": [
        {
          "authored": false,
          "id": "npc:8924:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b5a48e7bb89f0c227f42c16c",
            "source:fa7148d817c23e8490a8f9ce"
          ],
          "text": "The Behemoth is a lone, formidable humanoid opponent in this area, a singular presence distinguished by its imposing title.",
          "when": {
            "entry": 8924
          }
        }
      ],
      "title": null
    },
    {
      "entry": 8964,
      "name": "Blackrock Drake",
      "records": [
        {
          "authored": false,
          "id": "npc:8964:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:95b48d9a7a8bd9999f250d7c",
            "source:1a922348653dcd0582295b04",
            "source:2ae637c524c736dbeb11e348"
          ],
          "text": "A Blackrock drake in the Burning Steppes.",
          "when": {
            "entry": 8964
          }
        }
      ],
      "title": null
    },
    {
      "entry": 9026,
      "name": "Overmaster Pyron",
      "records": [
        {
          "authored": false,
          "id": "npc:9026:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:57879cc96acb8ffaa2e03360",
            "source:d5b158b5c79fc2a17c30cd18",
            "source:6cd06ef7bacb64f1c617c271",
            "source:631d40881a6674c33a07d3e3"
          ],
          "text": "Overmaster Pyron is the fire elemental guarding the Blackrock Quarry entrance, where his disturbance of the elements threatens the surrounding lands. He vows that Incendius will raise him from the ashes, revealing a claimed bond between the two and a defiant refusal to accept defeat.",
          "when": {
            "entry": 9026
          }
        }
      ],
      "title": null
    },
    {
      "entry": 9044,
      "name": "Scarshield Sentry",
      "records": [
        {
          "authored": false,
          "id": "npc:9044:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3779b2ce1a472ff414e59435",
            "source:13351d9f57d3357e44431ff4",
            "source:70e57bfebe16740c55aca2c8",
            "source:6503cbb5e490afc3301756d1"
          ],
          "text": "A Scarshield Legion sentry whose Blackrock Bracer is among the materials Bodley needs to prepare for summoning Lord Valthalak. Bodley asks adventurers to gather bracers from orcs in Blackrock Spire.",
          "when": {
            "entry": 9044
          }
        }
      ],
      "title": "Scarshield Legion"
    },
    {
      "entry": 9046,
      "name": "Scarshield Quartermaster",
      "records": [
        {
          "authored": false,
          "id": "npc:9046:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d8c145a398e7ccdc62a051aa",
            "source:b9134b361ca7b803dd897315",
            "source:2ec20afea9b536b0c76aa992"
          ],
          "text": "A quartermaster of the Scarshield Legion who carries Blackhand’s command letter. In it, Warchief Rend Blackhand berates a quartermaster over guarding access to his master’s lair and contrasts that recipient with General Drakkisath.",
          "when": {
            "entry": 9046
          }
        }
      ],
      "title": "Scarshield Legion"
    },
    {
      "entry": 14387,
      "name": "Lothos Riftwaker",
      "records": [
        {
          "authored": false,
          "id": "npc:14387:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:2f588707f99f0a8c1ef92527",
            "source:5287aebc567d4cdf9ff8d890",
            "source:3cf76e71ede3c5206851a75f",
            "source:a9d4979ad3a58b348d39c193"
          ],
          "text": "Lothos Riftwaker studies the rifts around Blackrock Mountain and explains how knowledge can tear the world's fabric. He describes a rift leading through Blackrock Depths toward the Firelord, and offers to attune visitors to its portal after they recover a Core Fragment. Once attuned, he can transport them to the Molten Core.",
          "when": {
            "entry": 14387
          }
        }
      ],
      "title": null
    },
    {
      "entry": 16033,
      "name": "Bodley",
      "records": [
        {
          "authored": false,
          "id": "npc:16033:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0a4d251c1dba150e9fdb9a09",
            "source:39563120cb2ec10fbc3ec6da",
            "source:fcc4eb404f4aa2fc22ad6d30",
            "source:0683273748db89ef58b83dd9"
          ],
          "text": "Bodley is the ghost of a former mercenary who helped steal Lord Valthalak’s amulet and spellbook. He regrets his company’s greed and the spirit’s release, and asks for help setting things right. He once considered divination and says he knows enough to locate the amulet’s final piece.",
          "when": {
            "entry": 16033
          }
        }
      ],
      "title": null
    },
    {
      "entry": 16073,
      "name": "Spirit of Lord Valthalak",
      "records": [
        {
          "authored": false,
          "id": "npc:16073:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:972df39e1f354e06bf6a6467",
            "source:d7ac9ded272ba820e7e57a58",
            "source:b55c61b17507e7f1de26ae3b"
          ],
          "text": "When the rest of Lord Valthalak’s stolen spirit is returned, he demands his amulet back. He recognizes that the person returning it was not among the original thieves, grudgingly credits their courage, and warns them to tell the thieves they are safe for now. He remains imperious and threatening, greeting an intruder with a challenge.",
          "when": {
            "entry": 16073
          }
        }
      ],
      "title": null
    },
    {
      "entry": 24818,
      "name": "Anvilrage Taskmaster",
      "records": [
        {
          "authored": false,
          "id": "npc:24818:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c555a97d0794be3a4d9a548d",
            "source:3b948f3156db68ad88c0dae6",
            "source:cce7bbf0ff380ae3f560485b"
          ],
          "text": "An Anvilrage taskmaster found across several regions. It strikes in close combat and, when badly wounded, calls up a haste aura.",
          "when": {
            "entry": 24818
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 24819,
      "name": "Anvilrage Enforcer",
      "records": [
        {
          "authored": false,
          "id": "npc:24819:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9b9b83d54efdd53294807d10",
            "source:055b2ca8f93c1b2ea8b71c82"
          ],
          "text": "An Anvilrage enforcer found across several regions, who snares opponents with a hooked net.",
          "when": {
            "entry": 24819
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "Blackrock Mountain",
  "place_records": [
    {
      "authored": false,
      "id": "zone:25",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:25",
        "world:creature:14387",
        "world:creature:8888",
        "world:creature:16033",
        "world:creature:24819",
        "world:creature:9044",
        "world:creature:8964"
      ],
      "text": "You are in Blackrock Mountain, a mountain in the Eastern Kingdoms that neither the Alliance nor the Horde holds. Anvilrage enforcers and taskmasters, Scarshield sentries and grunts, and Blackrock drakes are the dangers here. The ghosts of a former mercenary and a dead architect linger among the stones, and Lothos Riftwaker studies the rifts that open in the mountain.",
      "when": {
        "zone_id": 25
      }
    }
  ],
