  "place": "Arathi Basin",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3358",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3358",
        "world:quest:8105",
        "world:quest:8120",
        "world:creature:15045",
        "world:creature:15046",
        "world:creature:15074",
        "world:creature:15075"
      ],
      "text": "You are in Arathi Basin, a battlefield where the League of Arathor and the Horde fight over its resources. Its key points are a mine, a lumber mill, a blacksmith, a farm and a stable, and holding them supplies each side with metal, weapons, food and lumber. Arathi farmers and miners work for the Alliance here, and Forsaken farmers and miners do the same for the Horde.",
      "when": {
        "zone_id": 3358
      }
    }
  ],
