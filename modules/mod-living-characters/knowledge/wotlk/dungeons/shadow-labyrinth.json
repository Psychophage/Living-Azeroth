    {
      "entry": 18638,
      "name": "Cabal Zealot",
      "records": [
        {
          "authored": false,
          "id": "npc:18638:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:96f846cfac5fa00ddea0b1f2",
            "source:26b772473107e57392adf124",
            "source:7dbe2ff95aff764b69671043",
            "source:45df894fd17aaf3b16d73eec"
          ],
          "text": "The Cabal Zealot invokes Sargeras and threatens ruin and the coming end, bringing fervent apocalyptic conviction to the Cabal's hostile ranks. In combat, he attacks with Shadow Bolt.",
          "when": {
            "entry": 18638
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18639,
      "name": "Cabal Spellbinder",
      "records": [
        {
