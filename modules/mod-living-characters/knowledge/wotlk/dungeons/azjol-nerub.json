          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30533,
      "name": "Elder Nurgen",
      "records": [
        {
          "authored": false,
          "id": "npc:30533:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:4a3a783bac0a6f47ad1a721f",
            "source:1f3312c88a091c906bac3be4",
            "source:8e2899c03c6b048272c13bd1",
            "source:10c5fc62262ed333463d441f"
          ],
          "text": "Elder Nurgen is a named elder who reflects that his people once hunted for glory and honor, then wonders whether life is so different now. His words connect an older hunting tradition to the present. He is associated with the quest “Nurgen the Elder.”",
          "when": {
            "entry": 30533
          }
        }
      ],
      "title": ""
    }
