    {
      "entry": 29120,
      "name": "Anub'arak",
      "records": [
        {
          "authored": false,
          "id": "npc:29120:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3496afcdb3c3f2e361a0c4ef",
            "source:cef3a789bc886ed44e37f791",
            "source:6056948983c3af4cbc28bcd5",
            "source:bc1afe134bef75b78bc3be35",
            "source:a638cc8cad55b28688838724",
            "source:72870a859983b81ff135c8a6"
          ],
          "text": "Anub'arak threatens torment, boasts that his locusts defeat armor and calls his brethren to feast on foes. He warns opponents that a master's voice will soon call to them.",
          "when": {
            "entry": 29120
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 29128,
      "name": "Anub'ar Prime Guard",
      "records": [
        {
          "authored": false,
          "id": "npc:29128:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
