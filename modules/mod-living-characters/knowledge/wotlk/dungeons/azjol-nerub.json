      "entry": 28684,
      "name": "Krik'thir the Gatewatcher",
      "records": [
        {
          "authored": false,
          "id": "npc:28684:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ff034c9dd0829b08bd79a67a",
