          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30414,
      "name": "Forgotten One",
      "records": [
        {
          "authored": false,
          "id": "npc:30414:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:74af1e7b363577a2ac6def5f",
            "source:fe75de402ae83f29c382ec4c",
            "source:311bf4e0eb285d60dad7d23e",
            "source:7574422e9d1d53a471282260"
          ],
          "text": "A Forgotten One is one of the Faceless creatures that emerged when the Nerubians dug into Ahn'kahet. Kilix the Unraveler identifies three Forgotten Ones accompanying Herald Volazj as targets in his account of reclaiming the Nerubians' former home. This creature attacks with Shadow Crash.",
          "when": {
            "entry": 30414
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30416,
      "name": "Bound Fire Elemental",
      "records": [
        {
          "authored": false,
          "id": "npc:30416:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:29e136a999d058b09705e213",
            "source:564d74fe1a8291df5d428ec1",
            "source:21262f82128255da473ce1e8"
          ],
          "text": "A Bound Fire Elemental in Ahn'kahet's Twilight area, this elemental casts Scorch in combat.",
          "when": {
            "entry": 30416
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30418,
      "name": "Bound Air Elemental",
      "records": [
        {
          "authored": false,
          "id": "npc:30418:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b4b36a007536211e3ed60f36",
