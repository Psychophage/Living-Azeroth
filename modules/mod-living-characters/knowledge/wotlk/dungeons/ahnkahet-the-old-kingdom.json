            "source:f63a2f141d8bd3c491a08647"
          ],
          "text": "A Plague Walker is an undead dungeon combatant. It casts Aura of Lost Hope.",
          "when": {
            "entry": 30283
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30284,
      "name": "Bonegrinder",
