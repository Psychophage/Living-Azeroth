        {
          "authored": false,
          "id": "npc:30284:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3f895153f6b83d1761334978",
            "source:a275b59e09bd4e89d1a9a5c1",
            "source:3e5245ad530b08c7a1a70d94",
            "source:fbddc0a8431036ecaff8f1ae",
            "source:19775a5bf07a8d6a86a92cd6",
            "source:067e480d90974aa17d4b988f",
            "source:c7e95a3e1762091adb81fe1e"
          ],
          "text": "Bonegrinders are undead dungeon combatants. They use Trample, Stomp and Frightening Shout, and Enrage when badly wounded.",
          "when": {
            "entry": 30284
          }
        }
      ],
      "title": ""
    },
