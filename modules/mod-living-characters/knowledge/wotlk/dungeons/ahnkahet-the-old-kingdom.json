            "source:6a821a7846bf1330853e7c89"
          ],
          "text": "A Bound Air Elemental in Ahn'kahet's Twilight area, this elemental casts Lightning Bolt in combat.",
          "when": {
            "entry": 30418
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30419,
      "name": "Bound Water Elemental",
      "records": [
        {
          "authored": false,
          "id": "npc:30419:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:be3e5e974f50f88942bac599",
            "source:1e774aa80d78cb5e8245161f",
            "source:67be3e2910a3ab469f119e85",
            "source:8e9a8632b24948f1ff281fb2"
          ],
          "text": "The Bound Water Elemental is an elemental combatant that attacks with Water Bolt. Its bound state and water magic distinguish its fighting style from the Ahn'kahar Watcher's Cleave.",
          "when": {
            "entry": 30419
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 31104,
      "name": "Ahn'kahar Watcher",
      "records": [
        {
          "authored": false,
          "id": "npc:31104:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5c77d8f99a15c8ee992a1d6a",
            "source:16c1666e2243d070b24eb5ee",
            "source:8e9a8632b24948f1ff281fb2",
            "source:67be3e2910a3ab469f119e85"
          ],
          "text": "The Ahn'kahar Watcher is an undead combatant that attacks with Cleave. Its watcher name and undead nature distinguish it from the bound water elemental, which relies on a Water Bolt attack.",
          "when": {
            "entry": 31104
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "Ahn'kahet: The Old Kingdom",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4494",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4494",
        "dbc:area:65",
        "world:creature:29311",
        "world:creature:29308",
        "world:creature:30338",
        "world:creature:30287",
        "world:quest:13255",
        "world:quest:13187"
      ],
      "text": "You are in Ahn'kahet: The Old Kingdom, the ancient nerubian realm in Dragonblight. Herald Volazj, leader of the Old Gods' forces, and Prince Taldaram hold it, and Ahn'kahar swarmers and plundering geists fill its halls. The Faceless, creatures of an Old God's will that the nerubians uncovered by digging too deep, roam its passages.",
      "when": {
        "zone_id": 4494
      }
    },
    {
      "authored": false,
      "id": "area:4623",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:4623",
        "world:creature:29309",
        "world:creature:30338",
        "world:creature:30276",
        "world:creature:30172",
        "world:creature:30173"
      ],
      "text": "You are in the Hall of the Conquered Kings, where Elder Nadox stands. He invokes the Lich King, and Ahn'kahar swarmers and web winders fill the hall, with swarm eggs and guardian eggs among them.",
      "when": {
        "area_id": 4623
      }
    },
    {
      "authored": false,
      "id": "area:4624",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:4624",
        "world:creature:29308",
        "world:creature:30287",
        "world:creature:30286",
        "world:creature:30284"
      ],
      "text": "You are in Befouled Terrace, where Prince Taldaram holds sway. He threatens to feast on intruders and speaks of drinking blood, and plundering geists, frostbringers and bonegrinders roam the terrace.",
      "when": {
        "area_id": 4624
      }
    },
    {
      "authored": false,
      "id": "area:4625",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:4625",
        "world:creature:29310",
        "world:creature:30111",
        "world:creature:30179",
        "world:creature:30319",
        "world:creature:30416"
      ],
      "text": "You are in The Desecrated Altar, where Jedoga Shadowseeker guards what she calls sacred halls and asks Yogg-Saron for power. Twilight worshippers, apostles and darkcasters are about, with bound fire elementals.",
      "when": {
        "area_id": 4625
      }
    },
    {
      "authored": false,
      "id": "area:4626",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:4626",
        "world:creature:30258",
        "world:creature:30329"
      ],
      "text": "You are in the Shimmering Bog, where Amanitar stands among savage cave beasts.",
      "when": {
        "area_id": 4626
      }
    },
    {
      "authored": false,
      "id": "area:4627",
      "layer": "location",
      "priority": 60,
      "sources": [
        "dbc:area:4627",
        "world:creature:29311",
        "world:creature:30414",
        "world:quest:13187",
        "world:creature:30179",
        "world:creature:30319",
        "world:creature:30111"
      ],
      "text": "You are in the Fallen Temple of Ahn'kahet, where Herald Volazj stands with the Forgotten Ones who accompany him. Twilight apostles, darkcasters and worshippers are about as well.",
      "when": {
        "area_id": 4627
      }
    }
  ],
