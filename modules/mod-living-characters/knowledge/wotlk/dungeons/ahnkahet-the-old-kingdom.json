            "source:2f33d851a19d029b048f06c3"
          ],
          "text": "A Deep Crawler is a beast that inhabits the dungeon and casts Glutinous Poison.",
          "when": {
            "entry": 30279
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30283,
