  "map": 34,
  "npcs": [
    {
      "entry": 1663,
      "name": "Dextren Ward",
      "records": [
        {
          "authored": false,
          "id": "npc:1663:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:68fc348f85f6a6555bf31c57",
            "source:2a69baf5ef6c3cd4d7b4bfe7",
            "source:d5ac7b648a123047b6b8aaa5",
            "source:c3f1a4cfdb9753ee55a38ca7"
          ],
          "text": "Held in the Stockade, Dextren Ward was caught selling cemetery bodies to Morbent Fel and sentenced to death by Lord Ebonlocke. Stormwind's decision to keep him prisoner has angered Darkshire's council. He fights from a battle stance with a frightening shout.",
          "when": {
            "entry": 1663
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1666,
      "name": "Kam Deepfury",
      "records": [
        {
          "authored": false,
          "id": "npc:1666:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d827242c26942a9347a02789",
            "source:7b97851edcee8f489311290b",
            "source:ce2aab7c225c4d0eb82397eb",
            "source:e8f751b4e912bcec4180efbf",
            "source:2c589a470d71de8e53ccba62"
          ],
          "text": "Kam Deepfury was a conspirator in the Thandol Span attack and masterminded the plan to stash explosives near the bridge. He is held in the Stormwind Stockade for political reasons. Motley Garmason blames him for Longbraid's loss of kin and wants him dead; Kam defends himself with a shield and shield slam.",
          "when": {
            "entry": 1666
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1696,
      "name": "Targorr the Dread",
      "records": [
        {
          "authored": false,
          "id": "npc:1696:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b9b19f9bd83dd373db305ccd",
            "source:c50d0a62302e1f71d410feb4",
            "source:f807ca08ea802dc4cb36f1b0",
            "source:1a8121e13da948708cc66fb5",
            "source:ea9ea14928e23ae2f1415cc5"
          ],
          "text": "Targorr the Dread served Gath'Ilzogg as supreme executioner, torturing men who defended the Kingdom. He is held in the Stockade, sentenced to die, though a noble's hold has delayed his execution. He fights with two weapons and grows frenzied as he weakens.",
          "when": {
            "entry": 1696
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1706,
      "name": "Defias Prisoner",
      "records": [
        {
          "authored": false,
          "id": "npc:1706:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:db2d89f67ba76d81f6ca9bf7",
            "source:6aab02a3b22eb1b649a5fca3",
            "source:837d046927cf0344d8f48f7d",
            "source:1473edf707b8540e594dd53b"
          ],
          "text": "A Defias prisoner in the Stockade, this inmate is among those Warden Thelwater calls insurgents and seeks to suppress. When a target casts a spell, the prisoner can interrupt with a kick.",
          "when": {
            "entry": 1706
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1707,
      "name": "Defias Captive",
      "records": [
        {
          "authored": false,
          "id": "npc:1707:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:432e0e88250134e3e76a7333",
            "source:e1c3fa9ed88406bb12234dda",
            "source:eb6dc1062c29f68bb0bb8dc2"
          ],
          "text": "A Defias captive held in the Stockade who strikes from behind with Backstab.",
          "when": {
            "entry": 1707
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1708,
      "name": "Defias Inmate",
      "records": [
        {
          "authored": false,
          "id": "npc:1708:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6ae90771af80996449f11e9a",
            "source:1d9143746565e2806301c840",
            "source:4a295a89be29cad871fee9f9",
            "source:b00eba655600a5b23f745c9f"
          ],
          "text": "A Defias inmate held in the Stockade who fights from a battle stance and tears at foes with Rend.",
          "when": {
            "entry": 1708
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1711,
      "name": "Defias Convict",
      "records": [
        {
          "authored": false,
          "id": "npc:1711:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9fc510c84e82bac145238ebd",
            "source:f746bc84aab8081018806491",
            "source:fe0bc250642534d79f5db766",
            "source:6edf0c70ec1e36e5c46b1b44",
            "source:394e3cba325699d700809002"
          ],
          "text": "A Defias convict in the Stockade uprising described by Warden Thelwater, a prisoner who fights with two weapons and Backhand.",
          "when": {
            "entry": 1711
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1715,
      "name": "Defias Insurgent",
      "records": [
        {
          "authored": false,
          "id": "npc:1715:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7aeb86e4eb85fe153828c32a",
            "source:9ca7f194c2704f53c013245c",
            "source:fe0bc250642534d79f5db766",
            "source:3245b32f5b60f0b790dbde4f",
            "source:b3f8553107fbe76c18f12079"
          ],
          "text": "A Defias insurgent counted among the prisoners in the Stockade uprising that Warden Thelwater seeks to quell. It takes a forceful battlefield role, using Battle Shout and Demoralizing Shout.",
          "when": {
            "entry": 1715
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1716,
      "name": "Bazil Thredd",
      "records": [
        {
          "authored": false,
          "id": "npc:1716:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5d74feac66495d7672810495",
            "source:c35e44861ede4adc9abab281",
            "source:7c842aa7829771318c683170",
            "source:abdb5c6b9a720ff9423b4282",
            "source:a5fd2084a2b6aaa7db81379c",
            "source:9fef421ee4dfe05a50433fb9",
            "source:63312af6cb358dc2a04fb138",
            "source:b8434106e75135cc0291ee8d"
          ],
          "text": "Bazil Thredd is a named prisoner who declares that the Stockade belongs to his side and calls visitors the Warden's errand boys. His words mark a direct conflict with the Warden's authority. He can dual wield and use Smoke Bomb and Battle Shout.",
          "when": {
            "entry": 1716
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1717,
      "name": "Hamhock",
      "records": [
        {
          "authored": false,
          "id": "npc:1717:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:09afb9527935ec14c954e9b4",
            "source:53a87a2d12ac124401fbe57c",
            "source:4a066cf86cfb018a5dcbb319",
            "source:82a3d171eabfb8c83422f879"
          ],
          "text": "Hamhock is an aggressive humanoid who threatens to crush his opponents and fights with Chain Lightning and Bloodlust.",
          "when": {
            "entry": 1717
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1720,
      "name": "Bruegal Ironknuckle",
      "records": [
        {
          "authored": false,
