  "place": "The Stockade",
  "place_records": [
    {
      "authored": false,
      "id": "zone:717",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:717",
        "dbc:area:1519",
        "world:creature:1716",
        "world:creature:1696",
        "world:creature:1666",
        "world:creature:1663",
        "world:creature:1708",
        "world:quest:386"
      ],
      "text": "You are in the Stormwind Stockade, a prison in Stormwind City. Defias inmates, captives, convicts and insurgents fill it, and Bazil Thredd claims the place for his side against the Warden's authority. Targorr the Dread, Kam Deepfury and Dextren Ward are held here, Targorr's execution delayed by a noble's hold and Dextren Ward's imprisonment angering Darkshire's council.",
      "when": {
        "zone_id": 717
      }
    }
  ],
