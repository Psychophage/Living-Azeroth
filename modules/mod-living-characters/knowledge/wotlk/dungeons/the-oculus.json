{
  "era": "wotlk",
  "format": "living-azeroth-npc-summaries",
  "map": 578,
  "npcs": [
    {
      "entry": 27447,
      "name": "Varos Cloudstrider",
      "records": [
        {
          "authored": false,
          "id": "npc:27447:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:53c2b7cfadee8e61e4d410ef",
            "source:ea86e4df1a1156dd96bee9aa",
            "source:5b94f28cc1e4ffa3a0fc592a",
            "source:aeb986c7bc21854e6c31af45"
          ],
          "text": "Varos Cloudstrider is the Azure-Lord of the Blue Dragonflight and commands the drakes guarding the Oculus conduit. He boasts that they control the skies and protect it, then threatens intruders who seek the Oculus. Though he expects victory, he admits defeat after underestimating his opponents' strength.",
          "when": {
            "entry": 27447
          }
        }
      ],
      "title": "Azure-Lord of the Blue Dragonflight"
    },
    {
      "entry": 27633,
      "name": "Azure Inquisitor",
      "records": [
        {
          "authored": false,
          "id": "npc:27633:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c5e6874f2bb31e5982165327",
            "source:e04d940b8c990c9323ba784c",
            "source:4fef0cf3825c0e2a614b498b"
          ],
          "text": "An Azure Inquisitor is one of the Azure forces encountered in the Oculus. It is a combatant that throws weapons at nearby hostiles.",
          "when": {
            "entry": 27633
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27635,
      "name": "Azure Spellbinder",
      "records": [
        {
          "authored": false,
          "id": "npc:27635:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9906a42cc85714d6c4a8cbb5",
            "source:c76d5818728becae0c2a0fb5",
            "source:834c2d40c1d916cd26ca6f2b"
          ],
          "text": "An Azure Spellbinder is an Azure combatant in the Oculus, distinguished by its use of Arcane Volley in combat.",
          "when": {
            "entry": 27635
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27636,
      "name": "Azure Ley-Whelp",
      "records": [
        {
          "authored": false,
          "id": "npc:27636:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9a5bc932d7173602aec631e9",
            "source:9dcae691af25428da5c9ccfa",
            "source:c9e8d26fc4260bfe89e1a884"
          ],
          "text": "An Azure Ley-Whelp is a lesser-ranked Azure creature found in the Oculus. It attacks with Arcane Bolt.",
          "when": {
            "entry": 27636
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27638,
      "name": "Azure Ring Guardian",
      "records": [
        {
          "authored": false,
          "id": "npc:27638:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a10fd62b2103ef95cd39d4c1",
            "source:c450b57b0b267377911c5d37",
            "source:b90932f41e11d47f949430aa"
          ],
          "text": "An Azure Ring Guardian is an Azure combatant encountered in the Oculus. It uses Ice Beam in battle.",
          "when": {
            "entry": 27638
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27639,
      "name": "Ring-Lord Sorceress",
      "records": [
        {
          "authored": false,
          "id": "npc:27639:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c4e92d2f25cf6d04c5a710b6",
            "source:e78f7bfd717f81f373f17878",
            "source:d1702bebea5d4f4f3b1fefcc"
          ],
          "text": "A Ring-Lord Sorceress is an Azure combatant in the Oculus. Her magical attacks include Blizzard.",
          "when": {
            "entry": 27639
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27640,
      "name": "Ring-Lord Conjurer",
      "records": [
        {
          "authored": false,
          "id": "npc:27640:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c1c6e0ffc417ab5726a3a189",
            "source:df7369501eb6570d2bb7836c",
            "source:6c76669298be90a39dd985c1"
          ],
          "text": "Ring-Lord Conjurers are hostile arcane defenders in the Oculus. They respond to aggression by casting Charged Skin, a spell that marks their role in the dungeon’s ring defenses.",
          "when": {
            "entry": 27640
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27641,
      "name": "Centrifuge Construct",
      "records": [
        {
          "authored": false,
          "id": "npc:27641:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:82eb553c263a541102b4a40e",
            "source:43544777be064ad0ece23c59",
            "source:9ecb8c27105626a6582da614"
          ],
          "text": "Centrifuge Constructs are hostile mechanisms involved in powering Varos Cloudstrider’s shield in the Oculus. Belgaristrasz explains that defeating them is part of exposing Varos, with the drakes provided by his group completing the plan.",
          "when": {
            "entry": 27641
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27654,
      "name": "Drakos the Interrogator",
      "records": [
        {
          "authored": false,
          "id": "npc:27654:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8359c7b3a8662160d7388170",
            "source:f38ebb560dea0d4888cf4cbf",
            "source:82d69a63255e46707000e64b",
            "source:69bb159db1c445355d150734",
            "source:5a7f31b8f1c66aa40340aae4"
          ],
          "text": "Drakos the Interrogator enforces Malygos’s law against those he calls prisoners, declaring that they shall not go free. His battle lines cast deaths as punishment and casualties of war, and even as he dies he insists that the war continues.",
          "when": {
            "entry": 27654
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27655,
      "name": "Mage-Lord Urom",
      "records": [
        {
          "authored": false,
          "id": "npc:27655:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:dec17a4412baed661607df18",
            "source:ee80a1cb9d9261ed17f7fc10",
            "source:cb5131136d8e78cea84afe0b",
            "source:d31146226b867654a3d1621b",
            "source:d8d86e0a308732dfb9675944"
          ],
          "text": "Mage-Lord Urom believes Malygos is saving the world, and dismisses challengers as blind or misguided. He deploys pets against them, then promises another demonstration when they fail. Belgaristrasz describes Urom as a traitor guarding the third ring; Urom says survivors will find him in the center ring.",
          "when": {
            "entry": 27655
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27656,
      "name": "Ley-Guardian Eregos",
      "records": [
        {
          "authored": false,
          "id": "npc:27656:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:1164318fa838033bb8f6a5a2",
            "source:d7fdc6fa7c291f371476c15b",
            "source:854b4132a19ca1ce778fc322",
            "source:0e6a8ce398f318ee395a3e2a"
          ],
          "text": "Ley-Guardian Eregos defends the ley-line conduit and threatens those who try to disrupt it. Belgaristrasz describes him as one of Malygos’s trusted minions, drawing strength from the energies he is charged to guard. Eregos treats challengers as insolent interlopers who deserve punishment.",
          "when": {
            "entry": 27656
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27657,
      "name": "Verdisa",
      "records": [
        {
          "authored": false,
          "id": "npc:27657:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a673419b8caa2b6775caabaf",
            "source:79499fb5a9667c131d79b322"
          ],
          "text": "Verdisa is a named drake giver in the Oculus.",
          "when": {
            "entry": 27657
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27658,
      "name": "Belgaristrasz",
      "records": [
        {
          "authored": false,
          "id": "npc:27658:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:93747e7c72f1907b679581ac",
            "source:9f899689bd5e77a13483dffa",
            "source:1062d2b7a613a3295a2d6dcc",
            "source:9097f0bfc23e78ff0363f56f"
          ],
          "text": "Belgaristrasz is a member of an assault team opposing Malygos, captured with his companions in the Oculus and later freed. He warns that the blue flight has been alerted and that Varos Cloudstrider and the ring guardians are coming. He and his companions can provide drakes to help expose Varos behind his shield.",
          "when": {
            "entry": 27658
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 27659,
      "name": "Eternos",
      "records": [
        {
          "authored": false,
          "id": "npc:27659:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9ea24fb5946f8ec8285a0e65",
            "source:ee297e9586e937bb9acb595b"
          ],
          "text": "Eternos is a named drake giver in the Oculus.",
          "when": {
            "entry": 27659
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28012,
      "name": "Image of Belgaristrasz",
      "records": [
        {
          "authored": false,
          "id": "npc:28012:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5086f46e736736ee2f6bfe39",
            "source:ef2a5a4da99b3e7b5896697b",
            "source:e98adc14baad900bfc1a5e95",
            "source:17e7c6d371d0dbadde1371ec",
            "source:e94e83060930c498d9199455",
            "source:9f3213c6c7e3772478ffcfeb",
            "source:c8317797f87e55bcb11204d0"
          ],
          "text": "An image of Belgaristrasz guides the assault through the Oculus. It warns that Mage-Lord Urom is a powerful conjurer guarding the third ring, and that Ley-Guardian Eregos awaits above the uppermost ring. It reports that defeating Urom has unlocked the drakes' full power and urges their careful use against Eregos.",
          "when": {
            "entry": 28012
          }
        }
      ],
      "title": ""
    }
  ],
