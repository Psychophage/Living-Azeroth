    },
    {
      "entry": 17805,
      "name": "Coilfang Slavemaster",
      "records": [
        {
          "authored": false,
          "id": "npc:17805:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a65647fa154d9855bc6b259f",
            "source:98c5e6be3a555c32dc241445",
            "source:5f92f6e3840069ab4a1ec3e2",
            "source:e4d0e5f17cacbb605a653084",
            "source:4134bc243aca2089c56fe8d4",
            "source:892a2e0a7953c61e37968fc7"
          ],
          "text": "A Coilfang slavemaster who drives slaves back to work with threats and beatings. He complains that his arms tire from hitting those he calls lazy peons, berates them for stopping too soon, and orders them to assist him when challenged. His voice combines contempt for the workers with reliance on their aid.",
          "when": {
            "entry": 17805
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17917,
      "name": "Coilfang Water Elemental",
