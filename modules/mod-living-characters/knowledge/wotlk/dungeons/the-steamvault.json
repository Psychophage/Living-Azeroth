  "npcs": [
    {
      "entry": 17721,
      "name": "Coilfang Engineer",
      "records": [
        {
          "authored": false,
          "id": "npc:17721:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:1cf02d62041da2484a7e0f23",
            "source:0616852a3a1387fb7fa51644",
            "source:34aa6084bdccc01fb3b9d642",
            "source:4e328b70db4651c7691680db",
            "source:951839e8e7c1b9166e5e7f41"
          ],
          "text": "A Coilfang engineer who fights intruders with bombs. Its battle cries invoke Nazjatar and describe its blood as venom, marking it as a naga combatant in the Steamvault.",
          "when": {
            "entry": 17721
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17722,
      "name": "Coilfang Sorceress",
      "records": [
        {
          "authored": false,
          "id": "npc:17722:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b25f236b82039a7bde55a65c",
            "source:b68aa7c8636597fe1a46910f",
            "source:bbd6b8096e97e396accb3fed",
            "source:bc24f8ed0305b56b29b2c4f0",
            "source:d3b0a6a9825af81489e10147"
          ],
          "text": "A Coilfang sorceress who attacks intruders with frostbolts. Her battle cries invoke Nazjatar and describe her blood as venom, identifying her as a naga combatant in the Steamvault.",
          "when": {
            "entry": 17722
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17796,
      "name": "Mekgineer Steamrigger",
      "records": [
        {
          "authored": false,
          "id": "npc:17796:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:47d2740b401cf7ca96d774c5",
            "source:267edeae6e349a253d164bb2",
            "source:be34b6215fbcdc5aeec92387",
            "source:ebc8616ce2153773ea073526",
            "source:a8747c2d8aad75f964db0780"
          ],
          "text": "Mekgineer Steamrigger is a forceful, taunting opponent in the Steamvault. He threatens intruders with pain and hot metal, and boasts after defeating one; his battle cries give him a rough, combative manner.",
          "when": {
            "entry": 17796
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17797,
      "name": "Hydromancer Thespia",
      "records": [
        {
          "authored": false,
          "id": "npc:17797:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:117355a039685c56f249dd3e",
            "source:c025bdfa6798a5a9209c9dc5",
            "source:3863b05f462a22abfe55f13b",
            "source:b15f708a0665fed8a2bed8f0",
            "source:295625347325d2b0295e0162"
          ],
          "text": "Hydromancer Thespia commands summoned pets and fights for her lady and master. She warns that her matron will be the end of her foes, showing her allegiance to a powerful naga superior. She threatens surface dwellers who enter the Steamvault.",
          "when": {
            "entry": 17797
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17798,
      "name": "Warlord Kalithresh",
      "records": [
        {
          "authored": false,
          "id": "npc:17798:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c15a5590ad66f091a3f7d437",
            "source:dcafb45ec288a43a6a9af2d8",
            "source:b0680a30b2dfe47e96aaaa6a",
            "source:39fe007953a211f6ffdb91d6",
            "source:da9ae3483dac9d226e6a67b4",
            "source:c5c0501a8f4e536da3d4c7be"
          ],
          "text": "Warlord Kalithresh commands troops in the Steamvault and guards work he says must not be compromised. He serves Lady Vashj, whom he calls Her Excellency, and draws power from a nearby distiller during the fight. He greets intruders as foes who have overcome his guards and openly despises their kind.",
          "when": {
            "entry": 17798
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17799,
      "name": "Dreghood Slave",
      "records": [
        {
          "authored": false,
          "id": "npc:17799:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c1293f81199b584e3d093fc3",
            "source:0218898de17bbfac4472e5c8",
            "source:ee96bc45824b180580aac12e"
          ],
          "text": "A Dreghood slave whose brief words mark liberation as the end of a long wait and a period of pain. The lines focus on being free at last, the day they had awaited, and pain finally ending.",
          "when": {
            "entry": 17799
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17800,
      "name": "Coilfang Myrmidon",
      "records": [
        {
          "authored": false,
          "id": "npc:17800:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:20f786b2c79049af33437779",
            "source:1ad454864aa8ed7f1eb00c2f",
            "source:0e3c2097f158d632ff50cd01"
          ],
          "text": "A Coilfang Myrmidon who voices open hostility toward warmbloods and invokes Nazjatar's depths. The taunt about venomous blood gives this combatant a threatening, venom-associated voice.",
          "when": {
            "entry": 17800
          }
        }
      ],
      "title": null
    },
    {
