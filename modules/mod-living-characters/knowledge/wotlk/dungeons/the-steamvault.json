  "place": "The Steamvault",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3715",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3715",
        "dbc:area:3521",
        "world:creature:17797",
        "world:creature:17796",
        "world:creature:17798",
        "world:creature:17801",
        "world:quest:9764",
        "world:quest:9765"
      ],
      "text": "You are in The Steamvault, a naga stronghold inside the Coilfang Reservoir in Zangarmarsh. Hydromancer Thespia, Mekgineer Steamrigger and Warlord Kalithresh lead it, and Thespia and Kalithresh serve Lady Vashj. Coilfang sirens, myrmidons, warriors, engineers, sorceresses and oracles fill its halls. Orders from Lady Vashj call for Cenarion druids to be slain on sight, and the Cenarion Expedition in Zangarmarsh faces the prospect of all out war with the naga.",
      "when": {
        "zone_id": 3715
      }
    }
  ],
