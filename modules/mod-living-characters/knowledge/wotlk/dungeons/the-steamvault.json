          "priority": 80,
          "sources": [
            "source:8db227114ed59cd07230bf67",
            "source:1fee407e837cf79783a34984"
          ],
          "text": "A Coilfang Water Elemental found in Coilfang Reservoir. In combat, it can cast Water Bolt Volley.",
          "when": {
            "entry": 17917
          }
        }
      ],
      "title": null
    },
