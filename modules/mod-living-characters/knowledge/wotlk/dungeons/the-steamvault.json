          "priority": 80,
          "sources": [
            "source:e52e77b062cfd9395b0f5917",
            "source:dd0180d06c55278ee104569a",
            "source:95f42855bfe75e6fb9b40df0"
          ],
          "text": "A Coilfang Oracle who voices open hostility toward warmbloods and invokes Nazjatar's depths. The taunt about venomous blood gives this combatant a threatening, venom-associated voice.",
          "when": {
