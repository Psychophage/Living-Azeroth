    {
      "entry": 24744,
      "name": "Vexallus",
      "records": [
        {
          "authored": false,
          "id": "npc:24744:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:88bf2ca26c8753ce9dac67d6",
            "source:7468b794b605e6d7b73c391a",
            "source:fe77e62da6468b2e5d387d0a",
            "source:a28d82f4378d13784769351d",
            "source:64c68d24f4c823f3fc67e40d",
            "source:cb84998b632c7c5ecc328194",
            "source:ccb77ec81c4d03f682f06dd6"
          ],
          "text": "Vexallus is a named elemental encounter figure whose fragmented commands circle around draining life, unleashing power, and consuming. His encounter also marks discharges of pure energy and overloads.",
          "when": {
            "entry": 24744
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 24761,
      "name": "Brightscale Wyrm",
