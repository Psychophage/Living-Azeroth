    {
      "entry": 24686,
      "name": "Sunblade Warlock",
      "records": [
        {
          "authored": false,
          "id": "npc:24686:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:92d9b054bb0878653a087ec6",
            "source:3940ecf3bcbfcf5496848450",
            "source:77422b581547e13eaa7bf448"
          ],
          "text": "A Sunblade Warlock, a spellcaster of the Sunblade forces on the Isle of Quel'Danas. Its demonic practice shows in the Sunblade Imp it summons.",
