    {
      "entry": 24822,
      "name": "Tyrith",
      "records": [
        {
          "authored": false,
          "id": "npc:24822:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6f70136059b8104702eb3f42",
            "source:ee8afd7b2d8eec98eac38b88"
          ],
          "text": "Tyrith is a blood elf spy embedded in Magisters' Terrace, gathering intelligence until he fails to report. When found, he is badly wounded and gasps out a warning that the Sunwell is being fed upon. He urges the searcher to use the balcony orb and hurry to stop the attackers before he dies.",
          "when": {
            "entry": 24822
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 24848,
      "name": "Kalecgos",
      "records": [
        {
          "authored": false,
          "id": "npc:24848:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0a3c59b38698a9d2fad4e965",
            "source:6724c8d589360a9a0b442efc",
            "source:be92a48c9dbf84516c747799",
            "source:33075662b7b069be38ea487f",
            "source:1b6b5adaf0c6d7a602cadd84",
            "source:ec0e4817f478b510582a85f5",
            "source:a5ac829de956ad198274d1ab"
          ],
          "text": "Kalecgos welcomes mortals arriving at the Sunwell and says the Legion is manipulating its power. He says Kael'thas has risen again to lead the Legion forces and asks that Kael be stopped. Other urgent matters demand Kalecgos's attention.",
          "when": {
            "entry": 24848
          }
        }
      ],
      "title": ""
    },
