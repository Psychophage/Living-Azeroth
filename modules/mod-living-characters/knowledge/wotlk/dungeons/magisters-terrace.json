    {
      "entry": 24687,
      "name": "Sunblade Physician",
      "records": [
        {
          "authored": false,
          "id": "npc:24687:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:08e9214122f1079c935a1813",
            "source:2a938883157e3c764cfb520b",
            "source:2bdc66576a70b2c14437989b"
          ],
          "text": "A Sunblade Physician, a spellcaster of the Sunblade forces on the Isle of Quel'Danas. Despite its title, it poisons foes with Inject Poison rather than offering aid.",
          "when": {
            "entry": 24687
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 24688,
      "name": "Wretched Skulker",
      "records": [
        {
          "authored": false,
          "id": "npc:24688:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:22ed6a1508cf539720070dad",
            "source:f2f9c369874a3c96b2544f6a",
            "source:89700e331e985318e079e411",
            "source:954bdcac8be3339cef94bbef",
            "source:ce7a3bed62f4505c7b33ac09",
            "source:0d883901a15cf07a5470e630",
            "source:369012319779d50097747c53"
          ],
          "text": "A Wretched Skulker is a creature found among the Sunblade forces on the Isle of Quel'Danas. Its words reveal a fixation on fel crystals: it claims the crystals as its own, fears others will steal their power, and cries for more. It also appears to draw on a fel crystal outside combat.",
          "when": {
            "entry": 24688
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 24689,
      "name": "Wretched Bruiser",
      "records": [
        {
          "authored": false,
          "id": "npc:24689:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c4adf1a4255327f2de663eba",
            "source:2fabe8b2ae534cc07f2a7cb2",
            "source:9b1a71ad0be58a242de93301",
            "source:22edc8160f8eec53173efa19",
            "source:27009f606c072c783a400f98",
            "source:8ac21bfb9ed99a1444a6ded5"
          ],
          "text": "A Wretched Bruiser is a creature found among the Sunblade forces on the Isle of Quel'Danas. When confronted, it warns others away from its crystals and insists it will never stop; its speech echoes the Wretched fixation on the burning power of the crystals.",
          "when": {
            "entry": 24689
          }
        }
      ],
      "title": ""
    },
