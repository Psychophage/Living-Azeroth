  "place": "Magisters' Terrace",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4131",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4131",
        "dbc:area:4080",
        "world:creature:24664",
        "world:creature:24744",
        "world:quest:11492",
        "world:creature:24686",
        "world:creature:24761",
        "world:creature:24822"
      ],
      "text": "You are in Magisters' Terrace on the Isle of Quel'Danas. Sunblade warlocks hold it for Kael'thas Sunstrider, lord of the blood elves, who once more leads Legion forces here, alongside Vexallus. Brightscale wyrms roam it, and the Sunwell is being fed upon.",
      "when": {
        "zone_id": 4131
      }
    }
  ],
