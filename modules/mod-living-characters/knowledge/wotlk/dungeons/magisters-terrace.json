    {
      "entry": 24723,
      "name": "Selin Fireheart",
      "records": [
        {
          "authored": false,
          "id": "npc:24723:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:78e7a15dba03397e8b6e9565",
            "source:bd4782ec42e8ea2196637d6f",
            "source:610f2048e568ec356f054e97",
            "source:2a81c1086a1fe1aadf069be4",
            "source:7f333f76e14893981a1f77c1"
          ],
          "text": "Selin Fireheart is a named encounter figure who dismisses others as distractions, boasts of godhood when empowered, and speaks of an insatiable hunger. Even as he dies, he cries that he must have more.",
