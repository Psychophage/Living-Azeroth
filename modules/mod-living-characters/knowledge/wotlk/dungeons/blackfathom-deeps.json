    {
      "entry": 4787,
      "name": "Argent Guard Thaelrid",
      "records": [
        {
          "authored": false,
          "id": "npc:4787:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:1a5ee4d49a3c8aa637d7046a",
            "source:246c472acd0544d215533784",
            "source:8afea64ffdb7aaf209d212d1",
            "source:ceb5327351653304f34c9de1",
            "source:8f43723e0371401ab4abd117"
          ],
          "text": "Argent Guard Thaelrid is an Argent Dawn scout gathering information at Blackfathom Deeps. After weeks without his report, Dawnwatcher Shaedlass asks for help finding him. Thaelrid is also involved in seeking aid against the Twilight's Hammer cultists and naga occupying the ruins.",
          "when": {
            "entry": 4787
          }
        }
      ],
      "title": "The Argent Dawn"
    },
    {
      "entry": 4798,
      "name": "Fallenroot Shadowstalker",
      "records": [
        {
          "authored": false,
          "id": "npc:4798:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:2c377632e5c9856fff68c6e3",
            "source:eca71a6f076eae0eb75899fd",
            "source:eb12899a58ede35e8deb6f24",
            "source:40d4bbd6ab63c78ba4b7cb84",
            "source:95287f547d9e2099f096e56a",
            "source:96bb95f469fd15ee054ba940"
          ],
          "text": "Fallenroot Shadowstalkers are hostile inhabitants of Blackfathom Deeps. They taunt intruders with threats of safety and dismemberment, and one threat promises to make trophies of their victims' eyes. They can cast Shadowstalker Stealth while out of combat.",
          "when": {
            "entry": 4798
          }
        }
      ],
      "title": ""
    },
    {
