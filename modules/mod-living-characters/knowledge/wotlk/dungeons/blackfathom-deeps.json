  "place": "Blackfathom Deeps",
  "place_records": [
    {
      "authored": false,
      "id": "zone:719",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:719",
        "dbc:area:2077",
        "world:quest:1199",
        "world:quest:1200",
        "world:creature:4832",
        "world:creature:4831",
        "world:creature:4829",
        "world:creature:4805"
      ],
      "text": "You are in Blackfathom Deeps, a ruined temple in Twilight Vale in Darkshore, where Twilight's Hammer cultists have allied with the naga to occupy the grounds. The cultists serve the Old Gods and work toward their return. Twilight Lord Kelris leads them. Its masters are Twilight Lord Kelris, Lady Sarevess and Aku'mai, a servant of the Old God who rose from the waters. Sea witches, myrmidons, oracles, tide priestesses, shadowstalkers, hellcallers and murlocs fill the place.",
      "when": {
        "zone_id": 719
      }
    }
  ],
