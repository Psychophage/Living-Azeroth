          }
        }
      ],
      "title": null
    },
    {
      "entry": 639,
      "name": "Edwin VanCleef",
      "records": [
        {
          "authored": false,
          "id": "npc:639:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:541d03ab03fad30ed2398d45",
            "source:4783ce69935d87a443ad4677",
            "source:57b6917954bdb131dbfe4b52",
            "source:71ae964479cd931b7a8d5f6a",
            "source:9cbf8d0a3f1df60d062a3557",
            "source:448d284e6563c374ba95797f",
            "source:16b89f91ef80ab8bf42d8953"
          ],
          "text": "Edwin VanCleef is the Defias kingpin in the Deadmines. Shaw’s report describes him as the former head of the Stonemasons’ Guild who rebuilt Stormwind after the First War, apparently resentful with his men of their treatment by the King afterward. VanCleef insists the Brotherhood’s cause is righteous and will prevail, calls allies from the shadows, and dismisses opponents as lapdogs.",
          "when": {
            "entry": 639
          }
        }
      ],
      "title": "Defias Kingpin"
    },
    {
      "entry": 641,
      "name": "Goblin Woodcarver",
      "records": [
        {
          "authored": false,
          "id": "npc:641:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:adf366a622cefccd4f80ccc9",
            "source:164d05c48d6a428de356ace5",
            "source:8d3bcb258e790d89f16971c6"
          ],
          "text": "A Goblin Woodcarver is a humanoid combatant who can use Axe Toss and Cleave in combat.",
          "when": {
            "entry": 641
          }
        }
      ],
      "title": null
    },
    {
      "entry": 642,
      "name": "Sneed's Shredder",
      "records": [
        {
          "authored": false,
          "id": "npc:642:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5bb8aa4495016b9cafe5bbe6",
            "source:883e9e1abd8be479453fa67b"
          ],
          "text": "Sneed's Shredder is a mechanical shredder with the title Lumbermaster; it can cast Terrify.",
          "when": {
            "entry": 642
          }
        }
      ],
      "title": "Lumbermaster"
    },
    {
      "entry": 644,
      "name": "Rhahk'Zor",
      "records": [
        {
          "authored": false,
          "id": "npc:644:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:08a8817fafd58e9b13873aef",
            "source:981fd222c115f6c8e9bc3451",
            "source:06da20145657000474aeec09"
          ],
          "text": "Rhahk'Zor is the foreman in the Deadmines. He threatens attackers by declaring that VanCleef pays well for their heads, and fights with a slam that stuns his opponent.",
          "when": {
            "entry": 644
          }
        }
      ],
      "title": "The Foreman"
    },
    {
      "entry": 645,
      "name": "Cookie",
      "records": [
        {
          "authored": false,
          "id": "npc:645:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7b9cd4874ffee87e1e27757a",
            "source:2b13509e77a97d54c609254d",
            "source:99daf22ce1e42c575ec0d0d3"
          ],
          "text": "Cookie is the ship's cook in the Deadmines. In combat, Cookie splashes acid at nearby enemies and uses cooking to restore health.",
          "when": {
            "entry": 645
          }
        }
      ],
      "title": "The Ship's Cook"
    },
    {
      "entry": 646,
      "name": "Mr. Smite",
      "records": [
        {
          "authored": false,
          "id": "npc:646:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ee0690c2ceaf0c1cdd10a967",
            "source:422bfc4257bda49cff0698bb",
            "source:a2d216cb4bbde574bd37506a",
            "source:59803344b710919296d05e7c",
            "source:f758f8736d4467b94aead9f8"
          ],
          "text": "Mr. Smite is the ship's first mate in the Deadmines. He orders the crew to investigate suspicious noise and repel invaders. Tougher opponents surprise him and prompt him to improvise; he voices anger as the fight continues.",
          "when": {
            "entry": 646
          }
        }
      ],
      "title": "The Ship's First Mate"
    },
    {
      "entry": 647,
      "name": "Captain Greenskin",
      "records": [
        {
          "authored": false,
          "id": "npc:647:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:bd7b7e58efee201e9b9e351f",
            "source:4d0688d26dfc2b3f3123e7ac",
            "source:c1b68b036f6a81ed6b931a01",
            "source:81f0513d2a8749233f7495b5"
          ],
          "text": "Captain Greenskin is a captain in the Deadmines who fights with cleaving blows and a poisoned harpoon.",
          "when": {
            "entry": 647
          }
        }
      ],
      "title": null
    },
    {
      "entry": 657,
      "name": "Defias Pirate",
      "records": [
        {
          "authored": false,
          "id": "npc:657:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d55995443a412a5ec9275614",
            "source:1b0caa0800355640bf3c1338"
          ],
          "text": "A Defias Pirate is a humanoid pirate who can cast Bloodsail Companion while out of combat.",
          "when": {
            "entry": 657
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1729,
      "name": "Defias Evoker",
      "records": [
        {
          "authored": false,
          "id": "npc:1729:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5a88ef0a9827ad31d0fb08ea",
            "source:bb413b2d0b8f2ac04c73c55f",
            "source:4ae5fef38f296b8e5f9433c6"
          ],
          "text": "The Defias Evoker is a combatant whose routine includes casting Frost Armor while out of combat. That defensive spell gives this evoker a distinct preparation before a fight.",
          "when": {
            "entry": 1729
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1731,
      "name": "Goblin Craftsman",
      "records": [
        {
          "authored": false,
          "id": "npc:1731:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e2b04938f25681d3c58ea7eb",
            "source:0c54a797b0b5ce0f3a4cd9af",
            "source:bb0792aa851bd3d65f7520c5",
            "source:5085c75afb968d0d020b9177"
          ],
          "text": "The Goblin Craftsman is an ore-working combatant: its routine casts Melt Ore during combat. When nearly defeated, it flees for assistance, suggesting it does not hold its ground once badly hurt.",
          "when": {
            "entry": 1731
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1732,
      "name": "Defias Squallshaper",
      "records": [
        {
          "authored": false,
          "id": "npc:1732:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5ae4cd5d2f21ab6fe1135f63",
            "source:e54f41ed5624258438e6ef4e",
            "source:13f1fac131b239342c46ba50",
            "source:1e1e457266fec6c34bf0d2c9"
          ],
          "text": "The Defias Squallshaper is a combatant with a small set of distinct spells: it casts Frost Armor out of combat and Fire Blast in combat.",
          "when": {
            "entry": 1732
          }
        }
      ],
      "title": null
    },
    {
      "entry": 1763,
      "name": "Gilnid",
      "records": [
        {
          "authored": false,
          "id": "npc:1763:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:82441dd28d115374424fde67",
            "source:186896e2acf5ccce1cfedb79",
            "source:0e6d124993c76fb33a075753",
            "source:f14b4b9f57ae4d8661f49c1a",
            "source:32e287ad964b5282508631c7",
            "source:854fd18ed33d5c3a2c05681e"
          ],
          "text": "Gilnid, known as the Smelter, directs workers to move parts to the ship and berates them when they ask for a break. His sharp orders make him a demanding overseer of the smelting work. In combat he uses Molten Metal.",
          "when": {
            "entry": 1763
          }
        }
      ],
      "title": "The Smelter"
    },
    {
      "entry": 3586,
      "name": "Miner Johnson",
      "records": [
        {
          "authored": false,
          "id": "npc:3586:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:13f10917211a488198d815e4",
            "source:609aaf19a2ff2819e011ad00",
            "source:e3252d1aa972d78f9e786fd4",
            "source:077090766e8407eb143a955a"
          ],
          "text": "Miner Johnson is a named miner who uses Pierce Armor.",
          "when": {
            "entry": 3586
          }
        }
      ],
      "title": null
    },
    {
      "entry": 3947,
      "name": "Goblin Shipbuilder",
      "records": [
        {
          "authored": false,
          "id": "npc:3947:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:fe72ee8a9d991c85acdb0660",
            "source:c9cad475fae7a5f057f8a5d7"
          ],
          "text": "The Goblin Shipbuilder tries to escape and summon help when reduced to very low health. Its instinct is to survive a losing fight rather than stay and be overwhelmed.",
          "when": {
            "entry": 3947
          }
        }
      ],
      "title": null
    },
    {
      "entry": 4416,
      "name": "Defias Strip Miner",
      "records": [
        {
          "authored": false,
          "id": "npc:4416:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:952d3e29f5632a253366a35b",
            "source:05d0f693f7fa65ac04629342",
            "source:62b026f5e1158bcd45531f68"
          ],
          "text": "Named for a mining trade, the Defias Strip Miner brings Pierce Armor to combat. Its identity is grounded in labor, with a piercing attack that marks it as a fighter as well as a worker.",
          "when": {
            "entry": 4416
          }
        }
      ],
      "title": null
    },
    {
      "entry": 4417,
      "name": "Defias Taskmaster",
      "records": [
        {
          "authored": false,
          "id": "npc:4417:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:2ff21171b0d070c4eac13339",
            "source:8888ba1af37eaa4bafa734f4",
            "source:895b648447b5ea3503cbb463",
            "source:eca0c8184b2c8190a4cddb84"
          ],
          "text": "The Defias Taskmaster, a figure associated with supervision by its title, uses ranged attacks such as Shoot and Piercing Shot when fighting.",
          "when": {
            "entry": 4417
          }
        }
      ],
      "title": null
    },
    {
      "entry": 4418,
      "name": "Defias Wizard",
      "records": [
        {
          "authored": false,
          "id": "npc:4418:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d26a09644af9d1d9457761ed",
            "source:27f4877221abf4c0ff661bf8",
            "source:ea448c501476104995c3c126"
          ],
          "text": "The Defias Wizard brings fire magic to combat, using Fireball against opponents. The title marks a magical role, and the spell gives that role a clear, destructive expression in battle.",
          "when": {
            "entry": 4418
          }
        }
      ],
      "title": null
    }
  ],
