          "id": "npc:636:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:194c148250611239d504ec9c",
            "source:5d93a3a50c4ca3d011f49870",
            "source:2d46feff3cbb74a717c088a3",
            "source:a598ba255afe38885b8d1be6",
            "source:1a4e848f0659140dacd0d858"
          ],
          "text": "A Defias blackguard in the Deadmines who conceals itself outside combat and springs from the shadows.",
          "when": {
