  "npcs": [
    {
      "entry": 19166,
      "name": "Tempest-Forge Patroller",
      "records": [
        {
          "authored": false,
          "id": "npc:19166:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3798ed2553593effdade10c4",
            "source:a05dfcb5744fdd02067a3ad0",
            "source:758622e1d80662aec3b7388f"
          ],
          "text": "A Tempest-Forge patroller serves as a Mechanar defender, treating intruders as threats to eliminate and ordered to protect the facility at all costs.",
          "when": {
            "entry": 19166
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19167,
      "name": "Bloodwarder Slayer",
      "records": [
        {
          "authored": false,
          "id": "npc:19167:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:bda2bad800562f5b5ed824d6",
            "source:d51bcd271f27a55879b40105",
            "source:b04b260fbf6d08a5ea59f705"
          ],
          "text": "A Bloodwarder Slayer is a Mechanar combatant.",
          "when": {
            "entry": 19167
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19168,
      "name": "Sunseeker Astromage",
      "records": [
        {
          "authored": false,
          "id": "npc:19168:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b786236601343ba903424240",
            "source:a8ce125acea9fd09de34aaf3",
            "source:200bcc23ab34bec3cca1026d",
            "source:01fbb7f413755dc4aaa2ecd4"
          ],
          "text": "A Sunseeker Astromage in the Mechanar fights with fire magic, using Fire Shield and Scorch; its combat repertoire also includes Solarburn.",
          "when": {
            "entry": 19168
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19218,
      "name": "Gatewatcher Gyro-Kill",
      "records": [
        {
          "authored": false,
          "id": "npc:19218:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:4defd69d92922249a60280d6",
            "source:217bd618a7b8a30a67151f14",
            "source:be951b6bd61e859deeb29b65",
            "source:cb31d662fdcc6acdb7328a8c",
            "source:c7a6a9dd4b2b040b926a3956",
            "source:f0d0544ac20e7687d9f31d52"
          ],
          "text": "Gatewatcher Gyro-Kill meets threats with cool, calculating menace: he predicts painful deaths, judges opponents' strategy as flawed, and treats violence as a matter of measurement and logic. Even his final contingency seems to catch him by surprise.",
          "when": {
            "entry": 19218
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19219,
      "name": "Mechano-Lord Capacitus",
      "records": [
        {
          "authored": false,
          "id": "npc:19219:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c180da2c2a7df63d0a5dc5d8",
            "source:c96e57da638ecd711005f0aa",
            "source:73f643425e14eda68e2d32b8",
            "source:4ae422d9f74efb175fba8a30",
            "source:807031b26f2852177e45842c",
            "source:4ecd57295a7c279544c01cd8",
            "source:a99fc854a3dbe6e8c541fe13"
          ],
          "text": "Mechano-Lord Capacitus answers challengers with loud, irreverent bravado, insisting he can take their best shot and asking whether they think he is afraid. He warns opponents before striking, boasts when he kills, and cries “Bully!” as he dies.",
          "when": {
            "entry": 19219
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19220,
      "name": "Pathaleon the Calculator",
      "records": [
        {
          "authored": false,
          "id": "npc:19220:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:46c50d538bc6e72e2acea2e2",
            "source:28520d730c961a06999f2717",
            "source:81f11fda8d78b180eb2a2ddd",
            "source:5202f2e5caee27e40194b35a",
            "source:41f1c71290c5069571d31a40",
            "source:cb466eecd85b29baf0a1f44c",
            "source:2731833ec2a82ab1e972bd14"
          ],
          "text": "Pathaleon the Calculator directs a continuing project and its workforce from the Mechanar. He treats intruders as disruptions to a strict timetable, seeks to dominate them, and insists the project will continue even as he dies.",
          "when": {
            "entry": 19220
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19221,
      "name": "Nethermancer Sepethrea",
      "records": [
        {
          "authored": false,
          "id": "npc:19221:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:bb00fab7787f28720a9fc6fb",
            "source:f067aa4e511ee957ba989cc5",
            "source:27409c7f6a391a642bfd3d0c",
            "source:7ab0f821d37e860e37fcd540",
            "source:d1a5bcfc1d9c930b91b52fb7",
            "source:2962f7cfac38a35daf7dd381",
            "source:fc5af219bc8c777f658ac1d1"
          ],
          "text": "Nethermancer Sepethrea confronts intruders with biting taunts. She dismisses defeated foes with “And don't come back!”",
          "when": {
            "entry": 19221
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19231,
      "name": "Mechanar Crusher",
      "records": [
        {
          "authored": false,
          "id": "npc:19231:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0f8896487fdbd24d9685bb14",
            "source:0534071d02c0c9b92e76f9d7",
            "source:cad6a5319a8c2187c47d519d"
          ],
          "text": "A Mechanar Crusher is a heavy machine creature that attacks with globules of machine fluid.",
          "when": {
            "entry": 19231
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19510,
      "name": "Bloodwarder Centurion",
      "records": [
        {
          "authored": false,
          "id": "npc:19510:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:88e95133ba61a1e06042b9bd",
            "source:3be943766972cea39c0ec439",
            "source:4a6b8377b6803b1e764aab85",
            "source:dd19e1950aa6b56047eacc1c"
          ],
          "text": "Bloodwarder Centurions serve as factory defenders: when intruders breach the factory, they call for emergency defense protocol and enter the gauntlet's combat response.",
          "when": {
            "entry": 19510
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19710,
      "name": "Gatewatcher Iron-Hand",
      "records": [
        {
          "authored": false,
          "id": "npc:19710:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:160e61464a5f40a7a7d2d207",
            "source:a33c56ca6b969fc40d23e997",
            "source:93522d22235670666a28d2a6",
            "source:dadd4e0d1d28570583e15fcb",
            "source:8a5750fbe2320857f2c05484",
            "source:4277e5be788d06ce6769904b",
            "source:23cd9a3581df20cb4a7eff68",
            "source:48eb738bd1c43d1580277d7e"
          ],
          "text": "Gatewatcher Iron-Hand is a calculating Mechanar combatant. The voice warns intruders they have seconds to live, describes its hammer strike in terms of angle and velocity, and insists processing will continue on schedule.",
          "when": {
            "entry": 19710
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19712,
      "name": "Mechanar Driller",
      "records": [
        {
          "authored": false,
          "id": "npc:19712:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b3c868a2e45acd9cbea7471e",
            "source:3c702db165a39bc8cdba1100",
            "source:1e3facf1e38a4dd5df208d6a",
            "source:450a5184656d692e82db05e4"
          ],
          "text": "Mechanar Drillers are hostile humanoid workers stationed in the Mechanar. In combat, they use machine fluid and a drill technique against intruders.",
          "when": {
            "entry": 19712
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19713,
      "name": "Mechanar Wrecker",
      "records": [
        {
          "authored": false,
          "id": "npc:19713:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:201d8f4bd96c5f2073cdd41d",
            "source:133fcf7d86a6e118aeb4f68e",
            "source:0227d511ca0e5b406e99d565",
            "source:a5b014c9fe07d3d241fcb046"
          ],
          "text": "Mechanar Wreckers are hostile humanoid workers stationed in the Mechanar. They attack intruders with machine fluid and heavy blows.",
          "when": {
            "entry": 19713
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19716,
      "name": "Mechanar Tinkerer",
      "records": [
        {
          "authored": false,
          "id": "npc:19716:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3888672a0b4dcdf680d1388f",
            "source:187868dd1e14cac67fba42b1",
            "source:fc1fc29cc7e562cd0ca4a35e",
            "source:e3d1d66e512343de973c45a1"
          ],
          "text": "Mechanar Tinkerers are hostile workers in the Mechanar. Their combat routine includes throwing Netherbombs, marking them as explosive specialists among the facility's defenders.",
          "when": {
            "entry": 19716
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19735,
      "name": "Tempest-Forge Destroyer",
      "records": [
        {
          "authored": false,
          "id": "npc:19735:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6b3be91d78b66f15d7c9766d",
            "source:716f53c38f072bb2667703dc",
            "source:2b5434a7732bb6528420aba0",
            "source:88003138075bef20b6197f3d"
          ],
          "text": "Tempest-Forge Destroyers are mechanical constructs in the Mechanar. They attack with Charged Fist and are the targets of a bounty offered by Nether-Stalker Mah'duun.",
          "when": {
            "entry": 19735
          }
        }
      ],
      "title": null
    },
    {
      "entry": 20059,
      "name": "Sunseeker Netherbinder",
      "records": [
        {
          "authored": false,
          "id": "npc:20059:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b9d260a6c7060e4bab316a6b",
            "source:e68fb97539de465553890550",
            "source:9f68c36edfc475eb918a8b27",
            "source:c99f1f3d123cab4f3dea68b0"
          ],
          "text": "Sunseeker Netherbinders are hostile Sunseeker forces in the Mechanar. In combat they summon Arcane Golems to aid them.",
          "when": {
            "entry": 20059
          }
        }
      ],
      "title": null
    },
    {
      "entry": 20988,
      "name": "Sunseeker Engineer",
      "records": [
        {
          "authored": false,
          "id": "npc:20988:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:21986e331544f95ebc26792e",
            "source:b50dcfd56eae9e3db9e0e615",
            "source:1f96d4fa481a8c211e6b2293"
          ],
          "text": "Sunseeker Engineers are hostile Sunseeker forces in the Mechanar. In combat, they use a Super Shrink Ray against their opponents.",
          "when": {
            "entry": 20988
          }
        }
      ],
      "title": null
    },
    {
      "entry": 20990,
      "name": "Bloodwarder Physician",
      "records": [
        {
          "authored": false,
          "id": "npc:20990:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0239881b8490c69d4893dae7",
            "source:18ba954e232574caca6c02f8",
            "source:d0c1c37e9b0ceda37f87d7ba"
          ],
          "text": "A Bloodwarder Physician supports allies in combat with Holy Shock and Anesthetic.",
          "when": {
            "entry": 20990
          }
        }
      ],
      "title": null
    }
  ],
  "place": "The Mechanar",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3849",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3849",
        "dbc:area:3842",
        "dbc:area:3523",
        "world:creature:19219",
        "world:creature:19221",
        "world:creature:19220",
        "world:creature:19716",
        "world:creature:20990"
      ],
      "text": "You are in The Mechanar, a facility within Tempest Keep in Netherstorm. Mechano-Lord Capacitus, Nethermancer Sepethrea and Pathaleon the Calculator are its masters. Pathaleon directs a continuing project and its workforce from there, and insists the project will go on even as he dies. Mechanar Tinkerers and Bloodwarder Physicians are the most numerous creatures inside.",
      "when": {
        "zone_id": 3849
      }
    }
  ],
