  "place": "Auchenai Crypts",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3790",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3790",
        "dbc:area:3688",
        "world:creature:18373",
        "world:creature:18371",
        "world:creature:18700",
        "world:creature:18493",
        "world:quest:10164",
        "world:quest:10167"
      ],
      "text": "You are in the Auchenai Crypts, the crypts of Auchindoun in Terokkar Forest. Exarch Maladaar defends the resting place of his ancestors here and is the greatest of its masters, with Shirrak the Dead Watcher, an undead creature, beside him. Reanimated bones and Auchenai soulpriests fill the halls. Maladaar continues to torment the spirits held inside, and a captive spirit is kept in a tomb deep within.",
      "when": {
        "zone_id": 3790
      }
    }
  ],
