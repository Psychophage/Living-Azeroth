    {
      "entry": 18373,
      "name": "Exarch Maladaar",
      "records": [
        {
          "authored": false,
          "id": "npc:18373:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8b712b24bd70560b0bf129b2",
            "source:79df5ffcf13e873f14ddfcf8",
            "source:97795ff019da24e56020b132"
          ],
          "text": "Exarch Maladaar defends the resting place of his ancestors and demands death for its defilement. He calls on his fallen brothers to rise and fight, and even as he dies declares that the crypt is where he belongs.",
          "when": {
            "entry": 18373
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18493,
      "name": "Auchenai Soulpriest",
