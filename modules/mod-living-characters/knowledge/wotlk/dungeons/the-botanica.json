    {
      "entry": 17975,
      "name": "High Botanist Freywinn",
      "records": [
        {
          "authored": false,
          "id": "npc:17975:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d04df372485f14fe7d6ea786",
            "source:d84a059e95011510d71bb33a",
            "source:b7ca9ec746ea85727dcc9228",
            "source:acdc568bd340f74d3c1b5e25",
            "source:c143dea6946400ff1f5aba09"
          ],
          "text": "High Botanist Freywinn is a botanist in the Botanica who guards delicate specimens and insists they must be preserved. He bends nature to his will, summoning plants, and speaks of his attacks in terms of life cycles and feeding the worms.",
          "when": {
            "entry": 17975
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17976,
      "name": "Commander Sarannis",
      "records": [
        {
          "authored": false,
          "id": "npc:17976:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:616dbfbc635fb2d286d94ae8",
            "source:63c30be86cf4bd6d84569a4e",
            "source:eefe7f75fb57936c5d7c47ff",
            "source:d27ce1dfc0029b7f44368c98"
          ],
          "text": "Commander Sarannis confronts intruders in the Botanica as a superior officer, dismissing them as underlings and describing her victories as mission accomplished. When pressed, she calls for reinforcements, maintaining a commander’s presence in battle.",
          "when": {
            "entry": 17976
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17977,
      "name": "Warp Splinter",
      "records": [
        {
          "authored": false,
          "id": "npc:17977:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:024f0559e3677d2e63b775e7",
            "source:283424e180c8569941900cea",
            "source:4fdc30e77127f54dd2b04667",
            "source:769c476dea272eac024aec64",
            "source:3ae41a25e31d575bc6475abf",
            "source:62632f6a285de581d753da17"
          ],
          "text": "Warp Splinter defends a sanctuary in the Botanica and calls its children to aid it. Its violence is conflicted: its threats break into hesitation and questions about what it is doing, and it dies confused, saying it does not belong here.",
          "when": {
            "entry": 17977
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17978,
      "name": "Thorngrin the Tender",
