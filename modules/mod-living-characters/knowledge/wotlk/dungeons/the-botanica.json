        {
          "authored": false,
          "id": "npc:17978:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:919a776fbda395fd272600ae",
            "source:03a8c2272f0074978701f457",
            "source:7bd3d805b6cb06a2a662a790",
            "source:51c069ead8dc3e17cc5ebb6d",
            "source:2c767e865ebceeef884a01de"
          ],
          "text": "Thorngrin the Tender welcomes \"my brothers\" and boasts of his power. He answers intruders with threats, revels in their pain and promises death.",
          "when": {
            "entry": 17978
          }
        }
      ],
      "title": null
    },
