    {
      "entry": 20904,
      "name": "Warden Mellichar",
      "records": [
        {
          "authored": false,
          "id": "npc:20904:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:65bad2736e92b6b39c1535bf",
            "source:f59678d41c632fab96f1a706",
            "source:8d19d5a2dd301a065c1971ef",
            "source:5cdefac269fb093e8b64bc4e",
            "source:13709f819b3ce4a754d442dc",
            "source:1d05aba144d896cb4ceff250"
          ],
          "text": "Warden Mellichar is a prisoner warden who admits that he let the captives out after hearing the “great one” speak to him. He appears disoriented and eager to please that power, yet recognizes visitors were not sent by Kael'thas. He presents the naaru as jailers of dangerous beings and introduces further captives with excited, deferential praise. His words show divided loyalties and compromised judgment.",
          "when": {
            "entry": 20904
          }
        }
      ],
      "title": null
    },
