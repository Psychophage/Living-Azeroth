  "place": "The Arcatraz",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3848",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3848",
        "dbc:area:3842",
        "dbc:encounter:500",
        "world:creature:20870",
        "world:creature:20865",
        "world:creature:20869",
        "world:creature:21962",
        "world:quest:10706"
      ],
      "text": "You are in The Arcatraz, a complex within Tempest Keep in Netherstorm. Harbinger Skyriss and Zereketh the Unbound are its masters, and protean horrors and Arcatraz sentinels fill it. Ashtongue seer Udalo was held here by Kael'thas, and the meaning of the word Atam'al, scrawled on the floor where he died, is still unclear to Akama.",
      "when": {
        "zone_id": 3848
      }
    }
  ],
