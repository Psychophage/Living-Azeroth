    {
      "entry": 21962,
      "name": "Udalo",
      "records": [
        {
          "authored": false,
          "id": "npc:21962:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b615b688672a39224dd13761",
            "source:cbeb0ff3b992b4d69cc9004e",
            "source:fcb757cfb873670098c8d5e4"
          ],
          "text": "Udalo was an Ashtongue seer held by Kael'thas inside the Arcatraz. Before his death, he left the barely legible word “Atam'al” beneath him, a message Akama hoped to understand.",
          "when": {
            "entry": 21962
          }
        }
      ],
      "title": null
