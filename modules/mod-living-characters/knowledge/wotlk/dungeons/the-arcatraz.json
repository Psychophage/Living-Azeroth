    {
      "entry": 20885,
      "name": "Dalliah the Doomsayer",
      "records": [
        {
          "authored": false,
          "id": "npc:20885:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d78d42e3177c6588561d4225",
            "source:25c7abab08580c8b0a68293a",
            "source:383c78f20b8bc964ff811356",
            "source:91a7eb42cb937b00c48a6347",
            "source:dd854b0f7252c8c581967705",
            "source:13866424e6d9be655d958f54"
          ],
          "text": "Dalliah the Doomsayer is a combative, impatient partner to Soccothrates. She mocks his judgment, rejects his help, and says she is used to cleaning up his messes; when he is under attack, she urges others to target him instead. Their exchanges suggest a strained familiarity, and she questions what he knows about commitment.",
          "when": {
            "entry": 20885
          }
        }
      ],
      "title": null
    },
    {
      "entry": 20886,
      "name": "Wrath-Scryer Soccothrates",
      "records": [
        {
          "authored": false,
          "id": "npc:20886:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:85ea9a6a5aadf314d5ae6951",
            "source:eb9202c3ef5f603f6090b519",
            "source:ac500a32c4e701b297d4e004",
            "source:4d2a985bae0e7fcab30af79c",
            "source:bf76921a8da0871f77b76bbe",
            "source:20979c5233e3cdd595946129"
          ],
          "text": "Wrath-Scryer Soccothrates relishes violence, calling a target for his frustrations and declaring a kill satisfying. He even asks to watch if someone has come to kill Dalliah. In battle he taunts and challenges his opponents; as he dies, he says he knew this was the only way out.",
          "when": {
            "entry": 20886
          }
        }
      ],
      "title": null
    },
