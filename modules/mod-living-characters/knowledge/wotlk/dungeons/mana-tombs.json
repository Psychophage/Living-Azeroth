  "npcs": [
    {
      "entry": 18309,
      "name": "Ethereal Scavenger",
      "records": [
        {
          "authored": false,
          "id": "npc:18309:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c8cd86758bfb856b3844de20",
            "source:a334c01a31c306162404344f",
            "source:fee20a725677b3917a0a92c4"
          ],
          "text": "An ethereal scavenger of the Mana-Tombs, this hostile void-dweller greets intruders with talk of the netherwinds and warns that hearing a whisper means death.",
          "when": {
            "entry": 18309
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18311,
      "name": "Ethereal Crypt Raider",
      "records": [
        {
          "authored": false,
          "id": "npc:18311:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f2d34a300e5b66dda21e9b0b",
            "source:150b4c39746ce3d15322168a",
            "source:dff16204d4331bc6f62d315f",
            "source:e63d4be555611defe0196799"
          ],
          "text": "An ethereal crypt raider of the Mana-Tombs, this hostile void-dweller welcomes intruders to the Void and speaks of the netherwinds. When badly wounded, it can become enraged.",
          "when": {
            "entry": 18311
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18312,
      "name": "Ethereal Spellbinder",
      "records": [
        {
          "authored": false,
          "id": "npc:18312:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:aa3036acdc28e712caee3539",
            "source:32e5b3f2aa5ccccbfbc0184f",
            "source:89ce42caccecdb6c27c35c96",
            "source:f0f04d2b25a181b5f2faa0ea"
          ],
          "text": "An ethereal spellbinder of the Mana-Tombs, this hostile void-dweller warns that hearing a whisper means death and welcomes intruders to the Void. It uses fire magic in combat.",
          "when": {
            "entry": 18312
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18313,
      "name": "Ethereal Sorcerer",
      "records": [
        {
          "authored": false,
          "id": "npc:18313:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ee912a3543a113c02bff85a6",
            "source:aa4d5dc4e56d7bc9c9b9c72d",
            "source:4042a895c00ead72ba820944",
            "source:1c8b52dff02ad62bd5eed147"
          ],
          "text": "An ethereal sorcerer of the Mana-Tombs, this hostile void-dweller warns that hearing a whisper means death and welcomes intruders to the Void. Its greeting is voiced when it engages a foe.",
          "when": {
            "entry": 18313
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18314,
      "name": "Nexus Stalker",
      "records": [
        {
          "authored": false,
          "id": "npc:18314:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c4bb0f9bc2fe899d2007572c",
            "source:cd95bc757f0d663444fe0b3d",
            "source:88bd8373e9cb2e4e6b48e34e",
            "source:afb6c923cbe9b628b53db758"
          ],
          "text": "A nexus stalker of the Mana-Tombs, this hostile void-dweller warns that hearing a whisper means death, welcomes intruders to the Void, and speaks of the netherwinds.",
          "when": {
            "entry": 18314
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18315,
      "name": "Ethereal Theurgist",
      "records": [
        {
          "authored": false,
          "id": "npc:18315:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b2c1a3bb4c54807402344d5c",
            "source:caaa31590c91813e9581f5cf",
            "source:91a33e4b30915a9991380879"
          ],
          "text": "Ethereal Theurgists greet newcomers with talk of the Void and netherwinds, then warn that hearing its whisper means death. Their welcome makes the Void sound like familiar territory, while their warning keeps an ominous edge.",
          "when": {
            "entry": 18315
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18317,
      "name": "Ethereal Priest",
      "records": [
        {
          "authored": false,
          "id": "npc:18317:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b83c7de781d2e30ada6b06fa",
            "source:135ae1b2065612a2bb97161f",
            "source:505e13ed4de7f310cdb31d0a"
          ],
          "text": "Ethereal Priests share their kin's eerie welcome to the Void and warning about its whisper. Their words cast the netherwinds as a familiar presence and greet arrivals with a calm, unsettling certainty about danger.",
          "when": {
            "entry": 18317
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18331,
      "name": "Ethereal Darkcaster",
      "records": [
        {
          "authored": false,
          "id": "npc:18331:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:257c280a71d32fd764a54c03",
            "source:2ab29859cd09312c5fdd8f08",
            "source:d2389078e13108423452e182"
          ],
          "text": "Ethereal Darkcasters greet strangers as outsiders far from home, then offer the same ominous welcome to the Void and warning about its whisper heard among their kin. Their brief words make the netherwinds and the Void sound familiar, while treating visitors as out of place.",
          "when": {
            "entry": 18331
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18341,
      "name": "Pandemonius",
      "records": [
        {
          "authored": false,
          "id": "npc:18341:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5ad5051380c8ce3969107b28",
            "source:a8bf8e5cbe0b3997f39faeb0",
            "source:c260d2b7d7da4240c2ae7a1b",
            "source:e963bbcc8ca6327915c70c26",
            "source:45bc34c657dc51bc3e293a4d",
            "source:ad0510ea2873135750e266c8"
          ],
          "text": "Pandemonius speaks of feeding on souls and urges victims not to resist. Killing his opponents leaves him empowered and hungry for more; in his death line, he says he is going to the Void once more. His own words make consumption and the Void central to his presence.",
          "when": {
            "entry": 18341
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18343,
      "name": "Tavarok",
      "records": [
        {
          "authored": false,
          "id": "npc:18343:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:95509fce61efe2d3cdcacc58",
            "source:23eaa93d557a6ab14b7dd338",
            "source:5999bb7c4020553e40f7b791",
            "source:2bf84d425a5d369faa1554a8"
          ],
          "text": "Tavarok is a giant of the Mana-Tombs.",
          "when": {
            "entry": 18343
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18344,
      "name": "Nexus-Prince Shaffar",
      "records": [
        {
          "authored": false,
          "id": "npc:18344:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:da22fa4d38de3cc6f3df5018",
            "source:80fb57111fed4292745d4d64",
            "source:45dbad169fda456d921b31ac",
            "source:ce942a4b76a95a01bc0ec57e"
          ],
          "text": "Nexus-Prince Shaffar greets unexpected company with an apology and calls himself a gracious host, while promising to deal with visitors personally. He says he has longed for adventure and calls battle exciting, treating even a fight’s end as entertaining. His manner is theatrically hospitable.",
          "when": {
            "entry": 18344
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18431,
      "name": "Ethereal Beacon",
      "records": [
        {
          "authored": false,
          "id": "npc:18431:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b077998ad2999e1394dfb8f4",
            "source:51604ed6bb141ed1201751b6",
            "source:803c67985641552ec1bb34ff",
            "source:deb60c7518c355e6b0d24293"
          ],
          "text": "The Ethereal Beacon is a combatant in Mana-Tombs that summons an Ethereal Apprentice, casts Arcane Bolt, and calls for help when attacked.",
          "when": {
            "entry": 18431
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19306,
      "name": "Mana Leech",
      "records": [
        {
          "authored": false,
          "id": "npc:19306:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f99e550f6064984e975ad6ab",
            "source:89a61c2168fa5a8a3eca5d35",
            "source:38650c6a12391311add82036"
          ],
          "text": "The Mana Leech is a creature found in Mana-Tombs. In combat it uses Mana Burn.",
          "when": {
            "entry": 19306
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19307,
      "name": "Nexus Terror",
      "records": [
        {
          "authored": false,
          "id": "npc:19307:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8daf09e7e11a1c2bf6a90e04",
            "source:eca6b12384e6fc6933d3a638",
            "source:e814a1b730c69d505f1774b9"
          ],
          "text": "The Nexus Terror is a combatant found in Mana-Tombs. It uses Shadow Embrace in combat.",
          "when": {
            "entry": 19307
          }
        }
      ],
      "title": null
    },
    {
      "entry": 19671,
      "name": "Cryo-Engineer Sha'heen",
      "records": [
        {
          "authored": false,
          "id": "npc:19671:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:12fe8cd95318aa21c3caff53",
            "source:4ad73daf988ce8698b62d2f3",
            "source:c8247e76f46c35be925d3a3a",
            "source:93461fff35019983df8737ae",
            "source:ab734f35617d8e66765b6474",
            "source:c957fd1ce1757923a1391c66",
            "source:28ee25cb65495f45158f4b2a"
          ],
          "text": "Cryo-Engineer Sha'heen is an individual engineer who takes over Morphalius's Mana-Tombs expedition, calling his predecessor an idiot and treating the work as a chance to extract ether from Shaffar's collectors. He expects an escort to protect him, complains when attacks interrupt his work, and jokes about deducting trouble from the reward. His crew is part of the operation; his dialogue shows a sardonic, self-interested streak rather than much concern for the danger around him.",
          "when": {
            "entry": 19671
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "Mana-Tombs",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3792",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3792",
        "dbc:area:3688",
        "dbc:area:3519",
        "world:creature:18344",
        "world:creature:18341",
        "world:creature:18313",
        "world:creature:19306",
        "world:quest:10165"
      ],
      "text": "You are in the Mana-Tombs, a crypt within Auchindoun in Terokkar Forest. Nexus-Prince Shaffar holds it and pillages it for all it is worth, keeping outside forces locked out. Pandemonius, who speaks of feeding on souls, rules here as well, and ethereals of several kinds and Mana Leeches fill its halls.",
      "when": {
        "zone_id": 3792
      }
    }
  ],
