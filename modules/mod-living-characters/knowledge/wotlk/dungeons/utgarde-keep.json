    {
      "entry": 23953,
      "name": "Prince Keleseth",
      "records": [
        {
          "authored": false,
          "id": "npc:23953:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:784ad8f8d4600d0eb621140f",
            "source:2ef73e40f23abb4f16c35e2c",
            "source:9b0b775e0b9eacfc09fa6835",
            "source:82256879ffde5aed0d9443fa",
            "source:bb8da7b4e73dac53a9b5cd2f",
            "source:db4d922ef46d7971d99f564d"
          ],
          "text": "Prince Keleseth is a San'layn elf prince who commands skeletons and uses Frost Tomb in battle. His taunts and death words invoke blood, darkness, and joining the night, giving him a cold, vampiric menace.",
          "when": {
            "entry": 23953
          }
        }
      ],
      "title": "The San'layn"
    },
    {
      "entry": 23954,
      "name": "Ingvar the Plunderer",
      "records": [
        {
          "authored": false,
          "id": "npc:23954:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:19e046ccf35357589a340c35",
            "source:9292e9692f174fbe7600e650",
            "source:b52572c082723c3d5132f09c",
            "source:5030f1e0ac882fa37856f597"
          ],
          "text": "Ingvar the Plunderer is a fierce warrior who threatens to paint his face with blood and calls himself a warrior born. His battle speech invokes a death god and promises a return for another chance to carve a skull.",
          "when": {
            "entry": 23954
          }
        }
      ],
      "title": ""
    },
