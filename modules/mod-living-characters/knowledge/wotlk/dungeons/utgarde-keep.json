    {
      "entry": 30531,
      "name": "Elder Jarten",
      "records": [
        {
          "authored": false,
          "id": "npc:30531:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3c4f2d9ce6fc9b76104182c6",
            "source:9bb5b4a7070265930188d882",
            "source:e1442111f8d8eea3b9fb6337",
            "source:5042c588073a981f947049ce",
            "source:4db8b209ab84657d75d9dae4",
            "source:1b44af040275dbd6f9703033",
            "source:fb51e4dc505b8486525f9d06"
          ],
          "text": "Elder Jarten is an elder who speaks of the stars as beacons of hope and strength for ages to come. He is connected with homage to the olden races and can direct visitors asking about Elders Chogan'gada, Lunaro, and Whurain.",
