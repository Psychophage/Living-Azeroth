          }
        }
      ],
      "title": null
    },
    {
      "entry": 17727,
      "name": "Wrathfin Sentry",
      "records": [
        {
          "authored": false,
          "id": "npc:17727:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7afb70560bc275a0119f8785",
            "source:838e19a9163744cfdc52a8cf",
            "source:f898a6b07e5b62c0ae10e17d",
            "source:04b8d534046d040e5b770db8",
            "source:4917e54bd2a7564399580c86",
            "source:dea15954dc23dc3f489e90c0"
          ],
