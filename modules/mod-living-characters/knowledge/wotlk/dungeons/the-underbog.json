      "title": null
    },
    {
      "entry": 17728,
      "name": "Murkblood Tribesman",
      "records": [
        {
          "authored": false,
          "id": "npc:17728:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:4f56170b3924f4019601b21b",
            "source:f2b114affbf58f35d294186f",
            "source:daa8016394c0e19c07d4ecfc",
            "source:8112c2ef94c37ffb71449f20"
          ],
          "text": "A Murkblood tribesman, a humanoid combatant that strikes opponents and can break into a frenzy.",
          "when": {
            "entry": 17728
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17729,
      "name": "Murkblood Spearman",
      "records": [
        {
          "authored": false,
          "id": "npc:17729:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:634cc935f50a69bdd6e7d524",
            "source:f212bd7f21b10ad440161c0e",
            "source:a2a0d8a9c33e374166c1a306",
            "source:f2f897d06d5ccecc64df6170"
          ],
          "text": "Murkblood Spearmen are humanoid fighters encountered in the Underbog. In battle they use Throw, and a sudden frenzy can mark their change in tempo.",
          "when": {
            "entry": 17729
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17730,
      "name": "Murkblood Healer",
      "records": [
        {
          "authored": false,
          "id": "npc:17730:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3db7c388e06508e7f9e68f96",
            "source:430d934bffb3a29f83c60ed8",
            "source:c7c4125f33a4d1c0960ec653",
            "source:0b58976ee5ff72ac0c48a7d6"
          ],
          "text": "Murkblood Healers are humanoid combatants who support nearby allies. When a friendly creature is badly wounded, they use Holy Light, and their massive healing effort may be signaled openly. Their defining role is tending the fight.",
          "when": {
            "entry": 17730
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17731,
      "name": "Fen Ray",
      "records": [
        {
          "authored": false,
          "id": "npc:17731:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c8bd5868689ac4787e6f99c1",
            "source:3d2260876dbb7a3df8b07d3b",
            "source:37eb939bb631e1fdc5fe732a"
          ],
          "text": "Fen Rays are beasts found in the Underbog. They attack with Psychic Horror, a frightening assault that distinguishes their combat behavior.",
          "when": {
            "entry": 17731
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17734,
      "name": "Underbog Lord",
      "records": [
        {
          "authored": false,
          "id": "npc:17734:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:52f18f744677f050fe46375d",
            "source:c6c14c13edaeab5bf69c5b63",
            "source:bb0d8d4569591e59d209e297",
            "source:df6efc4db17e82b65f26ae70"
          ],
          "text": "Underbog Lords are giant combatants. Their frenzy is visibly marked, and in combat they use Growth.",
          "when": {
            "entry": 17734
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17735,
      "name": "Wrathfin Warrior",
      "records": [
        {
          "authored": false,
          "id": "npc:17735:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5846713e00bb6671795bf106",
            "source:05af43bd73612af53fb34b7b",
            "source:c7400b80971461137081e246",
            "source:377ba5464a52a83aa7852bd4",
            "source:2dc7ce7294d13ade07f0d0aa",
            "source:0e2be04415065292e3840d5c"
          ],
          "text": "Wrathfin Warriors are humanoid fighters with venomous blood, which one boasts about in combat. They threaten warmbloods and can become enraged, giving their battle speech a hostile, taunting edge.",
          "when": {
            "entry": 17735
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17770,
