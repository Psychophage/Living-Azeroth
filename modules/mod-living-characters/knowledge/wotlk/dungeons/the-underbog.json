          "when": {
            "entry": 17882
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17885,
      "name": "Earthbinder Rayge",
      "records": [
        {
          "authored": false,
          "id": "npc:17885:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6a6868d1c0b7c3880657113b",
            "source:c54e1a7b9835ec2aefc0225e",
            "source:ca8d39096c4e486c80940945",
            "source:0c3fe9bbfff94b214c2eae9f"
          ],
          "text": "Earthbinder Rayge and Windcaller Claw were sent by Ysiel to investigate the steam pumps draining Zangarmarsh. Rayge says Swamplord Musel’ek captured Claw while he was in bear form and made him a pet; wary of being controlled too, Rayge refuses cat form and directs rescuers toward Claw.",
          "when": {
            "entry": 17885
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18105,
      "name": "Ghaz'an",
      "records": [
        {
          "authored": false,
          "id": "npc:18105:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:2f47c628bb3268a9491cc781",
            "source:3b8bf4d99bb9d45ab56a4931",
            "source:7468cc7356127705818056af"
          ],
          "text": "Ghaz’an is a boss in the Underbog. During the encounter, Ghaz’an becomes enraged.",
          "when": {
            "entry": 18105
          }
        }
      ],
      "title": null
    },
    {
      "entry": 18409,
