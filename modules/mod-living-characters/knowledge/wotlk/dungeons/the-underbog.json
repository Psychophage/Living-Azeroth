    {
      "entry": 17726,
      "name": "Wrathfin Myrmidon",
      "records": [
        {
          "authored": false,
          "id": "npc:17726:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:fb02cd6b19e1fa2f64ebcc29",
