    {
      "entry": 19632,
      "name": "Lykul Stinger",
      "records": [
        {
          "authored": false,
          "id": "npc:19632:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a47aad92cb0995d03a17878c",
            "source:907a8d3159df871a96a94efa",
            "source:de742406faeb7a49f0f8a6d0",
            "source:e47d5c3eb7c84d3e2cc710c3"
          ],
          "text": "A Lykul Stinger is a dangerous creature of the Underbog. When injured, it can become enraged and unleash its Stinger Rage, making its barbed attack especially threatening.",
          "when": {
            "entry": 19632
          }
        }
      ],
      "title": null
    },
    {
      "entry": 20465,
      "name": "Underbog Frenzy",
      "records": [
        {
          "authored": false,
          "id": "npc:20465:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:31adb8272b040e39983843fc",
            "source:27592d3af7ef932a0d24c258",
            "source:ff10f9310f50e80bc52aa55a"
          ],
          "text": "An Underbog Frenzy is an aggressive beast found in the Underbog. It charges into combat and can pierce an opponent’s armor, relying on its savage attacks rather than any known service or allegiance.",
          "when": {
            "entry": 20465
          }
        }
      ],
      "title": null
    }
  ],
  "place": "The Underbog",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3716",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3716",
        "dbc:area:3653",
        "world:creature:17770",
        "world:creature:17826",
        "world:creature:17885",
        "world:quest:9717",
        "world:creature:17724",
        "world:creature:17723"
      ],
      "text": "You are in The Underbog, a bog in Coilfang: The Underbog beneath Serpent Lake in Zangarmarsh. Hungarfen and Swamplord Musel'ek are its leading creatures, and underbats and bog giants fill it. Hungarfen is one of the leaders of the spore giants, who are at war with the people of Sporeggar. Musel'ek keeps Windcaller Claw captive as a pet.",
      "when": {
        "zone_id": 3716
      }
    }
  ],
