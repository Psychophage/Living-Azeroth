  "npcs": [
    {
      "entry": 28546,
      "name": "Ionar",
      "records": [
        {
          "authored": false,
          "id": "npc:28546:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:56848c7efa4c2bf13d975e43",
            "source:f63d90e417c6448a5f2a1c42",
            "source:cacea2ab1d1ba0f538d3b282",
            "source:fb8fee50f8b158c32850c659",
            "source:5bcabea734e4b5f0b182d19d"
          ],
          "text": "Ionar is an elemental guardian who challenges intruders seeking to confront his master, warning that they must first weather the storm. His taunts turn on lightning and the extinguishing of life, presenting him as a lethal obstacle in that approach.",
          "when": {
            "entry": 28546
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28547,
      "name": "Storming Vortex",
      "records": [
        {
          "authored": false,
          "id": "npc:28547:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ee6edf823f6cf236c5e6e437",
            "source:b3a267197aa25be1a8471742",
            "source:1e49598e438d087ef8caa2c1",
            "source:c7942f589a33144b98350f55",
            "source:40a706cbddd8ba8dc3884d7a"
          ],
          "text": "A Storming Vortex is an elemental combatant whose attacks draw on storm magic: it casts Lightning Bolt and Cyclone in the dungeon.",
          "when": {
            "entry": 28547
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28578,
      "name": "Hardened Steel Reaver",
      "records": [
        {
          "authored": false,
          "id": "npc:28578:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:15ed4f2f11eabc4e19397546",
            "source:21b4133af2f130f9404b70aa",
            "source:8844992d2af305b488175da8"
          ],
          "text": "A Hardened Steel Reaver is a humanoid steel fighter. In combat it uses Cleave, marking it as a close-range attacker among the hardened steel fighters.",
          "when": {
            "entry": 28578
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28579,
      "name": "Hardened Steel Berserker",
      "records": [
        {
          "authored": false,
          "id": "npc:28579:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:db09228ea2b8be588d050d63",
            "source:d6220c78fe31be6ed6319594",
            "source:44d7bac5c1135f83a4bef9c7",
            "source:0d80a7e6170e60d29de1a998"
          ],
          "text": "A Hardened Steel Berserker is a humanoid steel fighter that hurls weapons in combat and can become enraged. Its name and recorded actions distinguish its forceful attack role among the hardened steel fighters.",
          "when": {
            "entry": 28579
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28580,
      "name": "Hardened Steel Skycaller",
      "records": [
        {
          "authored": false,
          "id": "npc:28580:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7fa93a126bc34c880e34fb21",
