    {
      "entry": 28838,
      "name": "Titanium Vanguard",
      "records": [
        {
          "authored": false,
          "id": "npc:28838:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9676c2b71401a192dc52818a",
            "source:8517ed867b45ad7972af0790",
            "source:d4613ea1300216cc9586940f",
            "source:925bc3c39ca1449d9529dc87",
            "source:f29dc93599600b541f94c3d2",
            "source:6bad3ba1d588c9341ecb1d45"
          ],
          "text": "A Stormforged construct in the Terrestrial Watchtower, the Titanium Vanguard stands among the forces poised to carry out Loken’s will, as Archmage Timear warns. It charges opponents and strikes with a poison-tipped spear.",
          "when": {
            "entry": 28838
          }
        }
      ],
      "title": ""
    },
    {
