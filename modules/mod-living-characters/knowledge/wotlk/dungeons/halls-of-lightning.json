        }
      ],
      "title": ""
    },
    {
      "entry": 28923,
      "name": "Loken",
      "records": [
        {
          "authored": false,
          "id": "npc:28923:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6143ed63350b13914a75c886",
            "source:5015cbd70fde42f8764583e1",
            "source:1a67658b653a30b91e4c59e8",
            "source:b49b5b3ade1f798349a853fd",
            "source:ebbd87ddf8c7c2dc3ecd5f38",
            "source:16629c2b5831a3268f944fa8",
            "source:0902f9bfa0a930c68a8fa38d"
          ],
          "text": "Loken speaks of a master who has shown him the future. He predicts Azeroth will be reborn in darkness, Yogg-Saron released and the Pantheon fallen. He regards mortal history as a long record of foolishness and sees challengers as doomed by fate; even his death, he says, heralds the end of the world.",
          "when": {
            "entry": 28923
          }
        }
      ],
      "title": ""
    },
    {
