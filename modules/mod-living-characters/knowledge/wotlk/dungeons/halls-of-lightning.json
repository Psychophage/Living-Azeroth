          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28582,
      "name": "Stormforged Mender",
      "records": [
        {
          "authored": false,
          "id": "npc:28582:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:1f23f00a24bafdb666224a7e",
            "source:5af4cfa6ced77291233ffe60",
            "source:66490039d16dbf7d14bef3b9"
          ],
          "text": "The Stormforged Mender tends an injured ally with Renew Steel when that ally is badly hurt, giving it a battlefield support role among the Stormforged.",
          "when": {
            "entry": 28582
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28583,
      "name": "Blistering Steamrager",
      "records": [
        {
          "authored": false,
          "id": "npc:28583:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:36222e080b3f239d5b6965e2",
            "source:4e71b9b6bb7c462a724bc599",
            "source:b05a1c9c1d4acafe0050504d"
          ],
          "text": "A Blistering Steamrager is an elemental that attacks with Steam Blast when an enemy comes within close range. Its boiling steam is the defining danger it brings into a fight.",
          "when": {
            "entry": 28583
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28584,
      "name": "Unbound Firestorm",
      "records": [
        {
          "authored": false,
          "id": "npc:28584:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0fbc71a614945c2056c62941",
            "source:dd51f5fb5d2825837a337caa",
            "source:db253bc77e9d44c961325ff8"
          ],
          "text": "An Unbound Firestorm is an elemental that attacks with Lava Burst in combat. The burst of lava marks it as a direct threat in battle.",
          "when": {
            "entry": 28584
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28585,
      "name": "Slag",
      "records": [
        {
          "authored": false,
          "id": "npc:28585:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3fd570c8ec2dcf1800c16c9c",
            "source:13c4d4c0e791d6f7bf8f1d42",
            "source:7604b56040d3f25c4e9d283a",
            "source:7207485a1652a3a92060ab86"
          ],
          "text": "Slag is an elemental that uses Melt Armor against opponents and unleashes Blast Wave as it dies, making it dangerous both during a fight and at its end.",
          "when": {
