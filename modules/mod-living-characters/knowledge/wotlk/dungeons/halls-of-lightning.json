            "source:57714b4e497ae51a2d2a479f",
            "source:7095bbffcb3ab469ddea67cf"
          ],
          "text": "A Hardened Steel Skycaller is a humanoid combatant that attacks with a ranged weapon, using Shoot in combat.",
          "when": {
            "entry": 28580
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 28581,
      "name": "Stormforged Tactician",
      "records": [
        {
          "authored": false,
          "id": "npc:28581:identity",
          "layer": "npc",
          "priority": 80,
