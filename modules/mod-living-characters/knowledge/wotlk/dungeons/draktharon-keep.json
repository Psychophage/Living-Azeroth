    {
      "entry": 26641,
      "name": "Drakkari Gutripper",
      "records": [
        {
          "authored": false,
          "id": "npc:26641:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a122b9af97e1c3828b7af9f8",
