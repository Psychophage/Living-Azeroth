    },
    {
      "entry": 27909,
      "name": "Darkweb Victim",
      "records": [
        {
          "authored": false,
          "id": "npc:27909:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:990ed41509b547751a75333b",
            "source:e4067619cc853b1282064215"
          ],
          "text": "A Darkweb Victim is found in Drak'Tharon. When it dies, it summons a random Drakkari.",
