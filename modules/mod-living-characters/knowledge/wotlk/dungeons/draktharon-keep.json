      "title": ""
    },
    {
      "entry": 26664,
      "name": "Kurzel",
      "records": [
        {
          "authored": false,
          "id": "npc:26664:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:1f40486d2ab3501dca0c3176",
            "source:5f17dd4f80d5a8d50ef50e79",
            "source:c7f67608554bd9bbf9887a15",
            "source:a4aebd21365e049022a43e5e",
            "source:828dde93698a16236db780a9"
          ],
          "text": "Kurzel is an Orc woman who has been with Mack's camp for years, but she resents the men for leaving dangerous work to her and taking the rewards once it is safe. After wandering into Drak'Tharon alone, she is captured and weakened by venom. She expects the camp to come after her, then hands over her reward to the rescuer rather than those she calls spineless weasels. She plans to teach the men a lesson for letting a woman wander alone.",
          "when": {
            "entry": 26664
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 26830,
      "name": "Risen Drakkari Death Knight",
      "records": [
        {
          "authored": false,
          "id": "npc:26830:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9dd3c3d820bca45e0b3d1a32",
            "source:568bf38ada1379dfd914b2df",
            "source:56e602e97217ef3788384130"
          ],
          "text": "A risen Drakkari death knight, this elite undead uses Fear in combat.",
          "when": {
            "entry": 26830
          }
        }
      ],
      "title": ""
    },
