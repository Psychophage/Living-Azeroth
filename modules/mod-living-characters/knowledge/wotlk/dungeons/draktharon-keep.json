      ],
      "title": ""
    },
    {
      "entry": 28016,
      "name": "Drakuru",
      "records": [
        {
          "authored": false,
          "id": "npc:28016:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0569b587ac24b8b82f259fe9",
            "source:d6e88311ada137bd9b33617a",
            "source:96ea7a1e8bdb6a7c07a35bb0",
            "source:f4cc798c1ae025a0a25e4ab9",
            "source:dc0ef06978652f99b5f94d2c",
            "source:f1fc18d4e75f9e9200e8deed"
          ],
          "text": "Drakuru is a named figure with a personal mission at Drak'Tharon Keep. He returns there, gazes down on the keep, and says his mission is complete; he also admits deceiving the player for their own good. He speaks of a future already written and asks the player to consider their part in it.",
          "when": {
            "entry": 28016
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30534,
      "name": "Elder Kilias",
      "records": [
        {
          "authored": false,
          "id": "npc:30534:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f6529d573ea45b06fcc33df0",
            "source:88a70a6481b1f3701a5aa523",
            "source:4b8af68c9db5b2916a3a6a9d",
            "source:9a418467e034caab7074dc19",
            "source:b9772072ba0e779ceefb31f8",
            "source:262be5d8bf1269ddf3120f19"
          ],
          "text": "Elder Kilias is an elder whose words mark the new year and the moon as the time when the ancients awake. He also points visitors seeking Elder Ohanzee, Elder Tauros, Elder Nurgen, and Elder Graymane toward those fellow elders.",
          "when": {
            "entry": 30534
          }
        }
      ],
      "title": ""
    }
