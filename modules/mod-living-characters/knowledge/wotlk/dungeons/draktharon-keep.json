    {
      "entry": 26626,
      "name": "Scourge Reanimator",
      "records": [
        {
          "authored": false,
          "id": "npc:26626:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:16e335d2c1846aee5ffd3dc2",
            "source:79d4b35aa298c3a4b5248b6c",
            "source:a3cd7b4c44c832093d267fef",
            "source:b706c8c3a37714e087ac492c",
            "source:42fe212eeb5c5a20f7f55e2e",
            "source:fec3467178ccdc38e8699acd",
            "source:7f4a18ecb3d33709fbcd590d"
          ],
          "text": "The Scourge Reanimator promises newly risen warriors to a new liege and invokes the Lich King's regards. It warns pursuers of a parting gift, then fights with Frostbolt and Cripple.",
          "when": {
            "entry": 26626
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 26628,
      "name": "Drakkari Scytheclaw",
      "records": [
        {
