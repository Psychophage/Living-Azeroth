    {
      "entry": 38176,
      "name": "Tortured Rifleman",
      "records": [
        {
          "authored": false,
          "id": "npc:38176:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:fbffb3e2a9395ff57916d5de",
            "source:6e09c8e09a3c5bf38db7a42f",
            "source:90f51343e2d4a3c2dcb9beb5",
            "source:c69175402f01360eee96e579",
            "source:0c0a19e0f3ecab7c115c655c"
          ],
          "text": "This tortured rifleman is one of the dead serving a master. Its words speak of souls that cannot be freed and torment without end. The rifleman name marks its armed role, while its speech presents it as trapped in the master's service.",
          "when": {
