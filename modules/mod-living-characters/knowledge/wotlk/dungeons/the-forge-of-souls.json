          "priority": 80,
          "sources": [
            "source:5d464b2443b9d04220f79bc1",
            "source:6300693232330bca2333584a",
            "source:8a4cbbe0075a5202f722cfae"
          ],
          "text": "A Soul Horror, an undead Scourge creature among the hostile forces in Icecrown Citadel, that lashes out with Soul Strike.",
          "when": {
            "entry": 36522
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 36551,
      "name": "Spiteful Apparition",
      "records": [
        {
          "authored": false,
          "id": "npc:36551:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:18df2ef43075d424efafa115",
            "source:58a04cd83ca6569214a212bd"
          ],
          "text": "Spiteful Apparitions are hostile creatures of the Forge of Souls.",
          "when": {
            "entry": 36551
          }
        }
      ],
      "title": ""
    },
    {
