  "map": 632,
  "npcs": [
    {
      "entry": 36478,
      "name": "Soulguard Watchman",
      "records": [
        {
          "authored": false,
          "id": "npc:36478:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d5a153f24f3f40f4ed28c81e",
            "source:8440f19ee65edbc8ced212f1",
            "source:7b93992350e48824a088d542",
            "source:86a6d58fa24c9f8a69f1ad74"
          ],
          "text": "A Soulguard Watchman of the Cult of the Damned, an undead guardian among the Scourge forces in Icecrown Citadel. It can go into a frenzy and wrap itself in the Shroud of Runes.",
          "when": {
            "entry": 36478
          }
        }
      ],
      "title": "Cult of the Damned"
    },
    {
      "entry": 36497,
      "name": "Bronjahm",
      "records": [
        {
          "authored": false,
          "id": "npc:36497:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e11d6e0be04b9f0535675f35",
            "source:b98b819db753038b47370aac",
            "source:07c4840d370936dc2e6e7422",
            "source:38b716f4e79558943ffbef57",
            "source:6c85c51b36b8383ffdeedd1d",
            "source:4c4a80c82b8d003a030b38f2",
            "source:f858095348078c40dc0eec97",
            "source:2a8eb4d1951a8b727a948ca1"
          ],
          "text": "Bronjahm, the Godfather of Souls, commands the forge's soul-harvesting work in Icecrown Citadel. He welcomes a fight as a captive audience, treats victims as fodder for the engine, and threatens to sever their souls. As he falls, he invokes the Devourer.",
          "when": {
            "entry": 36497
          }
        }
      ],
      "title": "Godfather of Souls"
    },
    {
      "entry": 36499,
      "name": "Soulguard Reaper",
      "records": [
        {
          "authored": false,
          "id": "npc:36499:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5e17635217e919bf7e8e793e",
            "source:1f8ec767c9be351f32d1cd70",
            "source:09ffece4708582f7ee6d172e"
          ],
          "text": "A Soulguard Reaper of the Cult of the Damned, serving among the Scourge in Icecrown Citadel, who freezes foes in place with Frost Nova.",
          "when": {
            "entry": 36499
          }
        }
      ],
      "title": "Cult of the Damned"
    },
    {
      "entry": 36502,
      "name": "Devourer of Souls",
      "records": [
        {
          "authored": false,
          "id": "npc:36502:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:18969b589d98907bff6c723b",
            "source:8059659f02af0df5ce5ef40e",
            "source:07c4840d370936dc2e6e7422",
            "source:dfb51633f9e927067e6e4006",
            "source:945a6a72b6045412e9ddac26",
            "source:27777f5b4940decae006dcb3",
            "source:af6b7cd78c99b77c0f6fc31c",
            "source:4c4a80c82b8d003a030b38f2"
          ],
          "text": "The Devourer of Souls is a soul-consuming presence in Icecrown Citadel, allied with Bronjahm's forge operation. It threatens to devour those who face it and condemns its victims to damnation or eternal doom. Bronjahm invokes it as he falls.",
          "when": {
            "entry": 36502
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 36516,
      "name": "Soulguard Animator",
      "records": [
        {
          "authored": false,
          "id": "npc:36516:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6f6acdd2395033e7066e14e7",
            "source:f3174d38cbdace6db95044ac",
            "source:37dfb9fa820e425dd5a4a48f",
            "source:fb8f54216dd9e932a55c546e"
          ],
          "text": "A Soulguard Animator of the Cult of the Damned, serving among the Scourge in Icecrown Citadel, who hurls Shadow Bolt and drains with Soul Siphon.",
          "when": {
            "entry": 36516
          }
        }
      ],
      "title": "Cult of the Damned"
    },
    {
      "entry": 36522,
