    {
      "entry": 36666,
      "name": "Spectral Warden",
      "records": [
        {
          "authored": false,
          "id": "npc:36666:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:52e0f656f7f403613d10c6d2",
            "source:4bf62a20f77081d52f0fb8e6",
            "source:dfa4bf6d00b8026581ab256d",
            "source:e50f3cacc6eb86d74fab621e"
          ],
          "text": "A Spectral Warden, an undead creature that cloaks itself in a Veil of Shadow and lets out a Wail of Souls.",
          "when": {
            "entry": 36666
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 37583,
      "name": "Dark Ranger Kalira",
      "records": [
        {
          "authored": false,
          "id": "npc:37583:identity",
          "layer": "npc",
          "priority": 80,
