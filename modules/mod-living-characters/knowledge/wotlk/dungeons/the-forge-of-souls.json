    {
      "entry": 37596,
      "name": "Lady Sylvanas Windrunner",
      "records": [
        {
          "authored": false,
          "id": "npc:37596:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e943de57c172f9be8a84d662",
            "source:dafc5506fb2ec5c5b4962698",
            "source:f0045fff23969638944f2d66",
            "source:de51786d4645d00d3470d400",
            "source:be04ead100ee59456c5ab560",
            "source:b59470711a5891aa878062ea"
          ],
          "text": "Lady Sylvanas Windrunner, the Banshee Queen, leads a covert assault into Icecrown Citadel while the Argent Crusade and Knights of the Ebon Blade draw the Lich King's attention at the front gate. She seeks information in the Halls of Reflection that could help defeat Arthas, and directs champions to destroy the Forge of Souls' machinery and clear a route for her soldiers. Her commands are brisk and urgent; she treats this rare opening as a chance that must not be wasted.",
          "when": {
            "entry": 37596
          }
        }
      ],
      "title": "Banshee Queen"
    },
    {
      "entry": 37597,
      "name": "Lady Jaina Proudmoore",
      "records": [
        {
          "authored": false,
          "id": "npc:37597:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3aac1a6e09ac931fdc829f65",
            "source:789c9d7b0bef5b99ae14594d",
            "source:f3f4240c97b6caaa954d0275",
            "source:625da2fa749903aef1cdb16f",
            "source:b4da588e1199f5a937eee4f2"
          ],
          "text": "Lady Jaina Proudmoore leads her troops through the Forge of Souls as the Argent Crusade and Knights of the Ebon Blade attack Icecrown's front gate. She relies on information gathered by King Varian's SI:7 agents and believes powerful magic in the Halls of Reflection may help destroy the Scourge. Jaina urges champions forward and prepares her soldiers to follow. The deaths of her men weigh on her, deepening the guilt she already feels over Arthas's betrayal.",
          "when": {
            "entry": 37597
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 37779,
      "name": "Dark Ranger Loralen",
      "records": [
        {
          "authored": false,
          "id": "npc:37779:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d7094761833e71c5c933d8c1",
            "source:a68bf7db6de02d683e708fab",
            "source:77849ed4f63af9bc3750a933",
            "source:24ed50fcd547e794fbbd7112"
          ],
          "text": "Dark Ranger Loralen is a dark ranger encountered in the Halls of Reflection. Loralen urges those who come through to find Lady Sylvanas and escape Arthas's citadel.",
          "when": {
            "entry": 37779
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 38160,
      "name": "Lady Jaina Proudmoore",
      "records": [
        {
          "authored": false,
          "id": "npc:38160:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ca4d172c1c5e8b5a4572321f",
            "source:771770a901d32bbd4b1fde96",
            "source:7921aa982bf3cf500f0da697",
            "source:3bdf290355dff500b8c3f160"
          ],
          "text": "Lady Jaina Proudmoore leads an undermanned force into Icecrown Citadel and urges champions to clear a route into the Pit of Saron. She treats the opportunity as too rare to waste and hopes the Halls of Reflection will reveal Arthas's weakness—or perhaps a path to his redemption. Her magi prepare a Scourge transport device for the next mission.",
          "when": {
            "entry": 38160
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 38161,
      "name": "Lady Sylvanas Windrunner",
      "records": [
        {
          "authored": false,
          "id": "npc:38161:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0e3188ca4ab8b50d4ddb00d1",
            "source:edfc526ba9274df747d0ca83",
            "source:2afdfdd4c01559b7f0ad3039",
            "source:3941e12355c1bfcf2a881e22",
            "source:3ff0385eb614d209909a5f4a"
          ],
          "text": "Lady Sylvanas Windrunner, the Banshee Queen, leads a small force into Icecrown Citadel and presses champions to secure a route into the Pit of Saron. She seeks a clue to Arthas's weakness and a route to the vengeance she has long awaited. Her magi prepare a Scourge transport device for the next mission.",
          "when": {
            "entry": 38161
          }
        }
      ],
      "title": "Banshee Queen"
    }
  ],
  "place": "The Forge of Souls",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4809",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4809",
        "dbc:area:4862",
        "world:creature:36497",
        "world:creature:36502",
        "world:creature:36478",
        "world:creature:36522",
        "world:creature:37596",
        "world:quest:24506"
      ],
      "text": "You are in The Forge of Souls, a soul-harvesting forge reached through the Frozen Halls in Icecrown. Bronjahm, the Godfather of Souls, commands its work, and the Devourer of Souls, a formidable soul-consuming presence, is allied with him. Soulguards and soul horrors fill its halls, and Lady Sylvanas Windrunner, the Banshee Queen, has uncovered a hole into it from the defenses of Icecrown Citadel.",
      "when": {
        "zone_id": 4809
      }
    }
  ],
