    {
      "entry": 15593,
      "name": "Elder Starsong",
      "records": [
        {
          "authored": false,
          "id": "npc:15593:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e21ce2ff5065ff330604ee0c",
