    {
      "entry": 5710,
      "name": "Jammal'an the Prophet",
      "records": [
        {
          "authored": false,
          "id": "npc:5710:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d923faeb08357ff4b13cc7d2",
