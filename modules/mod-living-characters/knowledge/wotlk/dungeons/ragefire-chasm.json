          }
        }
      ],
      "title": null
    },
    {
      "entry": 11322,
      "name": "Searing Blade Cultist",
      "records": [
        {
          "authored": false,
          "id": "npc:11322:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:2e5a32891554cd71147d2297",
            "source:2752ad833377c1ba0082b422",
            "source:3589479b7394fa1b96a13c64"
          ],
          "text": "A Searing Blade Cultist, identified by its cultist role and name. In combat, this one can afflict an opponent with Curse of Agony.",
          "when": {
            "entry": 11322
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11323,
      "name": "Searing Blade Enforcer",
      "records": [
        {
          "authored": false,
          "id": "npc:11323:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6d378875a2338d245d900e22",
            "source:1bf9b157b8e20c6460aed101",
            "source:d25b282990f6caf8e955062b"
          ],
          "text": "A Searing Blade Enforcer, identified by its enforcer role and name. In combat, this one can use Shield Slam against an opponent.",
          "when": {
            "entry": 11323
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11324,
      "name": "Searing Blade Warlock",
      "records": [
        {
          "authored": false,
          "id": "npc:11324:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:739a8ce62c8b3bde075b5b5a",
            "source:876aa42bf9ce29c34102ede4",
            "source:a37136f48cf4d3e98b280158",
            "source:bc52bdb3b202e2a90915d112",
            "source:6793fba3703a53b79151b712"
          ],
          "text": "A Searing Blade warlock, this cultist summons a voidwalker before combat, casts Shadow Bolt in battle, and may flee for help when badly hurt.",
          "when": {
            "entry": 11324
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11517,
      "name": "Oggleflint",
      "records": [
        {
          "authored": false,
          "id": "npc:11517:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:138e68cf0153bcd2cec2cc50",
            "source:6bd010ac65f17d21eba89091",
            "source:859744f93a7686018ebab3bd"
          ],
          "text": "Oggleflint is identified as Ragefire Chieftain and fights with Cleave.",
          "when": {
            "entry": 11517
          }
        }
      ],
      "title": "Ragefire Chieftain"
    },
    {
      "entry": 11518,
      "name": "Jergosh the Invoker",
      "records": [
        {
          "authored": false,
          "id": "npc:11518:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8a16cced7c00ded5f7bb4d37",
            "source:3736331569276d27ccd029a2",
            "source:5159f55dea3eb4d85df55504",
            "source:ed9b854b8ecb41e57b5864e8"
          ],
          "text": "Thrall identifies Jergosh the Invoker as a Searing Blade leader of interest to Neeru and a threat to the Horde. In combat, Jergosh uses Curse of Weakness and Immolate.",
          "when": {
            "entry": 11518
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11519,
      "name": "Bazzalan",
      "records": [
        {
          "authored": false,
          "id": "npc:11519:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3736331569276d27ccd029a2",
            "source:12b81fbeb8f0bba1a90d5d29",
            "source:aac6677e4d15d911ae9f2385",
            "source:ceb7daf14b1dee531060eaae",
            "source:c693fcb8474a12dae88b0dfc"
          ],
          "text": "Thrall names Bazzalan as a satyr and Searing Blade leader, and says leaders like him may be valuable to Neeru. Bazzalan fights with poison and close-range strikes.",
          "when": {
            "entry": 11519
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11520,
      "name": "Taragaman the Hungerer",
      "records": [
        {
          "authored": false,
          "id": "npc:11520:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:53f4ed346170c25a77c59f6f",
            "source:7fa94aecf249d034f5689529",
            "source:283d570c91372a40a23ce9ec",
            "source:7bdb5207ead4b7819c83fa7e",
            "source:a0852ad9294696057df0e1cd"
          ],
          "text": "The account of “Slaying the Beast” identifies Taragaman as a Felguard and leader of the Searing Blade, portrayed as a threat secretly subverting Horde members. In combat he uses Uppercut and Fire Nova.",
          "when": {
            "entry": 11520
          }
        }
      ],
      "title": null
    }
  ],
  "place": "Ragefire Chasm",
  "place_records": [
    {
      "authored": false,
      "id": "zone:2437",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:2437",
        "dbc:area:1637",
        "world:quest:14356",
        "world:creature:11520",
        "world:creature:11518",
        "world:creature:11519",
        "world:creature:11318",
        "world:creature:11322"
      ],
      "text": "You are in Ragefire Chasm, a fiery chasm beneath Orgrimmar. The Searing Blade, a sect of the Shadow Council, performs its sinister work deep in the chasm. Its leaders Taragaman the Hungerer, Jergosh the Invoker and Bazzalan lead it, and Taragaman is said to be secretly subverting Horde members. Ragefire Troggs and Searing Blade Cultists fill the chasm.",
      "when": {
        "zone_id": 2437
      }
    }
  ],
