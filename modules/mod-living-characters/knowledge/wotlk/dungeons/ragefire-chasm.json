  "npcs": [
    {
      "entry": 11318,
      "name": "Ragefire Trogg",
      "records": [
        {
          "authored": false,
          "id": "npc:11318:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f210edab937a8ce451080be0",
            "source:53729e873b940bab28ea6bdc"
          ],
          "text": "A Ragefire Trogg from the creatures that came up from deep beneath Orgrimmar. After they killed Magatha's diplomats despite her attempt at peace, Rahauro's commission identifies troggs like this one as a threat to the Horde.",
          "when": {
            "entry": 11318
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11319,
      "name": "Ragefire Shaman",
      "records": [
        {
          "authored": false,
          "id": "npc:11319:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:53729e873b940bab28ea6bdc",
            "source:7235a23493c651decb2d42f5",
            "source:2dfc34951527706d50dc6e73",
            "source:b1bf1e47217ffc1974160e25"
          ],
          "text": "A Ragefire Shaman among the troggs that emerged beneath Orgrimmar and killed Magatha's diplomats. In battle, this shaman can heal a nearby ally with Healing Wave and may flee for help when badly hurt; Rahauro's commission names the shamans as part of the threat to the Horde.",
          "when": {
            "entry": 11319
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11320,
      "name": "Earthborer",
      "records": [
        {
          "authored": false,
          "id": "npc:11320:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b2b8d1a7eee24aac61554f17",
            "source:a2b2e9e5620bae74481127ce",
            "source:1e1839dff38b7b57ac4dbf1f"
          ],
          "text": "An Earthborer, a beast that attacks with Earthborer Acid.",
          "when": {
            "entry": 11320
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11321,
      "name": "Molten Elemental",
