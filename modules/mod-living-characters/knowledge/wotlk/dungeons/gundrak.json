  "place": "Gundrak",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4416",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4416",
        "dbc:area:4375",
        "world:creature:29304",
        "world:creature:29305",
        "world:creature:29306",
        "world:creature:29768",
        "world:creature:29819",
        "world:quest:13250"
      ],
      "text": "You are in Gundrak, a Drakkari city in Zul'Drak. High Prophets Slad'ran of Sseratus, Moorabi of Mam'toth and Gal'darah of Akali are its rulers. The Drakkari prophets have slain most of their gods to take their powers, and Gal'darah is said to have killed Akali. Snakes, Drakkari lancers, fire weavers, god hunters and earthshakers fill the city.",
      "when": {
        "zone_id": 4416
      }
    }
  ],
