  "place": "Razorfen Downs",
  "place_records": [
    {
      "authored": false,
      "id": "zone:722",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:722",
        "dbc:area:1316",
        "world:creature:7358",
        "world:creature:7357",
        "world:creature:7346",
        "world:creature:7347",
        "world:creature:7337",
        "world:quest:3525"
      ],
      "text": "You are in Razorfen Downs, a place of tangled vines in The Barrens. Amnennar the Coldbringer, a Scourge lich serving the Lich King, rules the Scourge-aligned quilboar here and calls wraiths from the freezing air. Mordresh Fire Eye, a Scourge commander, rules beside him. Splinterbone centurions, boneflayer ghouls and death's head necromancers fill its halls. The quilboar made a pact with the Scourge, and their idol near the entrance serves as an oven for the captives they take from the Barrens.",
      "when": {
        "zone_id": 722
      }
    }
  ],
