    },
    {
      "entry": 14686,
      "name": "Lady Falther'ess",
      "records": [
        {
          "authored": false,
          "id": "npc:14686:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a7082f14d0c30bee8b04e330",
            "source:00d20c1d1076d1ec5fc58eb2",
            "source:d4caf0e8c1c0945186425e8c",
            "source:156610b36e318afdbd17d154"
          ],
          "text": "Lady Falther'ess transforms into Salma Saldean as a disguise, then speaks as Falther'ess to call the player her next victim. Her recorded encounter presents her as a deceptive, hostile attacker whose reveal is marked by a direct threat.",
          "when": {
            "entry": 14686
          }
        }
      ],
      "title": null
    }
