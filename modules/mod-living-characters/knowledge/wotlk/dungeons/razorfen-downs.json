    {
      "entry": 2425,
      "name": "Varimathras",
      "records": [
        {
          "authored": false,
          "id": "npc:2425:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f9c9b2a09196eea5222734cf",
            "source:4760ccdff43b126db115e279",
            "source:85ea01528003315f3b4f8ebf",
            "source:86cbd763a34ae6029e858fe2",
            "source:c82ad0e9c68d67c37d766c5a",
            "source:609af48c3c1fd1b102eb6608",
            "source:a5788325e001258f221a3eaa",
            "source:a24d02916d72ff78562152c9"
          ],
          "text": "In his Undercity quest-giver role, Varimathras is a demon acting for the Dark Lady. He directs Deathstalkers against the Scarlet Crusade and orders the recovery of Searing Blade spellbooks for her. He presents her aim as overcoming the Lich King and freeing the Scourge. Curt with interruptions, he values loyalty, tenacity and useful service.",
          "when": {
            "entry": 2425
          }
        }
      ],
      "title": null
    },
    {
