          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e5a9b09fe8cd2aa2938a79e3",
            "source:01904901750c7808e4fc5e9c",
            "source:45485a4b435420fa4afb26f9",
            "source:5f928c5d46e0cac30a2296cb",
            "source:8796d64f9c8fee44b6f307d2",
            "source:3ff15f989a6871ced8295314"
          ],
          "text": "Ragglesnout is a named humanoid opponent. In combat he uses Shadow Bolt, Shadow Word: Pain and Dominate Mind, and can cast Heal when badly hurt.",
