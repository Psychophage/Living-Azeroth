    {
      "entry": 30535,
      "name": "Elder Yurauk",
      "records": [
        {
          "authored": false,
          "id": "npc:30535:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:626b4fe596bbd97dad430323",
            "source:b3aa25f70ce46e90c6be552b",
            "source:13da145c62e1ddf40840f161",
            "source:da1d2f12c082d941cb4f328e",
            "source:97f8f6846c255be3af18946b",
            "source:65367c56673ecb758999f169"
          ],
          "text": "Elder Yurauk is a seasonal elder whose words say that when the year is new and the moon shines bright, the ancients awake. His conversation includes questions about where to find Elders Fargal, Stonebeard, Nurgen and Muraco.",
          "when": {
            "entry": 30535
          }
        }
      ],
      "title": ""
