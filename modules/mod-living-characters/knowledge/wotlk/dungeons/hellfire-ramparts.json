  "npcs": [
    {
      "entry": 17259,
      "name": "Bonechewer Hungerer",
      "records": [
        {
          "authored": false,
          "id": "npc:17259:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:49dd550e3299f9a44e893076",
            "source:5ce31348c76df41b9cc532cc",
            "source:ed3a415fe700210f7d6c5418",
            "source:9b2c3d67efb3c68002998582",
            "source:f6a0d32fe87bfe52a42807ee"
          ],
          "text": "A Bonechewer fighter in the forces serving Kargath, the Hungerer shouts that the blood is their power and claims the world and the true Horde for his side. His battle cries invoke Kargath and victory, marking him as a committed enemy of those opposing the Bonechewer cause.",
          "when": {
            "entry": 17259
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17264,
      "name": "Bonechewer Ravener",
      "records": [
        {
          "authored": false,
          "id": "npc:17264:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b024e6a6573d2a649b269722",
            "source:f425f7fe4bbd850c61e562ea",
            "source:a6a97ba08df8ed4523d00120",
            "source:933a852fbc0b44f77e449eb1"
          ],
          "text": "A Bonechewer fighter serving Kargath, the Ravener shares his faction’s blood-and-victory battle cries. He also warns others to keep close watch on the ramparts because intruders could approach at any time, giving him a specific role in guarding the stronghold’s defenses.",
          "when": {
            "entry": 17264
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17269,
      "name": "Bleeding Hollow Darkcaster",
      "records": [
        {
          "authored": false,
          "id": "npc:17269:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8d2cd6dd1e4dcab167516c21",
            "source:8a1b5860869861abe7c61396",
            "source:211afcbd0df53da1417f5a79",
            "source:2116cb56441d162c5a4a403a"
          ],
          "text": "A Bleeding Hollow spellcaster fighting for Kargath’s forces, the Darkcaster repeats his faction’s calls of victory and blood power.",
          "when": {
            "entry": 17269
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17270,
      "name": "Bleeding Hollow Archer",
      "records": [
        {
          "authored": false,
          "id": "npc:17270:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:aca2aef646f8fbf68646e4a3",
            "source:35160480a7b45c540d5c558c",
            "source:7bc2ccfbd707643ce3469cab",
            "source:f8d2f8834ef6da320eeca168"
          ],
          "text": "A Bleeding Hollow archer among Kargath’s forces, this fighter joins the faction’s calls for victory and its claim that blood is power.",
          "when": {
            "entry": 17270
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17271,
      "name": "Bonechewer Destroyer",
      "records": [
        {
          "authored": false,
          "id": "npc:17271:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6d8531818d9c00264e133958",
            "source:fd5d227a52c70090b1682cc9",
            "source:455c2e17c0c1992f72df104d",
            "source:d54cbf4e31598bf126660164",
            "source:d6185978810ea8970f41e8c5"
          ],
          "text": "A Bonechewer fighter serving Kargath, the Destroyer calls for victory and declares his side the true Horde. He also proclaims blood as the source of his faction’s power, expressing allegiance to the Bonechewer cause and its struggle against opposing forces.",
          "when": {
            "entry": 17271
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17280,
      "name": "Shattered Hand Warhound",
      "records": [
        {
          "authored": false,
          "id": "npc:17280:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:26b0e028c087da5eb7f77c2b",
            "source:314e57f7fc90d21dbbff31b8",
            "source:149ee6abb836a22869b6aa00"
          ],
          "text": "The Shattered Hand Warhound is a combat beast that fights with its pack and uses a furious howl in battle.",
          "when": {
            "entry": 17280
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17281,
      "name": "Bonechewer Ripper",
      "records": [
        {
          "authored": false,
          "id": "npc:17281:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d250a028076c53c2b7185524",
            "source:dc00e41e86e733cb94b47825",
            "source:3ec450ec4e0a98b13b481a03",
            "source:d4a9adbb4761613c7d4cbcae",
            "source:14e693adec1559797112e662"
          ],
          "text": "Bonechewer Rippers are combatants who proclaim blood as their power and shout “Gakarah ma!” when they engage an enemy.",
          "when": {
            "entry": 17281
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17306,
      "name": "Watchkeeper Gargolmar",
      "records": [
        {
          "authored": false,
          "id": "npc:17306:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ad21ce50508c90eed00135ff",
            "source:f1473e849e236b4eb356e707",
            "source:d3679ffed06c223e912681b0",
            "source:28456ef9428d1ef6f2ae59da",
            "source:0bc6476ab904bd1ceb40b8ae",
            "source:44402f6266796ff71cc8544d",
            "source:f72f999ef70c54de1ec6b29f"
          ],
          "text": "Watchkeeper Gargolmar warns of intruders who breach his citadel, calling them fresh meat. He welcomes challengers with relish and demands healing when wounded.",
          "when": {
            "entry": 17306
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17307,
      "name": "Vazruden the Herald",
      "records": [
        {
          "authored": false,
          "id": "npc:17307:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7c8d3369e71c507b0a551227",
            "source:0c2fb63fe9355e7e8de430f5",
            "source:e368c3b1ee7fb5a379dd8ca5"
          ],
          "text": "Vazruden the Herald serves a lord whose identity he does not name in his taunt, where he boasts that his enemies’ people will soon kneel. He speaks with confidence in his master’s coming victory.",
          "when": {
            "entry": 17307
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17308,
      "name": "Omor the Unscarred",
      "records": [
        {
          "authored": false,
          "id": "npc:17308:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:44a828949a8d94632b39af18",
            "source:f3bfd37464047ae8413d750f",
            "source:4e2cda3165a54f92eda8abd2",
            "source:8750e52f7483a35fb5f3f2c8"
          ],
          "text": "Omor the Unscarred is a forceful demon leader who taunts challengers and boasts that they will die. He calls a pet to feast, revealing a direct bond expressed as a command.",
          "when": {
            "entry": 17308
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17309,
      "name": "Hellfire Watcher",
      "records": [
        {
          "authored": false,
          "id": "npc:17309:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f5ac6499e54f02a5e625f1b9",
            "source:16d556019f3a8413db6392f6",
            "source:63cea00954d77e27e25de642"
          ],
          "text": "A Watchkeeper's subordinate serving in Hellfire Citadel's Ramparts. This watcher uses shadow pain in combat and can be directed to cast Renew, giving it a supporting role alongside its watchkeeper.",
          "when": {
            "entry": 17309
          }
        }
      ],
      "title": "Watchkeeper's Subordinate"
    },
    {
      "entry": 17455,
      "name": "Bonechewer Beastmaster",
      "records": [
        {
          "authored": false,
          "id": "npc:17455:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:cc4baa0fa6397e450996b66f",
            "source:889ca1383ab474e30ae05993",
            "source:8629dbb636cdda690d4aa11c",
            "source:d29502e5e65becd1149b0b18",
            "source:337162848b47ad76ebc050da"
          ],
          "text": "A Bonechewer Beastmaster who calls for intruders to be held off while he releases his warhounds, then threatens them with the hounds' wrath. His combat role centers on unleashing the beasts.",
          "when": {
            "entry": 17455
          }
        }
      ],
      "title": null
    },
    {
      "entry": 17478,
      "name": "Bleeding Hollow Scryer",
      "records": [
        {
          "authored": false,
          "id": "npc:17478:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:4987bd1b41180126219ecf9c",
            "source:c82fe70143cf788add5a00ac",
            "source:caf3ea9e6abd58a266154dbe",
            "source:72302bb550a6fb88d2ea7a4b"
          ],
          "text": "A Bleeding Hollow scryer who invokes blood as a source of power and cries support for Kargath. In combat, this caster can use fear magic.",
          "when": {
            "entry": 17478
          }
        }
      ],
      "title": null
    }
  ],
  "place": "Hellfire Ramparts",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3562",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3562",
        "dbc:area:3545",
        "dbc:area:3483",
        "world:creature:17306",
        "world:creature:17308",
        "world:creature:17307",
        "world:creature:17280",
        "world:creature:17259"
      ],
      "text": "You are in Hellfire Ramparts, the walls of Hellfire Citadel in Hellfire Peninsula. Watchkeeper Gargolmar warns intruders that they are fresh meat, the demon leader Omor the Unscarred taunts them, and Vazruden the Herald serves a lord he does not name. Shattered Hand warhounds and Bonechewer Hungerers are the most common of the Bonechewer and Bleeding Hollow creatures that fill it.",
      "when": {
        "zone_id": 3562
      }
    }
  ],
