  "map": 608,
  "npcs": [
    {
      "entry": 29266,
      "name": "Xevozz",
      "records": [
        {
          "authored": false,
          "id": "npc:29266:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ded2941b295af35d2a6cdd04",
            "source:98ba92ec63bf60bad77f5a00",
            "source:264724d00e9f06a7246b5090",
            "source:cea93832f6b067c6c17f830d",
            "source:f644aae6bec9ae5ff3153863"
          ],
          "text": "Xevozz treats violence as a transaction: he says his freedom must be bought with blood, calls a kill business concluded, and celebrates profit. On returning, he says he is back in business and plans an exit strategy, presenting escape as the next deal.",
          "when": {
            "entry": 29266
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 29312,
      "name": "Lavanthor",
      "records": [
        {
          "authored": false,
          "id": "npc:29312:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:19f244a0e5362014ea402bb0",
            "source:fd7fe96ac9e5f232a7f2f12b"
          ],
          "text": "Lavanthor is a beast held in the Violet Hold.",
          "when": {
            "entry": 29312
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 29313,
      "name": "Ichoron",
      "records": [
        {
          "authored": false,
          "id": "npc:29313:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e88fe08a8639f30905b40ff5",
            "source:30b95fafb46899ea8b52eeeb",
            "source:f174b0ab1bd8ee5234784ced",
            "source:f5f6d8b27e5962fc770e82fd",
            "source:05d035ca65e9cf92c16e81f7",
            "source:9ea059792dc0c8e8b661bc8c"
          ],
          "text": "Ichoron presents himself as a force of nature and a tide that cannot be stopped. He demands that mortals stand aside, boasts of passing through, and declares unrestrained fury; in defeat, he says that he recedes.",
          "when": {
            "entry": 29313
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 29314,
      "name": "Zuramat the Obliterator",
      "records": [
        {
          "authored": false,
          "id": "npc:29314:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0c9d97d1bb2c29913c0070a3",
            "source:36af9df20c69164e2b8fd88a",
            "source:7102140e508e5ccbe43f9783",
            "source:d3f66d7058f986a45f4f2503",
            "source:8fa797df28a9a9beb11b4295"
          ],
          "text": "Zuramat speaks in clipped commands and threats, urging others to relinquish and fall to shadow. He demands more energy and tells others to know his pain; even his brief words give him a menacing, shadow-bound presence.",
          "when": {
            "entry": 29314
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 29315,
      "name": "Erekem",
      "records": [
        {
          "authored": false,
          "id": "npc:29315:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5dc88424836bdcdce6ca7389",
            "source:bbe6a6e7ae33f98932c1d94f",
            "source:8b82b40e65e82e5d04051fd6",
            "source:1894f62e1d039a17768643cc",
            "source:a96ad57393a04aa73f83d0e1"
          ],
          "text": "Erekem's speech breaks into harsh squawks and cackles. He warns others not to get in the way of his flight, celebrates kills, and declares that only the strong survive, presenting himself as focused on escape and survival.",
          "when": {
            "entry": 29315
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 29316,
      "name": "Moragg",
      "records": [
        {
          "authored": false,
          "id": "npc:29316:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:21c0c30b09d50bbf53a7d232",
            "source:5881b581793149db8b67fe81"
          ],
          "text": "Moragg is a demon held in the Violet Hold, Dalaran's prison.",
          "when": {
            "entry": 29316
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 29395,
      "name": "Erekem Guard",
      "records": [
        {
          "authored": false,
          "id": "npc:29395:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d7e18d0c643e4046ea620354",
            "source:c39cd0faa0a6d9a1134b5c27"
          ],
          "text": "Erekem Guards are prison guards associated with Erekem, present in Dalaran's prison.",
          "when": {
            "entry": 29395
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30658,
      "name": "Lieutenant Sinclari",
      "records": [
        {
          "authored": false,
          "id": "npc:30658:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9d0195a557a9f8cc9ae1b212",
            "source:f7826af35b6d9804fe27c7bf",
            "source:4ff7cf2641c60d9669ac20bd",
            "source:0f9ba8b922ae7e318bce2bf5",
            "source:0da201670567f3299fe9f54d",
            "source:d904496e7ab07bbdaa172437",
            "source:1e45eccdc4707994ef8a4111"
          ],
          "text": "Lieutenant Sinclari is a Dalaran prison officer coordinating its defense during a Blue Dragonflight invasion. She warns that her guards are struggling, directs arriving adventurers to relieve them, and points out defense crystals that can discharge if the fighting worsens. As the adventurers take over, she locks the door and wishes them luck; after they hold back the dragonflight and defeat its commander, she praises their work and offers them respite.",
          "when": {
            "entry": 30658
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 31118,
      "name": "Azure Raider",
      "records": [
        {
          "authored": false,
          "id": "npc:31118:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d01671c901388ca3476a2ca9",
            "source:dc1d5628fc31f671e758c6bc"
          ],
          "text": "An Azure Raider, a dragonkin warrior at the Violet Hold.",
          "when": {
            "entry": 31118
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 32204,
      "name": "Lieutenant Sinclari",
      "records": [
        {
          "authored": false,
          "id": "npc:32204:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:41c21311ed61848c15d9c249",
            "source:0093794e824e9f853cace9a9",
            "source:ac712ce4e5742a7c58ca69e5",
            "source:56e31dc281caba0daa81b690",
            "source:c18f231e3704d8105b362f42",
            "source:138cc9d8ced6dd17603323ac",
            "source:c2754302c383743cbfb976b8",
            "source:9ad4a7c92a89a258ccc42628"
          ],
          "text": "Lieutenant Sinclari guards the prison door against a Blue Dragonflight breach, warning as portal guardians and keepers emerge and the seal weakens, and urging the defenders to fight on.",
          "when": {
            "entry": 32204
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "The Violet Hold",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4415",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4415",
        "dbc:area:4567",
        "dbc:area:4395",
        "world:creature:29315",
        "dbc:encounter:545",
        "world:creature:29395",
        "world:creature:30658",
        "world:quest:13256"
      ],
      "text": "You are in the Violet Hold, a prison in Dalaran. Blue dragonflight invaders have taken it and mean to break out into the rest of Dalaran. Its masters are Erekem and Cyanigosa, the greater of the two. Erekem's guards stand in its halls, and Lieutenant Sinclari warns that her own guards are struggling to hold its defenses. Reports say prisoners are being freed.",
      "when": {
        "zone_id": 4415
      }
    }
  ],
