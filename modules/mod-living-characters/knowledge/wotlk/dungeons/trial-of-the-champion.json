      "entry": 33628,
      "name": "Highlord Tirion Fordring",
      "records": [
        {
          "authored": false,
          "id": "npc:33628:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:44f9ea4179b1ee7dc12db65b",
            "source:6a784a4b41fe258726327421",
            "source:a3784c550825ed7cb260e81d",
            "source:e713b06d18a36bb4386cea74",
            "source:3755af9eb1fab69125685424",
            "source:50e954182cf65c361258b16b"
          ],
          "text": "Highlord Tirion Fordring presides over the Tournament’s champion trials, welcoming the champions and explaining that they will face the Grand Champions before a further test from the Crusade’s own ranks. He announces when bouts begin and commends successful challengers, presenting the trials as a public test of skill.",
          "when": {
            "entry": 33628
          }
        }
      ],
      "title": ""
    },
    {
