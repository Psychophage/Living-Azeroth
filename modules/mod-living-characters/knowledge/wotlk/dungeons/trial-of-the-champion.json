  "place": "Trial of the Champion",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4723",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4723",
        "dbc:area:4658",
        "dbc:encounter:334",
        "dbc:encounter:338",
        "dbc:encounter:340",
        "world:creature:33628",
        "world:creature:34856",
        "world:quest:14199"
      ],
      "text": "You are in the Trial of the Champion, a coliseum within the Argent Tournament Grounds in Icecrown. Its guardians are the Grand Champions, the Argent Champion and the Black Knight. Highlord Tirion Fordring presides over the champions' trials, and spectators of many races fill the stands. The Kirin Tor warn of interference from the Black Knight.",
      "when": {
        "zone_id": 4723
      }
    }
  ],
