    {
      "entry": 35004,
      "name": "Jaeren Sunsworn",
      "records": [
        {
          "authored": false,
          "id": "npc:35004:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:95260154769ca32f5971c614",
            "source:3c1cfea99ea893924a814558",
            "source:46fb386bf4ae4fd91fcf96be",
            "source:f76c8025139b1ede2973e4a4",
            "source:25afbb15d5162713d2f975cb",
            "source:ab289b4b81e98a18141df6cc",
            "source:cb4e2d200c1b05987f8fe0fd"
          ],
          "text": "Jaeren Sunsworn is an arena announcer. He introduces Eadric the Pure and Argent Confessor Paletress, then presents faction champions by naming their affiliations and calling attention to their skills. His dedicated tournament commentary makes him a distinct public voice in the arena’s pageantry.",
          "when": {
            "entry": 35004
          }
        }
      ],
      "title": ""
