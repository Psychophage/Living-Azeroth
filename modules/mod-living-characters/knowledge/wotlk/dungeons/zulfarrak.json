  "place": "Zul'Farrak",
  "place_records": [
    {
      "authored": false,
      "id": "zone:1176",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:1176",
        "dbc:area:978",
        "dbc:area:440",
        "world:creature:7267",
        "world:creature:8127",
        "world:creature:7271",
        "world:creature:7604",
        "world:creature:5649"
      ],
      "text": "You are in Zul'Farrak, a place of trolls in Tanaris. Sandfury trolls fill it, and Chief Ukorz Sandscalp, who leads them, claims the desert as his own. Antu'sul, Overseer of Sul, commands the Sul'lithuz as his children and turns them against intruders, while Witch Doctor Zum'rah claims a sanctum here. Captives held by trolls include Sergeant Bly and his band.",
      "when": {
        "zone_id": 1176
      }
    }
  ],
