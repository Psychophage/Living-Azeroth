    {
      "entry": 21174,
      "name": "Magtheridon",
      "records": [
        {
          "authored": false,
          "id": "npc:21174:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:16f44b8cf026af4a47b49a79",
            "source:f6074036794cbd6e6e3bed4a",
            "source:f340599b33f036e03f46cb96",
            "source:f1d052bbc74b227242f58599",
            "source:a863890a57eb56b3b7fe1d9c",
            "source:724d9304540efbd0099ad24b",
            "source:75e784da821b9fa81bcba998"
          ],
          "text": "This captive Magtheridon rails against Illidan as an arrogant fool and vows to crush him and reclaim Outland. He challenges the sorcery holding him and calls those taking his blood vermin, leeches and parasites. Possessive of his blood, he threatens that it will be their end. He demands release and offers only the possibility of a merciful death in return.",
          "when": {
            "entry": 21174
          }
        }
      ],
      "title": ""
