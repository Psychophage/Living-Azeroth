    {
      "entry": 17381,
      "name": "The Maker",
      "records": [
        {
          "authored": false,
          "id": "npc:17381:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:da18009c606b14ce0348e55e",
            "source:8ff0c604937111889ad52054",
            "source:66c3857c2ac7192f97b683eb",
            "source:b2f4fafd2d5d9ebbe19dbe89",
            "source:aebf908210f76839fa7f42d0",
            "source:32e46094532a916756147d64",
            "source:8c8629e7ee19c10e61fb7179"
          ],
          "text": "The Maker is a demon absorbed in work he insists must not be interrupted. He regards intruders as potential material for his purposes, treating anger and hate as tools he can use. He challenges their resistance and threatens to see what he can make of them, revealing a coercive, instrumental attitude without explaining the full nature of his work.",
          "when": {
            "entry": 17381
          }
        }
      ],
      "title": null
    },
