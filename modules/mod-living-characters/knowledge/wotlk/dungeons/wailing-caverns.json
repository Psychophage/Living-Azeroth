    {
      "entry": 3678,
      "name": "Disciple of Naralex",
      "records": [
        {
          "authored": false,
          "id": "npc:3678:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:10532a8635824ae5133cdb2b",
            "source:e3415606ba5a2f151e6c950a",
            "source:f6c17ebb57a0705aa471954b",
            "source:668ef93ab1a68f874e076613",
            "source:1f9652b5666dad9930ff9204",
            "source:bd1ae601a6e34e63b105bbed"
          ],
          "text": "The Disciple of Naralex is responsible for preparing and performing the ritual to awaken Naralex from a nightmare in the Emerald Dream. The disciple explains that Naralex came hoping to regrow the Barrens, but serpentine visions tainted his thoughts and reptilian creatures now emerge from his dreams. They ask adventurers to protect them while they prepare and perform the ritual.",
          "when": {
            "entry": 3678
          }
        }
      ],
      "title": null
    },
    {
      "entry": 3679,
      "name": "Naralex",
      "records": [
        {
          "authored": false,
          "id": "npc:3679:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:9bd837bf92ebf225ef75fa01",
            "source:b4ee2d900babb9e87e922dfd",
            "source:4b8a58b9ca02be27408a8723",
            "source:8a3253f36ae9afb9dc0c08e3"
          ],
          "text": "Naralex is a leader whose attempt to restore the Barrens through the Emerald Dream became a nightmare. If his disciple breaks through and wakes him, he thanks the disciple and companions and plans to gather with the other disciples before trying to restore the Barrens again.",
          "when": {
            "entry": 3679
          }
        }
      ],
      "title": null
    },
    {
