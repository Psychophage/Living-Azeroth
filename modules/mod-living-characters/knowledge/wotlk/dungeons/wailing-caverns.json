    {
      "entry": 3669,
      "name": "Lord Cobrahn",
      "records": [
        {
          "authored": false,
          "id": "npc:3669:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:fa3da7ba7708d5af5c7abca1",
            "source:3195ac22b64c20e7d8f0d421",
            "source:1080d492e374b299e209bec7"
          ],
          "text": "Lord Cobrahn is a Fanglord who warns challengers that they will never wake the dreamer, placing him against those who seek to rouse the dreamer.",
          "when": {
            "entry": 3669
          }
        }
      ],
      "title": "Fanglord"
    },
    {
      "entry": 3670,
      "name": "Lord Pythas",
      "records": [
        {
          "authored": false,
          "id": "npc:3670:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a0cdf4dd4de70f9d3f930e09",
            "source:0b4b2e6d8229d13d6bcac6b2",
            "source:6b5ad6bd9c7cc95b533ad9f8",
            "source:83ff4ed5efd269b5a2fda606"
          ],
          "text": "Lord Pythas is a Fanglord who threatens challengers with the coils of death and fights with Lightning Bolt.",
          "when": {
            "entry": 3670
          }
        }
      ],
      "title": "Fanglord"
    },
    {
      "entry": 3671,
      "name": "Lady Anacondra",
      "records": [
        {
          "authored": false,
          "id": "npc:3671:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:839dc751c447ac243747f6db",
            "source:1a61ef475710396c466e4b42",
            "source:9cef312e64612a2024505981",
            "source:345da1c77aee05374be83e77",
            "source:61b152d7f5a419ab4956b3ab"
          ],
          "text": "Lady Anacondra is a Fanglord who declares that none can stand against the Serpent Lords. She uses Lightning Bolt.",
