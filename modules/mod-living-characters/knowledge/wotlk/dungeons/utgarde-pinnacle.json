    {
      "entry": 26687,
      "name": "Gortok Palehoof",
      "records": [
        {
          "authored": false,
          "id": "npc:26687:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:eb9a0c582db677274823c4cc",
