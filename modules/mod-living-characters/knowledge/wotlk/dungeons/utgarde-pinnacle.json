      "title": ""
    },
    {
      "entry": 26693,
      "name": "Skadi the Ruthless",
      "records": [
        {
          "authored": false,
          "id": "npc:26693:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0dff6ddc0704cb8833ffa62e",
            "source:0f696c6b25aa5334aa850887",
            "source:998a8b33bc968113c2cbd131",
            "source:8d78252cce30af9cf6b11f3b",
            "source:58a79512ace90ec629f141e5"
          ],
          "text": "Skadi the Ruthless rallies his brothers against intruders, promising a feast to whoever brings him their heads. He calls the halls sacred and threatens to feed the intruders' corpses to his new drake, then taunts fallen foes.",
          "when": {
            "entry": 26693
          }
        }
      ],
      "title": ""
    },
    {
