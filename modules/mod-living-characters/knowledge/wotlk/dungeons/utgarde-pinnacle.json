  "place": "Utgarde Pinnacle",
  "place_records": [
    {
      "authored": false,
      "id": "zone:1196",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:1196",
        "dbc:area:495",
        "world:creature:26861",
        "world:creature:26693",
        "world:creature:26687",
        "world:creature:26536",
        "world:creature:26696",
        "world:quest:13132"
      ],
      "text": "You are in Utgarde Pinnacle, a fortress in the Howling Fjord. King Ymiron rules it as his home and calls on a death god there. Skadi the Ruthless and Gortok Palehoof also hold sway within it, and Ymirjar warriors share its halls with mindless servants. Cursed gold lies inside, and it has turned a treasure hunter's crewmates into lifeless servants.",
      "when": {
        "zone_id": 1196
      }
    }
  ],
