    {
      "entry": 26861,
      "name": "King Ymiron",
      "records": [
        {
          "authored": false,
          "id": "npc:26861:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0c20ab03a552acbaf3d7154e",
            "source:65f5b56edc0a4aea6f8d5118",
            "source:c6074b29d96db6854aaa6afb",
            "source:417be085afa96817d3d5f4c4",
            "source:bab85ae71fade4d95ce2a1e1"
          ],
          "text": "King Ymiron rules Utgarde Pinnacle, which he calls his home. He invokes a death god and threatens intruders with an offering of their hearts, asserting that his kingship has a reason. Brigg identifies the king as the one in charge amid the gold-seeking adventurers turned into mindless servants.",
          "when": {
            "entry": 26861
          }
        }
      ],
      "title": ""
    },
