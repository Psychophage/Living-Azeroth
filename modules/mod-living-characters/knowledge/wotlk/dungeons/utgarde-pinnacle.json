    {
      "entry": 30871,
      "name": "Brigg Smallshanks",
      "records": [
        {
          "authored": false,
          "id": "npc:30871:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7d6e397b370d53456b8e2620",
            "source:dec1e8c4023f32db698314a9",
            "source:be40411a6d716f745204788e",
            "source:610ef4be892103f82fa80586"
          ],
          "text": "Brigg Smallshanks is a stranded treasure hunter whose crewmates were turned into mindless undead after rushing at cursed gold. He escaped the same fate after being knocked down while tipsy. He worries about facing his captain empty-handed and mourns his mates, but still sees more treasure ahead and sends adventurers after it.",
          "when": {
            "entry": 30871
          }
        }
      ],
      "title": ""
    }
