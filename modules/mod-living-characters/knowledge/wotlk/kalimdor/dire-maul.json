      "entry": 11440,
      "name": "Gordok Enforcer",
      "records": [
        {
          "authored": false,
          "id": "npc:11440:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:585d98124b0034f5d46ffa63",
            "source:233a71cb88df7437483c8f1f",
            "source:17391da347d16c24f862650f",
            "source:97ed4d0bf5504a884d55346d",
            "source:7cba2eb1b8a29b3c4657fc29",
            "source:280e5b4976d44633c3ce5599"
          ],
          "text": "A Gordok Enforcer is an ogre combatant whose barks threaten to crush or smash opponents. One line says he feels unwell; another promises to smash the target. In combat, he can cast Strike.",
          "when": {
            "entry": 11440
          }
        }
      ],
      "title": null
    },
    {
