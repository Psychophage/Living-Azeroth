    {
      "entry": 15587,
      "name": "Elder Mistwalker",
      "records": [
        {
          "authored": false,
          "id": "npc:15587:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:428f7246eeca6dbaf19f3f41",
            "source:8dee36e12aa15ac354afc850",
            "source:070c78e14ed8d1b0ae0d42ca",
            "source:ce30a5c465e9231462f33a65"
          ],
          "text": "Elder Mistwalker speaks of living spirits, homage, and a token offered in return. He casts the people of this age as stars following new paths that may bring hope and strength to those who come after.",
          "when": {
            "entry": 15587
          }
        }
      ],
      "title": null
