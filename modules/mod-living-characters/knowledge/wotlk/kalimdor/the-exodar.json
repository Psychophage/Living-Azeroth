    {
      "entry": 16768,
      "name": "Nurguni",
      "records": [
        {
          "authored": false,
          "id": "npc:16768:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:860599a8caf246e2f9185933",
            "source:195619153ebea2528b9d3211",
            "source:dbf3bd20815968d535d3fcb3",
            "source:1b0b7a12084bf2ba8c5a5dcc",
            "source:7fa057c95fb9d0fc4bc06185",
            "source:14dea8c587755960b03fec06",
            "source:1ede4bf083272502c3c8f91c"
          ],
          "text": "Nurguni is a tradesman in the Exodar who handles supply requests from Blood Watch's inn. He reviews Topher's list, prepares the requested items, and arranges wagon delivery for the oversized bed pieces that cannot go by hippogryph.",
          "when": {
            "entry": 16768
          }
        }
      ],
      "title": "Tradesman"
    },
    {
      "entry": 17538,
      "name": "O'ros",
      "records": [
        {
          "authored": false,
          "id": "npc:17538:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:979d5b289d399b19d5037037",
            "source:14aa10f880667758b7ab2891"
          ],
          "text": "O'ros is a naaru in the Exodar whose voice reaches the listener as music within the mind. When Dornaa is brought before him, he thanks the player and calls the child special, crediting the player's kindness and the impression made on her.",
          "when": {
            "entry": 17538
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 17555,
      "name": "Stephanos",
      "records": [
        {
          "authored": false,
          "id": "npc:17555:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:627c71edf3e3994444ddb97f",
            "source:4067f939e788da878ff8bb8c",
            "source:a70f262bbaa5b0348b2cf6be",
            "source:d78bd1fa13960908447c42a4"
          ],
          "text": "Stephanos is a hippogryph master who offers reliable travel from near the Exodar. He explains that a rider can return to Blood Watch by hippogryph after arriving from its master, and helps carry Nurguni's supplies back to Caregiver Topher Loaal.",
          "when": {
            "entry": 17555
          }
        }
      ],
      "title": "Hippogryph Master"
    },
    {
      "entry": 17584,
      "name": "Torallius the Pack Handler",
      "records": [
        {
          "authored": false,
          "id": "npc:17584:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b62ef25fce20428026e7ab06",
            "source:3e5a62e48b93951a6256aef4",
            "source:41271e79bcbce71be4d9a48f",
            "source:fda6d073693c643b56b4afc7",
            "source:2d54fcae1f42e2c6a8e24d85"
          ],
          "text": "Torallius breeds and sells elekks outside the Exodar. He is blunt and guarded about entrusting his animals, demanding proof of dedication and friendship to his people. When presented with Exarch Menelaous's orders, he sighs and questions whether the recruit is the best the Hand of Argus can offer.",
          "when": {
            "entry": 17584
          }
        }
      ],
      "title": "Elekk Breeder"
    },
