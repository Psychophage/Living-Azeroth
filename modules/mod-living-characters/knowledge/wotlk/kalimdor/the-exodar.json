    {
      "entry": 19171,
      "name": "Draenei Commoner",
      "records": [
        {
          "authored": false,
          "id": "npc:19171:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8243e0907995a242cabc7752",
            "source:0ad21d39e34b9069c9aaa2dc",
            "source:1f0a51e61262cbfd69d74474",
            "source:77275a3288c8528ca9ddb289",
            "source:fba338782833f1ee07f2d762"
          ],
          "text": "This draenei commoner reflects on elders and holiday customs, and shares in Alliance celebrations. During Midsummer, the commoner enjoys the summer festivities and fireworks.",
          "when": {
            "entry": 19171
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 20604,
      "name": "Dugiru",
      "records": [
        {
          "authored": false,
          "id": "npc:20604:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:506bf7ef6d92a76102de6d12",
            "source:e04722fee3c57e50a43d0408",
            "source:bd2f2b1a0ad81c84130ffa11",
            "source:538242fbaf29935101afae3b",
            "source:d1208b8532dcb0cbd022c06a"
          ],
          "text": "Dugiru serves as the Alliance cloth quartermaster in the Exodar, organizing donations to replenish its dwindling textile supplies. He invites cloth contributions to strengthen draenei standing locally and says he will personally see future runecloth gifts recognized.",
          "when": {
            "entry": 20604
          }
        }
      ],
      "title": "Alliance Cloth Quartermaster"
    },
    {
      "entry": 20722,
      "name": "Herald Bran'daan",
      "records": [
        {
          "authored": false,
          "id": "npc:20722:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:dc57fc5227cf841940f759f7",
            "source:dace7673d7276246e87ecb18",
            "source:1bd0a4d8f052eff84850c2f7"
          ],
          "text": "Herald Bran'daan is an Alliance herald who offers heroes the latest news from both continents and beyond.",
          "when": {
            "entry": 20722
          }
        }
      ],
      "title": null
    },
    {
      "entry": 20914,
      "name": "Aalun",
      "records": [
        {
          "authored": false,
          "id": "npc:20914:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:bb5ed49f69beb95401962201",
            "source:37ae7d9612fd38011ad1f200",
            "source:65d968c627b0606de62fedc9",
            "source:66fbe21df1ab4158a454c599",
            "source:0a3356d5117419d41cddc2a2"
          ],
          "text": "Aalun is a riding trainer associated with the Exodar who promotes riding lessons and mount purchases. He praises the draenei's beasts and brings up the cost of training. In one recorded line, he insists that a rider be exalted in the eyes of the draenei before he will train them.",
          "when": {
            "entry": 20914
          }
        }
      ],
      "title": "Riding Trainer"
    },
    {
      "entry": 22101,
      "name": "Arena Promoter",
      "records": [
        {
          "authored": false,
          "id": "npc:22101:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d7b632e841691652130cd64e",
