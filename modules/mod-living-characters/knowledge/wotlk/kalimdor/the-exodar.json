          }
        }
      ],
      "title": ""
    },
    {
      "entry": 23039,
      "name": "Draenei Reveler",
      "records": [
        {
          "authored": false,
          "id": "npc:23039:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:74e35770b7791b61c98b9cb3",
            "source:0feceabb6967a436ae21b2a1",
            "source:dde0278aafcd4c38775e068f"
          ],
          "text": "The Draenei Revelers are event celebrants whose idle behavior varies among several emotes, giving the gathering an expressive, animated character.",
          "when": {
            "entry": 23039
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 23528,
      "name": "Azuremyst Pink Elekk",
      "records": [
        {
          "authored": false,
          "id": "npc:23528:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d12a878702e0408a2b0e4eb3",
            "source:593e43bde7b783d210097eba",
            "source:e457348f02286505af7139de",
            "source:ea5392e1c219450769e1ac05"
          ],
          "text": "This pink elekk is one of the Brewfest targets at the Exodar beer garden. Goldark's instructions describe these elekks as visible to those who are drunk or wearing Synthebrew Goggles, while ordinary weapons pass through them.",
          "when": {
            "entry": 23528
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 29442,
      "name": "Lieutenant Kregor",
      "records": [
        {
          "authored": false,
          "id": "npc:29442:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:848f354bc2628d0899db727f",
            "source:04d40b4d65df3d215bc69f1d",
            "source:c00b71338a3c03a7d28ec3d6",
            "source:04027e381b82262e2c8520e7",
            "source:9c79f2e3a19a12091e442f74",
            "source:dc7996b4c4bddbeb3112d2f5"
          ],
          "text": "Lieutenant Kregor serves the Argent Dawn in the defense of the Exodar, urgently calling for the Scourge to be opposed and the nearby glowing runic circles investigated. He considers the circles linked to the undead; his response to a report identifies them as a means of communication and expresses the Argent Dawn's appreciation for the service.",
          "when": {
            "entry": 29442
          }
        }
      ],
      "title": "The Argent Dawn"
    },
    {
      "entry": 34783,
      "name": "Ranisa Whitebough",
      "records": [
        {
          "authored": false,
          "id": "npc:34783:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:279f29cce0d83d537b901a21",
            "source:da6bbb40f6016a8be5ff12c7",
            "source:8c8ce10259c52c24cd29c365"
          ],
          "text": "Ranisa Whitebough serves as a Pilgrim's Bounty vendor, offering visitors the chance to browse her goods.",
          "when": {
            "entry": 34783
          }
        }
      ],
      "title": "Pilgrim's Bounty Vendor"
    },
    {
      "entry": 34785,
      "name": "Alnar Whitebough",
      "records": [
        {
          "authored": false,
          "id": "npc:34785:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a0e59f255bd7e0016cbd4520",
            "source:9debf47b2c6e468235003b2b",
            "source:6d23dff2afcdd9b64bb67735",
            "source:d4076fa71d8c6969725bae2d"
          ],
          "text": "Alnar Whitebough is a cooking trainer. He welcomes prospective students and says Pilgrim's Bounty usually brings him many new learners.",
          "when": {
            "entry": 34785
          }
        }
      ],
      "title": "Cooking Trainer"
    },
    {
      "entry": 38040,
      "name": "Kwee Q. Peddlefeet",
      "records": [
        {
          "authored": false,
          "id": "npc:38040:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:5b414ca89d92258bbcb6ad2d",
            "source:70a893454e1a9f12ec0f8c8e"
          ],
          "text": "Kwee Q. Peddlefeet is an official Crown event mascot for the Crown Chemical Co. He describes the “Charitable Charms” program, in which mascots distribute Lovely Charm Collector's Kits. He explains that Lovely Charms can become bracelets for friends and loved ones, or for leaders as a gesture of appreciation.",
          "when": {
            "entry": 38040
          }
        }
      ],
      "title": "Crown Chemical Co."
    }
  ],
