    {
      "entry": 16729,
      "name": "Refik",
      "records": [
        {
          "authored": false,
          "id": "npc:16729:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a532a8bc992e0c5aec5bf904",
            "source:3f5cf02b8b939ccaa9159709",
            "source:13709130e5a496dc96b19c36",
            "source:9aa54b5a6408fd7bdcc5355e"
          ],
          "text": "Refik teaches tailoring and acknowledges when a learner has reached the limits of Refik’s knowledge. For further instruction, Refik recommends Georgio Bolero, praising him as a great tailor across the sea in Stormwind’s Mage Quarter.",
          "when": {
            "entry": 16729
          }
        }
      ],
      "title": "Tailoring Trainer"
    },
