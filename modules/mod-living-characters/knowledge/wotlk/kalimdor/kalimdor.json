  "npcs": [
    {
      "entry": 2951,
      "name": "Palemane Poacher",
      "records": [
        {
          "authored": false,
          "id": "npc:2951:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:2182ff0e5357c6a8744b67e2",
            "source:048e04fd485f480bd40c741a",
            "source:27ce8e7c2d578c5f5a4d8056",
            "source:57fd20a2c9c4467a69accd4e"
          ],
          "text": "A Palemane gnoll poacher in Mulgore, she is part of the threat to local wildlife that has driven the tauren to abandon attempts at peaceful communication. Her combat taunts about fresh meat and bones give her a predatory, hostile edge.",
          "when": {
            "entry": 2951
          }
        }
      ],
      "title": null
    },
    {
      "entry": 9117,
      "name": "J.D. Collie",
      "records": [
        {
          "authored": false,
          "id": "npc:9117:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:616f461a54e80a46a41eb74e",
            "source:7b2b30494abf83fa621e1a13",
            "source:4ac35d499f636de916642d30",
            "source:d5daa383d6a8a7fa18dda009",
            "source:98599173e9ce5402cdfbd985",
            "source:888547c393494c25707f33a5",
            "source:5283013b64a52d9560594ec1",
            "source:7864b3d392026ede00f47194"
          ],
          "text": "J.D. Collie makes her home in a cave in Un'Goro Crater, where she studies the strange crystals scattered across the region. Curious about rumors of the crystal pylons and convinced they are connected to the crystals, she asks visitors to locate them and continues experimenting with what she finds. Her experiments often fail, but she treats each attempt as practice and expects the next to work. She knows of Blazerunner in the crater's charred center and warns that his powerful aura has driven challengers from the rocky paths.",
          "when": {
            "entry": 9117
          }
        }
      ],
      "title": null
    },
    {
      "entry": 11918,
      "name": "Gogger Stonepounder",
      "records": [
        {
          "authored": false,
          "id": "npc:11918:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3cd9526f4b67f52bc46c37b8",
            "source:299f175cf573e36b019d2492",
            "source:858cd6da92e6979b2ad95e4b"
          ],
          "text": "Gogger Stonepounder guards a candle, warning others not to take it. His brief, fearful cries plead for his life and announce that he is running away.",
          "when": {
            "entry": 11918
          }
        }
      ],
      "title": null
    }
  ],
