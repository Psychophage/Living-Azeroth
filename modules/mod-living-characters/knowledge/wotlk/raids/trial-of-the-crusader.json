    {
      "entry": 34990,
      "name": "King Varian Wrynn",
      "records": [
        {
          "authored": false,
          "id": "npc:34990:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:170ed20e3305595bcd9e849e",
            "source:8206e04ea3947a4f5f7f52b5",
            "source:242b71d40f60c6c4bb3b0257",
            "source:9a9c547ae35922df17dc74b7",
            "source:2decad36caf86b60fd117143"
          ],
          "text": "King Varian Wrynn, king of Stormwind, answers accusations against the Alliance at the Argent Tournament by demanding justice and putting his champions forward against the Horde. He urges Alliance heroes to fight for their people and celebrates their victory. His taunts toward Horde opponents show the depth of his hostility in this factional rivalry.",
          "when": {
            "entry": 34990
          }
        }
      ],
      "title": "King of Stormwind"
    },
    {
      "entry": 34992,
      "name": "Lady Jaina Proudmoore",
      "records": [
        {
          "authored": false,
          "id": "npc:34992:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:fa798f3a81eb3b05fe29867b",
            "source:5c41534f5362bb3da218d29a"
          ],
          "text": "Jaina Proudmoore is identified as ruler of Theramore and appears at the Argent Tournament in Northrend.",
          "when": {
            "entry": 34992
          }
        }
      ],
      "title": "Ruler of Theramore"
    },
    {
      "entry": 34994,
      "name": "Thrall",
      "records": [
        {
          "authored": false,
          "id": "npc:34994:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7f6f80a6c453c186174ba329",
            "source:e24dc87017642411fca76e3a",
            "source:5116c20a42b1d704c3cd5b86",
            "source:a0bc051b52d9ff302fabb9fa",
            "source:7add1fd6103662fee881ebab"
          ],
          "text": "Warchief Thrall encourages the Horde fighters at the Argent Tournament and praises them after a contest. When Garrosh continues, Thrall cuts in with “Garrosh, enough,” showing that he is willing to restrain his fellow leader in this gathering.",
          "when": {
            "entry": 34994
          }
        }
      ],
      "title": "Warchief"
    },
    {
      "entry": 34995,
      "name": "Garrosh Hellscream",
      "records": [
        {
          "authored": false,
          "id": "npc:34995:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b2ff8f6e74fef4e043f4e107",
            "source:2906869fe9315390f06d5a5d",
            "source:f4a0fc4332b9ec25720c5d74",
            "source:2f89bcc738ec7264a42be2f9",
            "source:8f851ebbf1fa8599e4145db5",
            "source:4336b900e05aef996c63648d"
          ],
          "text": "Garrosh Hellscream, Overlord of the Warsong Offensive, demands justice for the Horde at the Argent Tournament and presents its champions as an answer to an insult. He insults Alliance opponents, dismisses challenges, and celebrates a Horde victory as a taste of what the future holds. His remarks reveal a combative, triumphalist stance in the factional rivalry.",
          "when": {
            "entry": 34995
          }
        }
      ],
      "title": "Overlord of the Warsong Offensive"
    },
    {
      "entry": 34996,
      "name": "Highlord Tirion Fordring",
      "records": [
        {
          "authored": false,
          "id": "npc:34996:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:454eaa7bfc27e9febc5d9acd",
            "source:35db36a3f942e9498e1cfdf8",
            "source:68c21d5b093ac15d857bef2a",
            "source:6532429198d95780dab14896",
            "source:38c3bb719e08655e63adb6cd",
            "source:a2dc63e2ea204b5984e3a122"
          ],
          "text": "Highlord Tirion Fordring speaks for the Argent Crusade at the Crusaders' Coliseum, welcoming champions who answered its call and presenting their trials as preparation for the march on Icecrown Citadel. He announces the beasts, urges the fighters onward, mourns fallen heroes, and congratulates the champions who triumph; rewards he hands out are meant to aid the campaign against Arthas.",
          "when": {
            "entry": 34996
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "Trial of the Crusader",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4722",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4722",
        "dbc:area:4658",
        "world:creature:34996",
        "dbc:encounter:629",
        "dbc:encounter:633",
        "dbc:encounter:641",
        "dbc:encounter:645",
        "world:quest:24589"
      ],
      "text": "You are in the Trial of the Crusader, a coliseum in the Argent Tournament Grounds in Icecrown. The Argent Crusade gathers champions here for trials in preparation for the march on Icecrown Citadel. Its masters include the Northrend Beasts, Lord Jaraxxus, the Val'kyr Twins and Anub'arak. Lord Jaraxxus, an Eredar lord of the Burning Legion, is summoned into the middle of the arena, and should he escape he will open a portal for the Legion.",
      "when": {
        "zone_id": 4722
      }
    }
  ],
