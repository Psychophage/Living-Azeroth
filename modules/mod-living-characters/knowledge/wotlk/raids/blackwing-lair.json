    {
      "entry": 12017,
      "name": "Broodlord Lashlayer",
      "records": [
        {
          "authored": false,
          "id": "npc:12017:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b2ae57160aace14dac9bca78",
            "source:78c502451477f47afbb41a17",
            "source:b297db3e3bf8eebe56c4f0e8",
            "source:1abe188115e06b6815ed42a6",
            "source:37c8b1a264290035227e00a9"
          ],
          "text": "Broodlord Lashlayer guards the Halls of Strife, barring the way toward Nefarian’s inner sanctum. When intruders try to lure him from his sanctum, he rebukes their attempt; he also warns that they have doomed themselves by entering. Baristolth seeks his head as part of a champion’s larger journey.",
          "when": {
            "entry": 12017
          }
        }
      ],
      "title": null
    },
    {
      "entry": 12435,
