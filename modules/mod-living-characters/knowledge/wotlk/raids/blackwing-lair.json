    {
      "entry": 13020,
      "name": "Vaelastrasz the Corrupt",
      "records": [
        {
          "authored": false,
          "id": "npc:13020:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:307197cf7898ce54023382c7",
            "source:c8c814f75b6d4c0fb7f430c8",
            "source:8f8d3b44b909e43816b1f7ee",
            "source:47087d8df3d5a554d5998263",
            "source:3f7ca7c186c774eb402c88dc",
            "source:5fac3797c0d31ea5a0d5ff79",
            "source:44023bdfc6914290f5eb7493",
            "source:0358fb785c6b83b5cd9f04b3"
          ],
          "text": "Vaelastrasz is a mortally weakened red dragon fighting Nefarius's corruption at Blackwing Lair. He warns mortals to flee as he loses control, then struggles against the destructive force within him and grieves when he kills. He says Nefarius holds the Red Scepter Shard and plans to destroy it, and urges its recovery for Anachronos. In a later exchange, he pleads to be killed after the Lord of Blackrock has consumed his energy.",
          "when": {
            "entry": 13020
          }
        }
      ],
      "title": null
    },
