{
  "era": "wotlk",
  "format": "living-azeroth-npc-summaries",
  "map": 565,
  "npcs": [
    {
      "entry": 18831,
      "name": "High King Maulgar",
      "records": [
        {
          "authored": false,
          "id": "npc:18831:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:69d38b640185cd6fe0296837",
            "source:5eabe36623de1fbd2895415e",
            "source:856cf33f9cf3a341548da05d",
            "source:512c7922dc0dab2ca7518037",
            "source:92f09a6f05cdc520944cbcf1",
            "source:55a73a6c46ff856dc78fda97",
            "source:987a8affddc0a79b23882105"
          ],
          "text": "High King Maulgar, Lord of the Ogres, calls himself Gruul’s hand and insists that gronn hold the real power in Outland. When another ogre falls, he dismisses the setback and boasts that the next foe will not be as easy to kill. He faces challengers defiantly, warning that Gruul will crush them.",
          "when": {
            "entry": 18831
          }
        }
      ],
      "title": "Lord of the Ogres"
    },
    {
      "entry": 19044,
      "name": "Gruul the Dragonkiller",
      "records": [
        {
          "authored": false,
          "id": "npc:19044:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0ff5300424b5c25fa9b5d7a1",
            "source:b6e50e8202a9e07bbd4fb53f",
            "source:54940d03b727a5a5a276108c",
            "source:3eebab9ba50bf7ac1076430e",
            "source:452ed8c5287c2547746a86b7",
            "source:b86031cef3d5e093246d197e",
            "source:b65bee9d05edb0585a4a8554"
          ],
          "text": "Gruul the Dragonkiller is a gronn in the Blade’s Edge Mountains. He and his seven sons favor the powerful Bladespire ogres; Gorr’Dim has made his clan Gruul’s favorite. Skar’this identifies Gruul as the holder of the Earthen Signet needed for the Cudgel of Kar’desh. Gruul confronts challengers with curt threats, denies them escape and commands them to beg for life.",
          "when": {
            "entry": 19044
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 19389,
      "name": "Lair Brute",
      "records": [
        {
          "authored": false,
          "id": "npc:19389:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:65d01d0c11926d67b9ad2630",
            "source:d9245fd2e405505d7c91ff43",
            "source:31da5fa21d9cd1dbac615b12"
          ],
          "text": "The Lair Brute is a combatant that uses Mortal Strike.",
          "when": {
            "entry": 19389
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 21350,
      "name": "Gronn-Priest",
      "records": [
        {
          "authored": false,
          "id": "npc:21350:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:975d0f9134032d085e0cb71f",
            "source:bdb7aa08b14857f6c113fef7",
            "source:43de45985c8eea78b080521c"
          ],
          "text": "The Gronn-Priest is a combatant that uses Psychic Scream.",
          "when": {
            "entry": 21350
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "Gruul's Lair",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3923",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3923",
        "dbc:area:3866",
        "dbc:area:3522",
        "world:creature:18831",
        "world:creature:19044",
        "world:creature:19389",
        "world:creature:21350"
      ],
      "text": "You are in Gruul's Lair, a lair in the Blade's Edge Mountains, reached through Skald. Ogres and gronn rule it under High King Maulgar, Lord of the Ogres, who insists that gronn hold the real power in Outland, and under Gruul the Dragonkiller, a gronn whose seven sons favor the Bladespire ogres. Lair Brutes and gronn priests fill its halls, along with other named creatures.",
      "when": {
        "zone_id": 3923
      }
    }
  ],
