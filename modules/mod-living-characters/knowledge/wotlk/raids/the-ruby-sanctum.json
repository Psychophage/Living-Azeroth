  "map": 724,
  "npcs": [
    {
      "entry": 39746,
      "name": "General Zarithrian",
      "records": [
        {
          "authored": false,
          "id": "npc:39746:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c7c653f53086da58034e7036",
            "source:514d82c5f49180dcbcb35eed",
            "source:8825bb814d8f488f9319a6dd",
            "source:ea7b68c629e1f809618a2841"
          ],
          "text": "General Zarithrian is a named commander in the Ruby Sanctum assault. He orders his minions to burn his opponents and calls out to Halion, presenting himself as a forceful leader in the attack.",
          "when": {
            "entry": 39746
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 39747,
      "name": "Saviana Ragefire",
      "records": [
        {
          "authored": false,
          "id": "npc:39747:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c3ffb16524a2f94f81ca4063",
            "source:aa7a14f2d5640273e06d7711",
            "source:d42a56ac28575fd8bced3a2b",
            "source:716a120360ae07a00e0be65f",
            "source:f4924d53acb6d314a67bc33f"
          ],
          "text": "Saviana Ragefire is a named combatant in the Ruby Sanctum assault who threatens intruders and commands them to burn in her master's flame. She expects Halion's approval, saying he will be pleased, and serves his cause.",
          "when": {
            "entry": 39747
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 39751,
      "name": "Baltharus the Warborn",
      "records": [
        {
          "authored": false,
          "id": "npc:39751:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6975bd60577e912f3f0300d5",
            "source:23fe077d88d1ec4adaa8f098",
            "source:3b04be234b7de1505c5a62ce",
            "source:c5c16195dea585985e3c1ab9",
            "source:ca4bad3bbd4082d520b8ca81",
            "source:e1759e55862a75594c3541fa"
          ],
          "text": "Baltharus the Warborn greets arriving heroes as entertainment and boasts that he leaves no survivors. He dismisses heroes as a nuisance and taunts an ancient foe that the foe will soon join its friends.",
          "when": {
            "entry": 39751
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 39863,
      "name": "Halion",
      "records": [
        {
          "authored": false,
          "id": "npc:39863:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:26cfa6c8acaf0b4855d3f914",
            "source:593dc3149868604d11d01858",
            "source:3f623410740d9294241ef06b",
            "source:13c48a18ca874c35b3d2bd5f",
            "source:9821c7d330b6e5f6d30c70f1",
            "source:a682c145f7152070bb46bd2f"
          ],
          "text": "Halion, the Twilight Destroyer, declares that the Ruby Sanctum is lost and threatens a new age of destruction. He invites mortals into the realm of twilight with open contempt, framing the assault as a prelude to his master's return.",
          "when": {
            "entry": 39863
          }
        }
      ],
      "title": "The Twilight Destroyer"
    },
    {
      "entry": 40417,
      "name": "Charscale Invoker",
      "records": [
        {
          "authored": false,
          "id": "npc:40417:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ade6a37e0a87ce47fd52087c",
            "source:08be800f67352e9ad90a34b2",
            "source:0e682e668946032a5eedb632"
          ],
          "text": "Charscale Invokers are dragonkin spellcasters in the Ruby Sanctum who scorch their foes.",
          "when": {
            "entry": 40417
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 40419,
      "name": "Charscale Assaulter",
      "records": [
        {
          "authored": false,
          "id": "npc:40419:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ecd9151034d6caa7996ba82e",
            "source:2487829ea68ce1194de883f2",
            "source:3e6ceea9773616c44a64a273"
          ],
          "text": "Charscale Assaulters are dragonkin fighters who send shockwaves through their foes.",
          "when": {
            "entry": 40419
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 40421,
      "name": "Charscale Elite",
      "records": [
        {
          "authored": false,
          "id": "npc:40421:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:2cca29148e0d46eb9a70a692",
            "source:749942899608af2133d1726c"
          ],
          "text": "A dragonkin fighter of the Charscale force in the Ruby Sanctum, of higher standing than its ordinary soldiers.",
          "when": {
            "entry": 40421
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 40423,
      "name": "Charscale Commander",
      "records": [
        {
          "authored": false,
          "id": "npc:40423:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:1e20890e61f2ada2cf1d603d",
            "source:e15df1f474ed38edcde46faa",
            "source:adea2a1eea07db968be1fdfd",
            "source:3e39a20623c87a2a9fa0a5f2"
          ],
          "text": "Charscale Commanders rally fellow combatants during battle with a roar and Rallying Shout, giving them a coordinating role within the dragonkin force.",
          "when": {
            "entry": 40423
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 40429,
      "name": "Sanctum Guardian Xerestrasza",
      "records": [
        {
          "authored": false,
          "id": "npc:40429:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:18bf6438cb07ae41f1fed475",
            "source:352eeb881e25b72378ad9b72",
            "source:51dd72108d7e55ebcd4580dc",
            "source:8bf880b88f57200f45003a32",
            "source:ffb8ddcbe5161cbe7b494bb8",
            "source:634b35b7120787498cef4f7a"
          ],
          "text": "Sanctum Guardian Xerestrasza is a Ruby Sanctum guardian who survived the assault on the sanctuary. After her fellow guardians were slain, she retreated to the entrance and barred it. She says the attackers appeared suddenly as Black dragonkin, overwhelming the defenders, and identifies Zarithrian as the ground commander while warning that greater powers may be involved. Her knowledge of the enemy's plans is limited.",
          "when": {
            "entry": 40429
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "The Ruby Sanctum",
  "place_records": [
    {
      "authored": false,
      "id": "zone:4987",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:4987",
        "dbc:area:4161",
        "world:creature:39863",
        "world:creature:39746",
        "world:creature:40417",
        "world:creature:40626",
        "world:creature:40429",
        "world:quest:26034"
      ],
      "text": "You are in The Ruby Sanctum, the home of the Red Dragonflight beneath Wyrmrest Temple in Dragonblight. Halion, the Twilight Destroyer, leads the forces that have taken it, and General Zarithrian oversees the assault. Charscale invokers, Ruby drakes and drakonids fill its halls, and the Sanctum Guardian Xerestrasza survived and barred the entrance.",
      "when": {
        "zone_id": 4987
      }
    }
  ],
