{
  "era": "wotlk",
  "format": "living-azeroth-npc-summaries",
  "map": 615,
  "npcs": [
    {
      "entry": 28860,
      "name": "Sartharion",
      "records": [
        {
          "authored": false,
          "id": "npc:28860:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e979cc6e36f1e1a33d75ebdd",
            "source:c79baf9f14aed9dc4185d3b6",
            "source:6b776aa62abdf2ccb5b2f2c1",
            "source:39cbb87ca79273ad69421310",
            "source:89b3d990829f9bb38e159e16"
          ],
          "text": "Sartharion is the Onyx Guardian, charged with guarding the Twilight Dragonflight eggs in the Obsidian Sanctum. When they are threatened, he calls Shadron, Tenebron and Vesperon to help protect the clutch; his own words frame attackers as a threat to his charge.",
          "when": {
            "entry": 28860
          }
        }
      ],
      "title": "The Onyx Guardian"
    },
    {
      "entry": 30449,
      "name": "Vesperon",
      "records": [
        {
          "authored": false,
          "id": "npc:30449:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:89b3d990829f9bb38e159e16",
            "source:8274815d205092e9d79ff0c1",
            "source:12325417ac734b697df57db8",
            "source:7dc691d7dd47096d0085fb8f"
          ],
          "text": "Vesperon is a powerful ally Sartharion calls to help defend the clutch. He openly disparages Sartharion as a weakling, and meets intruders with contempt, boasting that he has tricks of his own when they surprise him.",
          "when": {
            "entry": 30449
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30451,
      "name": "Shadron",
      "records": [
        {
          "authored": false,
          "id": "npc:30451:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:6b776aa62abdf2ccb5b2f2c1",
            "source:bb82841cbc94a7e51797a277",
            "source:b7ec52c13dbf755986bff0bd",
            "source:a5fc429a3f44ee24a2e08db4",
            "source:9691cae4ad577220ecb306ad"
          ],
          "text": "Shadron is an ally Sartharion summons to help defend the clutch. Fearless and contemptuous of intruders, he boasts that Father taught him well and insists that he and his kind are superior, even as he faces defeat.",
          "when": {
            "entry": 30451
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30452,
      "name": "Tenebron",
      "records": [
        {
          "authored": false,
          "id": "npc:30452:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:39cbb87ca79273ad69421310",
            "source:89b3d990829f9bb38e159e16",
            "source:3677be2b7335053523df2f06",
            "source:f8f86327b3a0e31a5dbf9224",
            "source:5c383b1c8e8034e6b041c827",
            "source:53c65592f15bf889c65da250"
          ],
          "text": "Tenebron is called by Sartharion to protect the eggs. Tenebron threatens intruders, mocks their struggle, and claims to have been holding back when defeated.",
          "when": {
            "entry": 30452
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30453,
      "name": "Onyx Sanctum Guardian",
      "records": [
        {
          "authored": false,
          "id": "npc:30453:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c5f827687130b015413f6fd9",
            "source:329f03efad1b687d691ae4d2",
            "source:bee3542f4a6f9b4193b5d753",
            "source:0806fa64921d37fb38c67292"
          ],
          "text": "Onyx Sanctum Guardians are dragonkin encountered in the Sanctum. Their group call, “Sanctum Guardians reporting in!”, presents them as an organized guardian force; they use Shockwave in combat.",
          "when": {
            "entry": 30453
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30680,
      "name": "Onyx Brood General",
      "records": [
        {
          "authored": false,
          "id": "npc:30680:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:10ef981aaf75da4312b2a7c6",
            "source:37ba57899789e82164a4211c",
            "source:8e43b142c62e139396d3f66a",
            "source:682981f93e19212190bf718a"
          ],
          "text": "The Onyx Brood General is a dragonkin of the Sanctum's brood forces. Its call, “Brood Guardians reporting in!”, ties it to that guardian group, and it uses Devotion Aura.",
          "when": {
            "entry": 30680
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30681,
      "name": "Onyx Blaze Mistress",
      "records": [
        {
          "authored": false,
          "id": "npc:30681:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:69e0ccfbcf323b20f16ca854",
            "source:5fec76c60713e5b3638280eb",
            "source:42a0cedf15d6f5ff047074f5"
          ],
          "text": "The Onyx Blaze Mistress is a dragonkin of the Onyx Sanctum. Her title marks her place among its forces, and she uses Flame Shock in combat.",
          "when": {
            "entry": 30681
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30682,
      "name": "Onyx Flight Captain",
      "records": [
        {
          "authored": false,
          "id": "npc:30682:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:ee3138379d2563038194f481",
            "source:019e2f0e1f825c52ece75453",
            "source:cb2e704b5d03f81960423c52",
            "source:093145e356234f4743be4098"
          ],
          "text": "The Onyx Flight Captain is a dragonkin captain associated with the Sanctum's flight. In combat it casts a spell on a target.",
          "when": {
            "entry": 30682
          }
        }
      ],
      "title": ""
    }
  ],
  "place": "The Obsidian Sanctum",
