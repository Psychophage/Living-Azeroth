    {
      "entry": 15229,
      "name": "Vekniss Soldier",
      "records": [
        {
          "authored": false,
          "id": "npc:15229:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f8b75f354e5ba77d2d2efdde",
