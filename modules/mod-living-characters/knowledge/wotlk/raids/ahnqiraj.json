        }
      ],
      "title": ""
    },
    {
      "entry": 15247,
      "name": "Qiraji Brainwasher",
      "records": [
        {
          "authored": false,
          "id": "npc:15247:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
