    }
  ],
  "place": "Ahn'Qiraj",
  "place_records": [
    {
      "authored": false,
      "id": "zone:3428",
      "layer": "zone",
      "priority": 40,
      "sources": [
        "dbc:area:3428",
        "dbc:area:3478",
        "world:creature:15516",
        "world:creature:15263",
        "world:creature:15275",
        "world:creature:15727",
        "world:creature:15300",
        "world:creature:15504"
      ],
      "text": "You are in Ahn'Qiraj, a Qiraji temple entered through the Gates of Ahn'Qiraj. Battleguard Sartura guards its sacred grounds under the laws of the Ancients. Its rulers include the Prophet Skeram, the Twin Emperors Vek'nilash and Vek'lor, and C'Thun, a colossal abomination whose evil legacy is said to linger even after death. Vekniss drones and guardians, Qiraji slayers and champions, and Anubisath sentinels fill it. Dragons of the Brood of Ysera are here to stop C'Thun and its worshippers.",
      "when": {
        "zone_id": 3428
      }
    }
  ],
