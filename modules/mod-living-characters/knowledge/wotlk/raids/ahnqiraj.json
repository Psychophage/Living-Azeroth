          "priority": 80,
          "sources": [
            "source:b13dc7817f29b536b3dcdc7d",
            "source:226e2c78a56a8dcc3be64cd4"
          ],
          "text": "A Royal Guard bearing Sartura's name, this creature is found in the Temple of Ahn'Qiraj.",
