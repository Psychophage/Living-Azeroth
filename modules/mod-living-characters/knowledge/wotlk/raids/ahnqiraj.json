    {
      "entry": 15311,
      "name": "Anubisath Warder",
      "records": [
        {
          "authored": false,
          "id": "npc:15311:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:4d69deed0a83557974459bb5",
            "source:ca022902d6120200196dfe8e",
            "source:782e1c9c7e5b851c3692c3b9"
          ],
          "text": "An Anubisath Warder can drop an Ancient Qiraji Artifact. The artifact begins Secrets of the Qiraji, whose instructions direct its holder to dragons near the temple entrance.",
          "when": {
