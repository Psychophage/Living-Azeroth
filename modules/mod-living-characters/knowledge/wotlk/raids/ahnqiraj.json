          "priority": 80,
          "sources": [
            "source:d6f98c18376cd94687f8ded5",
            "source:c46368a6ac3765dd1c3e48e4"
          ],
          "text": "Anubisath Defender is a guardian creature whose encounter role includes becoming enraged.",
          "when": {
            "entry": 15277
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 15299,
      "name": "Viscidus",
      "records": [
        {
          "authored": false,
          "id": "npc:15299:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e37fd7906e9f51e7862c3ee6",
            "source:0593e9046111c5f29335c0ef",
            "source:39e5a199a681efc0a6bee148",
            "source:71812f6d6e3a8990e0387bbc",
            "source:6e2bfea229334d55f0e654dd"
          ],
          "text": "Repeated frost attacks can freeze Viscidus. Further hits while it is frozen can make its body crack and shatter.",
          "when": {
            "entry": 15299
          }
        }
      ],
      "title": ""
    },
    {
