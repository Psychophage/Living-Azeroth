    {
      "entry": 25025,
      "name": "Captain Idrilae",
      "records": [
        {
          "authored": false,
          "id": "npc:25025:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3a854e38192a840ea1c89124",
            "source:04066030e3e7ffff0b593767",
            "source:25126170078c5a5f79c3c130"
          ],
          "text": "Captain Idrilae commands the Feathermoon Ferry, whose stated route runs between Feathermoon Stronghold and the Forgotten Coast while searching for people lost at sea. The captain warns that the sea can be dangerous and directs travelers needing supplies to the provisioners.",
          "when": {
            "entry": 25025
          }
        }
      ],
      "title": "Feathermoon Ferry"
