    {
      "entry": 8506,
      "name": "Eranikus the Chained",
      "records": [
        {
          "authored": false,
          "id": "npc:8506:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:3537db51462825e9c8a3f780",
            "source:6f6a00df855f88041b4c55e1",
            "source:cecfeaacdde549de22ac92a0",
            "source:badeceb7811f2b913f564530"
          ],
          "text": "Eranikus is a tormented, corrupted soul chained after failing to watch the temple. He begs mortals to release him and calls on his old friend Itharius for help, yet also threatens to rend a mortal’s soul once free. His pain and anger coexist with his plea for release.",
          "when": {
            "entry": 8506
          }
        }
      ],
      "title": null
    },
