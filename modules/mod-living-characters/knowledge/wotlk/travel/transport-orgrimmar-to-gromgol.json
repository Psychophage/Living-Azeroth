  "map": 589,
  "npcs": [
    {
      "entry": 24924,
      "name": "Sky-Captain Bomblast",
      "records": [
        {
          "authored": false,
          "id": "npc:24924:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b4da8bfd7df1f9d9537f77b0",
            "source:59ed2130ffe57201a66118d5",
            "source:1d8d4c7eae7b8c91ecfac3e8"
          ],
          "text": "Sky-Captain Bomblast says he runs the Iron Eagle and boasts that it once carried twin light cannons and enough bombs to flatten a city. He adds that its shadow could rout armies, then insists his story is true; the claims are presented as his own boast.",
          "when": {
            "entry": 24924
          }
        }
      ],
      "title": "The Iron Eagle"
    },
    {
      "entry": 24926,
      "name": "Chief Officer Brassbolt",
      "records": [
        {
          "authored": false,
          "id": "npc:24926:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f21c3121f3588a8d70b760be",
            "source:525f1deadb8c7ea71ba645e3",
            "source:c6cfa01376fe46bfe3ac866b"
          ],
          "text": "Chief Officer Brassbolt objects to the Iron Eagle being called a warbird, describing it instead as a passenger ship. Brassbolt says the job is still a job and that Captain “Bombast” will be humored while the prince is paying, revealing a practical, openly skeptical view of the captain’s grand framing.",
          "when": {
            "entry": 24926
          }
        }
      ],
      "title": "The Iron Eagle"
    },
    {
      "entry": 24927,
      "name": "Navigator Sparksizzle",
      "records": [
        {
          "authored": false,
          "id": "npc:24927:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:4d66b7339b0f13eec914eb1e",
            "source:830d3557d5b3beda9bb772b1",
            "source:6f5b72d2ccacd32affcc7a81"
          ],
          "text": "Navigator Sparksizzle is identified with the Iron Eagle. In the recorded greeting, Sparksizzle says there are things to do and suggests meeting another time, giving a brief, dismissive response to an approaching visitor.",
          "when": {
            "entry": 24927
          }
        }
      ],
      "title": "The Iron Eagle"
    },
    {
      "entry": 24929,
      "name": "Crewman Crosswire",
      "records": [
        {
          "authored": false,
          "id": "npc:24929:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:d7ae644e6bc10cc11e6f5dae",
            "source:a4d4b46e97166b5631b41c9e",
            "source:a5cc08263e348f37f2ec9d69"
          ],
          "text": "Crewman Crosswire is assigned to the Iron Eagle. Crosswire’s recorded replies say they are busy or on duty, and direct repair requests to the Vend-O-Tron D-Luxe.",
          "when": {
            "entry": 24929
          }
        }
      ],
      "title": "The Iron Eagle"
    },
