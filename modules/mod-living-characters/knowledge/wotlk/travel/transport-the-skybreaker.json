    {
      "entry": 31259,
      "name": "Absalan the Pious",
      "records": [
        {
          "authored": false,
          "id": "npc:31259:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c00989806becd9ad3f47878b",
            "source:c76008f18d8f51de6366ab9c"
          ],
          "text": "Absalan the Pious serves aboard the Skybreaker as an ambassador to the Valiance Expedition, though he says he has been ordered to remain on the gunship. He is committed to freeing the enslaved people of Ymirheim and says he promised Highlord Fordring they would be rescued alive. He thanks the player for returning Father Kamaros, whom he regards as a valuable ally of the Argent Crusade.",
          "when": {
            "entry": 31259
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 32302,
      "name": "Knight-Captain Drosche",
      "records": [
        {
          "authored": false,
          "id": "npc:32302:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7db09a8867236d10be8d21b1",
            "source:87ee2504ba214e5210845a7e"
          ],
          "text": "Knight-Captain Drosche is a named officer directing the campaign against Ymirheim. He calls the Lich King's favored vrykul the Ymirjar and urges an attack on their city as part of preparations for the assault on Icecrown Citadel. His reward line expresses certainty that the traitor king will fall.",
          "when": {
            "entry": 32302
          }
        }
      ],
      "title": ""
    },
