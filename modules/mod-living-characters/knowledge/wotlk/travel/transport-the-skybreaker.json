  "npcs": [
    {
      "entry": 29799,
      "name": "Thassarian",
      "records": [
        {
          "authored": false,
          "id": "npc:29799:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8908fea3459c269f3b5004c6",
            "source:898ba052376274dd013c6043",
            "source:c1db66a794afbdeb9151e721",
            "source:8f82e56ccee5b01bfcf9188c",
            "source:40379885284301089b6f596a"
          ],
          "text": "Thassarian serves aboard the Skybreaker in the campaign against the Lich King’s forces in Icecrown. He directs efforts to protect the army, disrupt Scourge plans, and gather intelligence on the enemy. His practical orders and dry humor show a focused commander who adapts when threats change. He also remembers the person who saved his sister’s life.",
          "when": {
            "entry": 29799
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30343,
