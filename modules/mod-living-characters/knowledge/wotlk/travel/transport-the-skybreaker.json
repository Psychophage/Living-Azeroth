    {
      "entry": 30344,
      "name": "High Captain Justin Bartlett",
      "records": [
        {
          "authored": false,
          "id": "npc:30344:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:35133a5323af9260154a4492",
            "source:5143c8553e1c31c12172caa0",
            "source:1b1c562815cceb10b62b90d4",
            "source:204751f0327971609b14f779",
            "source:fc2d39b79378ea8ce21bea27",
            "source:5423f405fdd152a2177c7cc2",
            "source:e293f9ef3db7ed54cf506f4d"
          ],
          "text": "High Captain Justin Bartlett directs Alliance efforts from the Skybreaker in Icecrown, where the forces are preparing an assault on Arthas. He treats the war against the Horde as a defense of the Light and calls for their destruction without mercy; after the defeat at the Broken Front, he vows they will pay. He also sends the player against Horde scouts and is helping secure Argent Crusade reinforcements for the coming assault.",
          "when": {
            "entry": 30344
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30345,
      "name": "Chief Engineer Boltwrench",
      "records": [
        {
          "authored": false,
          "id": "npc:30345:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:907a4cebb0dc2d412ec902cb",
            "source:9968750bf362f5cd051f4225",
            "source:c9fbf1088f8134f4b2a3a0ed",
            "source:560cb203a4dc26937af5bbbb"
          ],
          "text": "Chief Engineer Boltwrench is a gnome engineer aboard the Skybreaker, working on the frostwyrm threat and reverse-engineering a captured goblin solution. He has others field-test the sample while he studies how to reproduce it, and takes evident pride in matching goblin ingenuity. He is also pursuing the new infra-green energy and directs help to Kibli Killohertz’s reverse-engineering work.",
          "when": {
            "entry": 30345
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30346,
      "name": "Galley Chief Dolinger",
      "records": [
        {
          "authored": false,
          "id": "npc:30346:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:770e98960d7865bcce3f0f0c",
            "source:9cc8c0c2f5a652e2d3ec9e39",
            "source:bc6901efd804a188843d3dcc"
          ],
          "text": "Galley Chief Dolinger is the ship’s galley chief and food vendor, providing provisions for those aboard. The role is practical and focused on keeping the ship’s personnel supplied.",
          "when": {
            "entry": 30346
          }
        }
      ],
      "title": ""
    },
