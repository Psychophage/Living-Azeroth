    {
      "entry": 25076,
      "name": "Navigator Fairweather",
      "records": [
        {
          "authored": false,
          "id": "npc:25076:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:b38e78f362c30af6697eea58",
            "source:75c9bb757744d57b86cbb9ea"
          ],
          "text": "Navigator Fairweather serves aboard the Thundercaller. He jokes that he cannot see where he is going and may deserve blame, then suggests the captain's orders push the ship and crew to their limits. He insists he can dock the ship just fine.",
          "when": {
            "entry": 25076
          }
        }
      ],
      "title": "The Thundercaller"
    },
    {
      "entry": 25077,
      "name": "Sky-Captain Cloudkicker",
      "records": [
        {
          "authored": false,
          "id": "npc:25077:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:208f4e6857f848fe20615eea",
            "source:50f95f2a9de611e1fa9bca7f",
            "source:83c7724b32817f1ff0117bd0"
          ],
          "text": "Sky-Captain Cloudkicker welcomes visitors aboard the Thundercaller. He jokes about complaints over explosions and argues that people should be forgiven for mistakes, quipping that a captain crashing his ship 22 or 23 times would be worth mentioning.",
          "when": {
            "entry": 25077
          }
        }
      ],
      "title": "The Thundercaller"
    },
    {
