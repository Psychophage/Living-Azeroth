  "npcs": [
    {
      "entry": 25070,
      "name": "Chief Officer Coppernut",
      "records": [
        {
          "authored": false,
          "id": "npc:25070:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:7b103fa47b0d833a437b798b",
            "source:485ebb4f67d8f5e95824051f"
          ],
          "text": "Chief Officer Coppernut is an enthusiastic officer of the Thundercaller. He praises the captain and says he loves the job.",
          "when": {
            "entry": 25070
          }
        }
      ],
      "title": "The Thundercaller"
    },
    {
      "entry": 25071,
      "name": "Crewman Rusthammer",
      "records": [
        {
          "authored": false,
          "id": "npc:25071:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:631e708f4fa13bb2e80f0b6a",
            "source:02b1274aceebc19436957bf6"
          ],
          "text": "Crewman Rusthammer serves aboard the Thundercaller. His shipboard banter recounts a remarkable crash record: repeated wrecks into mountains, the ocean, lakes, forests and Teldrassil. He also marvels that the ship threaded Thunder Bluff twice and crossed Thousand Needles safely before crashing in the Shimmering Flats.",
          "when": {
            "entry": 25071
          }
        }
      ],
      "title": "The Thundercaller"
    },
    {
