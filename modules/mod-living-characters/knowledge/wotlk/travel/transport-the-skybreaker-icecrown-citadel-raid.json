    {
      "entry": 37184,
      "name": "Zafod Boombox",
      "records": [
        {
          "authored": false,
          "id": "npc:37184:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:158f6579900ea00236712ed5",
            "source:492d278ddc5dceefcc709820",
            "source:de779beb70483464fdee7339",
            "source:51e1ae789aa6ab9d2613b488"
          ],
          "text": "Zafod Boombox is testing a rocket-powered flying device and asks for help. He describes a harness with a rocket pack linked to his Transponster 8000; he says it shuts down if the wearer gets too far away. He warns against stealing his work, jokes about missing liability forms, and announces when the rocket pack activates or is disabled.",
          "when": {
            "entry": 37184
          }
        }
      ],
      "title": ""
    }
