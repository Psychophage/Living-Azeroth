    {
      "entry": 36948,
      "name": "Muradin Bronzebeard",
      "records": [
        {
          "authored": false,
          "id": "npc:36948:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:c9b43053ba88e59a707351fa",
