      "entry": 25078,
      "name": "Captain Krick Wrenchnozzle",
      "records": [
        {
          "authored": false,
          "id": "npc:25078:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:993cb6f520c37561a7072683",
            "source:295d260d97e9d6a239605ed1"
          ],
          "text": "Captain Krick Wrenchnozzle—who introduces himself as Captain Wrenchnozzle—commands the Maiden's Fancy for the Blackwater Raiders. He boasts that his sharp crew and a hold full of gunpowder keep the Bloodsail away, calling the powder insurance, and offers to answer questions.",
          "when": {
            "entry": 25078
          }
        }
      ],
      "title": "The Maiden's Fancy"
    },
    {
