            "source:5fc1b50817a324529d826760",
            "source:1341229235812e42d618d69f"
          ],
          "text": "Cursed Sea Dogs are pirate combatants who taunt landlubbers and boast about claiming the booty.",
          "when": {
            "entry": 24911
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 25026,
      "name": "Mutinous Sea Dog",
      "records": [
        {
          "authored": false,
          "id": "npc:25026:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:61ecc77efdd0112443348dac",
            "source:802189511a12a915d41d92c2"
          ],
          "text": "This mutinous crew member is among the gunners below deck opposing Sorlof. It carries a barrel of blasting powder needed to arm the ship's big gun, linking it directly to the mutiny's fight.",
