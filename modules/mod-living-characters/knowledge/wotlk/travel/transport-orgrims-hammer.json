    {
      "entry": 30824,
      "name": "Sky-Reaver Korm Blackscar",
      "records": [
        {
          "authored": false,
          "id": "npc:30824:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:27d0a299e272e55ae3b50ac3",
            "source:2a6cdf5443d5b3d38e1d7564",
            "source:7d9a6b5aa8d13416a0e2e486",
            "source:6a090ac22fc35fe8bc469a76"
          ],
          "text": "Sky-Reaver Korm Blackscar is a Horde commander aboard Orgrim's Hammer, helping prepare the assault on Arthas. He speaks with urgency when a battle report raises questions, and his dialogue shows fierce hostility toward the Alliance. He is impatient with Chief Engineer Copperclaw and sends someone else to hear the engineer's proposal.",
          "when": {
            "entry": 30824
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 30825,
      "name": "Chief Engineer Copperclaw",
      "records": [
        {
          "authored": false,
          "id": "npc:30825:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:f10410206fd085fd95faa303",
            "source:9cb3617f0e45cb4b222050f3",
            "source:1f14550dfd677d6e5e77288f",
            "source:13c3cbbb96c6b6502045c57c",
            "source:895041ae0bba08e8f25ffdf5"
          ],
          "text": "Chief Engineer Copperclaw is an animated, boastful inventor aboard Orgrim's Hammer. He devised volatile oil to lure frost wyrms into an explosive trap, then experimented with detecting cultist essence and turning the cult's twisted-soul concoctions against them. He calls his ingenuity supernatural and hopes to impress Korm enough to earn a promotion.",
          "when": {
            "entry": 30825
          }
        }
      ],
      "title": ""
    },
    {
