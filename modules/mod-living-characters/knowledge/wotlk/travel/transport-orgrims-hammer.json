      "title": ""
    },
    {
      "entry": 31261,
      "name": "Brother Keltan",
      "records": [
        {
          "authored": false,
          "id": "npc:31261:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:8cc1d40a6377ed4047affa57",
            "source:1a873dd394f0a452d2d44847"
          ],
          "text": "Brother Keltan is a Horde representative aboard Orgrim's Hammer, serving as an ambassador to the Warsong Offensive. He has promised Highlord Fordring that the captured people of his side will be freed from Ymirheim's saronite mines, but has been ordered to remain aboard the gunship. He therefore asks others to carry out the rescue in his stead.",
          "when": {
            "entry": 31261
          }
        }
      ],
      "title": ""
    },
    {
      "entry": 32301,
      "name": "Warbringer Davos Rioht",
      "records": [
        {
          "authored": false,
          "id": "npc:32301:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a9885cc00dddf84f5b69b005",
            "source:914222a38eca0e4cb67c05e9",
            "source:d394aea5e33f03339649e257",
            "source:6b44b0afa9f83590562a6ffa"
          ],
          "text": "Warbringer Davos Rioht is a Horde officer aboard Orgrim's Hammer, preparing the assault on Ymirheim. He calls the Lich King's Ymirjar fierce, dangerous fighters and sends willing warriors to slaughter the so-called Chosen in their own city and to join the main assault. Brisk and blunt, he is a combat-focused commander.",
          "when": {
            "entry": 32301
          }
        }
      ],
      "title": ""
    }
  ],
