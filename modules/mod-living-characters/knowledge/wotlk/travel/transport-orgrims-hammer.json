    {
      "entry": 29795,
      "name": "Koltira Deathweaver",
      "records": [
        {
          "authored": false,
          "id": "npc:29795:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:1348e0d2c149b0ea79f74015",
            "source:cccf85c56cd432644186289e",
            "source:1097d842a94c9ee679c77f05",
            "source:56728bd8b28e607a0229ea8e",
            "source:cac6e1d6fae778d3f64c8264"
          ],
          "text": "Koltira Deathweaver is a Horde death knight aboard Orgrim’s Hammer who directs work against the Lich King’s forces and the Scourge. He oversees efforts to seize the gate and develop abominations, and seeks intelligence on the cult’s void summoners at Aldur’thar, using a summoned Dark Messenger as a spy.",
          "when": {
            "entry": 29795
          }
        }
      ],
      "title": ""
    },
