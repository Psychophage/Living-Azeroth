  "npcs": [
    {
      "entry": 25009,
      "name": "Captain Angelina Soluna",
      "records": [
        {
          "authored": false,
          "id": "npc:25009:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:a71934d92178dbc66bc9ddcd",
            "source:c94cc5897d32023bb6a18476",
            "source:6f975e69a3ca67272b007ade"
          ],
          "text": "Captain Angelina Soluna is associated with The Bravery and welcomes visitors aboard in a brisk exchange, then excusing herself. The greeting gives her a courteous but businesslike presence.",
          "when": {
            "entry": 25009
          }
        }
      ],
      "title": "The Bravery"
    },
    {
      "entry": 25010,
      "name": "Engineer Brightbuckle",
      "records": [
        {
          "authored": false,
          "id": "npc:25010:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:e7b4f2d9790674f07c77d715",
            "source:5f86f4a1967ee81159dcb908",
            "source:7a0399f645beaf4620a76eab",
            "source:963df45cb53d840d61f48551"
          ],
          "text": "Engineer Brightbuckle handles engineering needs aboard The Bravery. He supplies goods and repairs equipment, making him a practical point of contact for shipboard gear and upkeep.",
          "when": {
            "entry": 25010
          }
        }
      ],
      "title": "The Bravery"
    },
    {
      "entry": 25011,
      "name": "First Mate Wavesinger",
      "records": [
        {
          "authored": false,
          "id": "npc:25011:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:26c50b1eb933ca9a7d17df98",
            "source:e3d44584ecbf5b0dfeee78fe",
            "source:d1446d916d6ee96fc7591843"
          ],
          "text": "First Mate Wavesinger speaks for The Bravery's crew, saying they will do their best to make passengers' journey swift and pleasant. The message presents the crew as attentive to travelers' comfort and the quality of the voyage.",
          "when": {
            "entry": 25011
          }
        }
      ],
      "title": "The Bravery"
    },
    {
      "entry": 25012,
      "name": "Galley Chief Gathers",
      "records": [
        {
          "authored": false,
          "id": "npc:25012:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:0fb5cc5274e515e9972c50b1",
            "source:81eaae7e2d3d5d39552a9faf",
            "source:7a0399f645beaf4620a76eab"
          ],
          "text": "Galley Chief Gathers is the galley chief aboard The Bravery and offers goods to travelers. His role connects the ship's galley with practical provisioning during the voyage.",
          "when": {
            "entry": 25012
          }
        }
      ],
      "title": "The Bravery"
    },
    {
      "entry": 25013,
      "name": "Sentinel Brightgrass",
      "records": [
        {
          "authored": false,
          "id": "npc:25013:identity",
          "layer": "npc",
          "priority": 80,
          "sources": [
            "source:bcfc7604f7b6a5576783f6cc",
            "source:33e9c1601e4025357c168446",
            "source:bb6856671a6dfe9cac9db8bf"
          ],
          "text": "Sentinel Brightgrass is associated with The Bravery's passenger protection. The ship's sentinel message commits to keeping the sea lane between Auberdine and Stormwind Harbor safe, giving Brightgrass a clear concern for travelers and their route.",
          "when": {
            "entry": 25013
          }
        }
      ],
      "title": ""
    },
